// ============================================================
// IDF Official Rules of Draughts-64 — rules_core (FINAL v2, judge-feedback applied)
// Sections 2 (The material), 3 (Movement), 4 (Capture)
// Source URL: https://idf64.org/rules-of-the-game/
// Diagram rows are formal source data for board geometry and initial setup;
// legend rows explain diagram symbols and are represented through coordinate facts.
//
// v1 → v2 (judge panel feedback, 3/5 partial → applying fixes):
//   - [deepseek-v4-pro] `jump_own_piece`: was unconditional, now ONLY bans
//     jumping over OWN pieces (was banning ALL pieces — bug)
//   - [deepseek-v4-pro] `touch_opponent_pieces` renamed to
//     `touch_when_not_on_turn`, broadened to ALL pieces (source 3.13:
//     "touches or adjusts one or more of his men or of his opponent")
//   - [gpt-5.4-mini] `move_hand_used` fact strengthened to match
//     obligation: OneHand only (removed tension with `one_hand_per_move`)
//   - [gpt-5.4] Added 2.1.1 board-partition fact: 64 squares = 32 dark
//     (modeled) + 32 light (excluded by sort definition)
//   - [gpt-5.4] Added 2.1.4 first-left-dark consequence as explicit fact
//
// v0 → v1 (manual cleanup based on critic_swarm + source coverage):
//   - Added missing source clauses (3.3, 3.8, 4.1, 4.9, 4.11, 4.12)
//   - Fixed 4.16.1 Brazilian: permission → obligation (source: "REQUIRED")
//   - Dropped invented `sort MoveExecution` (critic-flagged over-engineering)
//   - Dropped 30 vacuous `forall x. P(x) or not P(x)` tautology facts
//   - Grounded BoardRow enum + is_starting_row/is_empty_row/last_row_of facts
//
// All deontic decls reference source clause IDs in comments.
//
// ============================================================

// --- SORTS ---

sort BoardSquare
sort BoardRow = Row1 | Row2 | Row3 | Row4 | Row5 | Row6 | Row7 | Row8
sort BoardColumn = ColumnA | ColumnB | ColumnC | ColumnD | ColumnE | ColumnF | ColumnG | ColumnH
sort Diagonal
sort Board

// --- BOARD COORDINATE ENTITIES FROM DIAGRAMS 1-2 ---
entity SquareA1 : BoardSquare
entity SquareC1 : BoardSquare
entity SquareE1 : BoardSquare
entity SquareG1 : BoardSquare
entity SquareB2 : BoardSquare
entity SquareD2 : BoardSquare
entity SquareF2 : BoardSquare
entity SquareH2 : BoardSquare
entity SquareA3 : BoardSquare
entity SquareC3 : BoardSquare
entity SquareE3 : BoardSquare
entity SquareG3 : BoardSquare
entity SquareB4 : BoardSquare
entity SquareD4 : BoardSquare
entity SquareF4 : BoardSquare
entity SquareH4 : BoardSquare
entity SquareA5 : BoardSquare
entity SquareC5 : BoardSquare
entity SquareE5 : BoardSquare
entity SquareG5 : BoardSquare
entity SquareB6 : BoardSquare
entity SquareD6 : BoardSquare
entity SquareF6 : BoardSquare
entity SquareH6 : BoardSquare
entity SquareA7 : BoardSquare
entity SquareC7 : BoardSquare
entity SquareE7 : BoardSquare
entity SquareG7 : BoardSquare
entity SquareB8 : BoardSquare
entity SquareD8 : BoardSquare
entity SquareF8 : BoardSquare
entity SquareH8 : BoardSquare

entity DiagonalA1H8 : Diagonal
entity DiagonalA3F8 : Diagonal
entity DiagonalA5D8 : Diagonal
entity DiagonalA7B8 : Diagonal
entity DiagonalC1A3 : Diagonal
entity DiagonalC1H6 : Diagonal
entity DiagonalE1A5 : Diagonal
entity DiagonalE1H4 : Diagonal
entity DiagonalG1A7 : Diagonal
entity DiagonalG1H2 : Diagonal
entity DiagonalH2B8 : Diagonal
entity DiagonalH4D8 : Diagonal
entity DiagonalH6F8 : Diagonal


sort Piece
sort Man < Piece
sort King < Piece
sort PieceColor = White | Black

// Initial position entities from Diagram 2.
entity InitialWhiteManA1 : Man
entity InitialWhiteManC1 : Man
entity InitialWhiteManE1 : Man
entity InitialWhiteManG1 : Man
entity InitialWhiteManB2 : Man
entity InitialWhiteManD2 : Man
entity InitialWhiteManF2 : Man
entity InitialWhiteManH2 : Man
entity InitialWhiteManA3 : Man
entity InitialWhiteManC3 : Man
entity InitialWhiteManE3 : Man
entity InitialWhiteManG3 : Man
entity InitialBlackManB6 : Man
entity InitialBlackManD6 : Man
entity InitialBlackManF6 : Man
entity InitialBlackManH6 : Man
entity InitialBlackManA7 : Man
entity InitialBlackManC7 : Man
entity InitialBlackManE7 : Man
entity InitialBlackManG7 : Man
entity InitialBlackManB8 : Man
entity InitialBlackManD8 : Man
entity InitialBlackManF8 : Man
entity InitialBlackManH8 : Man

sort Move
sort Capture < Move
sort MultipleCapture < Capture

sort MoveDirection = Forward | Backward

sort Player
sort Hand = OneHand | TwoHands
sort CaptureChoiceCriterion = NumberOfPieces | QualityOfPieces

// --- RELATIONS ---

rel square_row : BoardSquare, BoardRow
rel square_column : BoardSquare, BoardColumn
rel square_is_dark : BoardSquare
rel square_diagonal : BoardSquare, Diagonal
rel same_diagonal : BoardSquare, BoardSquare
rel light_square_coordinate : BoardColumn, BoardRow

rel piece_color : Piece, PieceColor
rel piece_square : Piece, BoardSquare
rel piece_owner : Piece, Player

rel move_piece : Move, Piece
rel move_player : Move, Player
rel move_direction : Move, MoveDirection
rel move_hand : Move, Hand
rel move_is_complete : Move

rel initial_man : Man
rel initial_piece_square : Man, BoardSquare
rel initial_empty_square : BoardSquare
rel capture_victim : Capture, Piece
rel capture_chain : MultipleCapture, Capture
rel capture_hand : Capture, Hand
rel capture_player : Capture, Player
rel clear_indication : Capture
rel absence_of_clear_indication : Capture
rel incorrect_capture : Capture
rel rectification_request_available : Player, Capture
rel capture_move_hand : Capture, Hand
rel captured_piece_lift_hand : Capture, Hand
rel using_two_hands : Capture

rel game_turn : Player
rel touches : Player, Piece
rel is_playable : Piece, Player
rel is_legal_move : Move
rel is_legal_capture : Capture
rel is_empty : BoardSquare
rel reaches_last_row : Piece
rel stops_on_square : Piece, BoardSquare
rel stops_on_last_row : Piece
rel crowned : Piece
rel promoted_from : King, Man
rel crowning_piece : Man, Man
rel promotion_move : Move, Man
rel irregular_move : Move
rel can_move_direction : Piece, MoveDirection
rel meets_diagonally : Piece, Piece
rel adjacent_diagonal_squares : BoardSquare, BoardSquare
rel has_further_capture : Piece
rel is_capturing : Piece
rel announce : Player, String
rel competition_regulations_permit : String
rel is_captured_in_current_move : Piece
fun[required] count_initial_men_of_color : PieceColor -> Integer
rel diagonal_length : Diagonal, Integer
rel board_placed_between : Board, Player, Player
rel long_diagonal_starts_at_left : Board, Player
rel board_has_bases : Board
rel board_has_sides : Board
rel board_has_rows : Board
rel board_has_columns : Board
fun[required] forward_next_row : BoardRow, PieceColor -> BoardRow
rel is_legal_square_for : Piece, BoardSquare
fun[required] opponent_of : Player -> Player
rel first_player : Player
fun[required] capture_move : Piece -> Capture
fun[required] behind : Piece -> BoardSquare
rel exists_empty_behind : Piece
rel reaches_last_row_during_capture : Piece
rel has_opportunity_to_continue : Piece
rel can_capture_as_king : Piece
rel remains_man_during_capture : Man
rel capture_only_on_next_move : Piece
rel released : Player, Piece
fun[required] count_captured_pieces : Capture -> Integer
fun[required] capture_of : Piece -> Capture
rel is_starting_row : BoardRow, PieceColor
rel is_empty_row : BoardRow
rel horizontal_row : BoardRow
rel was_jumped_in_current_chain : Piece, MultipleCapture

// 3.3 — Move ordering for turn alternation
rel move_after : Move, Move
// 3.8 — King distance movement
rel all_squares_between_empty : BoardSquare, BoardSquare, Diagonal
rel perpendicular_diagonal : Diagonal, Diagonal
// 4.11 — Capture step ordering and lifting state
rel capture_step_order : Capture, Capture
rel lifted_after : Piece, Capture
rel piece_on_board : Piece
// 4.12 — Lift-completion marker
rel lift_complete : MultipleCapture
rel all_captured_pieces_taken : MultipleCapture
rel clearly_stopped_taking : Player, MultipleCapture
rel taking_pieces_finished : MultipleCapture
// Last-row predicate for promotion (replaces use of Row8/Row1 as constants).
rel last_row_of : BoardRow, PieceColor
rel capture_choice_ignores_criterion : Player, CaptureChoiceCriterion

// --- GROUNDING FACTS (newly added: enumerate constants used by rules) ---

// 2.2.2: White's starting rows are 1, 2, 3.
fact starting_rows_white :
  is_starting_row(Row1, White) and
  is_starting_row(Row2, White) and
  is_starting_row(Row3, White)

// 2.2.2: Black's starting rows are 6, 7, 8.
fact starting_rows_black :
  is_starting_row(Row6, Black) and
  is_starting_row(Row7, Black) and
  is_starting_row(Row8, Black)

// 2.2.2: Rows 4 and 5 are initially empty.
fact empty_starting_rows :
  is_empty_row(Row4) and is_empty_row(Row5)

fact all_board_rows_are_horizontal :
  horizontal_row(Row1) and horizontal_row(Row2) and horizontal_row(Row3) and
  horizontal_row(Row4) and horizontal_row(Row5) and horizontal_row(Row6) and
  horizontal_row(Row7) and horizontal_row(Row8)

// 3.5, 4.14: Last row for promotion. From white's perspective: row 8.
// From black's perspective: row 1.
fact last_row_white :
  last_row_of(Row8, White)
fact last_row_black :
  last_row_of(Row1, Black)

