// Entry note: source text is Cyrillic; identifiers use ASCII transliteration.

sort Delo

sort SubjektPrava
sort Chelovek extends SubjektPrava
sort GruppaChelovek extends SubjektPrava
sort Lyudi extends GruppaChelovek
sort Verv extends GruppaChelovek
sort Desyatina extends SubjektPrava

sort Muzh extends Chelovek
sort Rusin extends Chelovek
sort Gridin extends Chelovek
sort Kupets extends Chelovek
sort Yabednik extends Chelovek
sort Mechnik extends Chelovek
sort Izgoy extends Chelovek
sort Slovenin extends Chelovek
sort Varyag extends Chelovek
sort Kolbyag extends Chelovek
sort Chelyadin extends Chelovek
sort Gospodin extends Chelovek
sort Holop extends Chelovek
sort SvobodnyyMuzh extends Chelovek
sort Ognishchanin extends Chelovek
sort Tiun extends Chelovek
sort KnyazheskiyTiun extends Tiun
sort Smerd extends Chelovek
sort Rab extends Chelovek
sort Rabynya extends Chelovek
sort Kormilitsa extends Chelovek
sort Lekar extends Chelovek
sort Virnik extends Chelovek
sort Mostnik extends Chelovek
sort Knyaz extends Chelovek
sort Podezdnoy extends Chelovek
sort StarshiyKonyukh extends Chelovek
sort SelskiyStarosta extends Chelovek
sort Smotritel extends Chelovek
sort Ryadovich extends Chelovek

sort Vesh

sort Zhivotnoe extends Vesh
sort Skotina extends Zhivotnoe
sort Ptitsa extends Zhivotnoe
sort ChastZhivotnogo extends Vesh
sort Pishcha extends Vesh
sort Korm extends Vesh

sort Kon extends Skotina
sort Kobyla extends Skotina
sort Vol extends Skotina
sort Korova extends Skotina
sort Trehletka extends Skotina
sort GodovalayaSkotina extends Skotina
sort Telenok extends Skotina
sort Yagnenok extends Skotina
sort Baran extends Skotina
sort Ovtsa extends Skotina
sort Koza extends Skotina
sort Svinya extends Skotina

sort Pes extends Zhivotnoe
sort Pchely extends Zhivotnoe
sort Ryba extends Zhivotnoe

sort Golub extends Ptitsa
sort Kuritsa extends Ptitsa
sort Utka extends Ptitsa
sort Gus extends Ptitsa
sort Zhuravl extends Ptitsa
sort Lebed extends Ptitsa
sort Yastreb extends Ptitsa
sort Sokol extends Ptitsa

sort Myaso extends Pishcha
sort PoltushaMyasa extends ChastZhivotnogo
sort Hleb extends Pishcha
sort Psheno extends Pishcha
sort Syr extends Pishcha
sort Solod extends Pishcha
sort Seno extends Korm
sort Drova extends Vesh

sort Oruzhie extends Vesh
sort Odezhda extends Vesh
sort Kopie extends Oruzhie
sort Shchit extends Vesh
sort Ladya extends Vesh
sort Bort extends Vesh
sort PolevayaMezha extends Vesh
sort MezhevoyStolb extends Vesh

sort Plata
sort Kolichestvo
sort Dney
sort Svideteley
sort Vorov
sort Dosok
sort Ustoy

sort DenezhnayaEdinitsa =
grivna
| rezan
| kuna
| nogata
| veveritsa

sort Rodstvo =
brat
| sestra
| syn

sort StoronaRodstva =
so_storony_brata
| so_storony_sestry

sort ChastCheloveka =
ruka
| noga
| palets
| usy
| boroda

sort Orudie =
palka
| zherd
| ruka_kak_orudie
| chasha
| rog
| mech
| mech_v_nozhnah
| rukoyat_mecha

sort Mesto =
dvor
| klet
| hlev
| horomy
| knyazheskiy_dvor
| mesto_kon
| stado

rel chelovek_v_lyudyah : Chelovek, Lyudi
rel chelovek_v_vervi : Chelovek, Verv
rel chast_zhivotnogo : ChastZhivotnogo, Zhivotnoe
rel chast_myasa : PoltushaMyasa, Myaso

rel rodstvennik : Chelovek, Chelovek, Rodstvo
rel plemyannik_so_storony : Chelovek, Chelovek, StoronaRodstva

rel knyazheskiy_chelovek : Delo, Chelovek
rel knyazheskaya_vesh : Delo, Vesh
rel bez_knyazheskogo_poveleniya : Delo

rel vinovnyy : Delo, Chelovek
rel otvetstvennyy : Delo, SubjektPrava
rel poterpevshiy : Delo, Chelovek
rel vor : Delo, Chelovek
rel dolzhnik : Delo, Chelovek
rel khozyain : Delo, Chelovek, Vesh
rel sobstvennik : Delo, Chelovek, Vesh
rel knyaz_dela : Delo, Knyaz
rel mechnik_dela : Delo, Mechnik
rel virnik_dela : Delo, Virnik
rel mostnik_dela : Delo, Mostnik
rel lekar_dela : Delo, Lekar
rel desyatina_dela : Delo, Desyatina
rel lyudi_dela : Delo, Lyudi

rel ubil : Delo, Chelovek, Chelovek
rel ubit : Delo, Chelovek
rel umyshlenno : Delo
rel bez_korystnyh_namereniy : Delo
rel po_razboynicheski : Delo
rel s_tselyu_grabezha : Delo
