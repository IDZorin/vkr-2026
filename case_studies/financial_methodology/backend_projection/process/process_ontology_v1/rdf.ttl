ex:ASSERT_initial_process_state_membership_mapping a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "146"^^xsd:integer ;
  a4:exprText "(process_state_kind_corresponds_to_membership_state(SelectedComponent, SelectedMembership)) and (process_state_kind_corresponds_to_membership_state(CalculationDayComponent, CalculationMembership)) and (process_state_kind_corresponds_to_membership_state(ImplementedComponent, ImplementedMembership))" ;
  a4:sourceText "fact initial_process_state_membership_mapping :\n  process_state_kind_corresponds_to_membership_state(SelectedComponent, SelectedMembership)\n  and process_state_kind_corresponds_to_membership_state(CalculationDayComponent, CalculationMembership)\n  and process_state_kind_corresponds_to_membership_state(ImplementedComponent, ImplementedMembership)" .
