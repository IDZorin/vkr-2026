  rdfs:range ex:ProcessOverlayStateKind .
ex:process_state_carrier a owl:ObjectProperty ;
  rdfs:domain ex:ProcessState ;
  rdfs:range ex:ProcessStateCarrier .
ex:process_state_corresponds_to_membership_state a owl:ObjectProperty ;
