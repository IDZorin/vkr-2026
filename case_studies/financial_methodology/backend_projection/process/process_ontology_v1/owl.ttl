  rdfs:range ex:DocumentPart .
ex:step_grounded_in a owl:ObjectProperty ;
  rdfs:domain ex:ProcessStep ;
  rdfs:range ex:ProcessGroundingTarget .
ex:edge_grounded_in a owl:Class, a4:NaryRelationClass .
ex:edge_grounded_in_arg_0 a owl:ObjectProperty ;
  rdfs:domain ex:edge_grounded_in ;
  rdfs:range ex:ProcessStep .
ex:edge_grounded_in_arg_1 a owl:ObjectProperty ;
