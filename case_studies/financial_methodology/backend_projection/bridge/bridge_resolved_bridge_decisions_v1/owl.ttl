ex:bridge_resolved_bridge_decisions_v1 a owl:Ontology .

ex:BridgeSymbol a owl:Class .
ex:BridgeRelation a owl:Class .
ex:BridgeRelation rdfs:subClassOf ex:BridgeSymbol .
ex:BridgeFamily a owl:Class .
ex:BridgeResolutionPolicy a owl:Class ; owl:oneOf ( ex:EquivalentClassResolution ex:SameAsResolution ex:EquivalentPropertyResolution ex:InverseAdapterResolution ex:ScopedProjectionAdapterResolution ex:PairwiseSignatureEquivalenceResolution ex:ProjectionFamilyResolution ex:FamilySplitResolution ex:DomainSpecializedRelationResolution ex:NonIdentityRelatedConceptResolution ) .
