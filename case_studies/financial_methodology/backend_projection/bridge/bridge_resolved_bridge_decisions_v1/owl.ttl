ex:bridge_pair_resolved_as a owl:Class, a4:NaryRelationClass .
ex:bridge_pair_resolved_as_arg_0 a owl:ObjectProperty ;
  rdfs:domain ex:bridge_pair_resolved_as ;
  rdfs:range ex:BridgeSymbol .
ex:bridge_pair_resolved_as_arg_1 a owl:ObjectProperty ;
  rdfs:domain ex:bridge_pair_resolved_as ;
  rdfs:range ex:BridgeSymbol .
ex:bridge_pair_resolved_as_arg_2 a owl:ObjectProperty ;
  rdfs:domain ex:bridge_pair_resolved_as ;
  rdfs:range ex:BridgeResolutionPolicy .
ex:bridge_pair_adapter_kind a owl:Class, a4:NaryRelationClass .
ex:bridge_pair_adapter_kind_arg_0 a owl:ObjectProperty ;
  rdfs:domain ex:bridge_pair_adapter_kind ;
  rdfs:range ex:BridgeSymbol .
ex:bridge_pair_adapter_kind_arg_1 a owl:ObjectProperty ;
  rdfs:domain ex:bridge_pair_adapter_kind ;
  rdfs:range ex:BridgeSymbol .
ex:bridge_pair_adapter_kind_arg_2 a owl:ObjectProperty ;
  rdfs:domain ex:bridge_pair_adapter_kind ;
  rdfs:range ex:BridgeAdapterKind .
ex:bridge_family_resolved_as a owl:ObjectProperty ;
  rdfs:domain ex:BridgeFamily ;
  rdfs:range ex:BridgeResolutionPolicy .
ex:bridge_family_adapter_kind a owl:ObjectProperty ;
  rdfs:domain ex:BridgeFamily ;
  rdfs:range ex:BridgeAdapterKind .

