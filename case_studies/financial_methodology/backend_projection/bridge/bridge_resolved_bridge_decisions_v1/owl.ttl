ex:NonIdentityRelatedConceptResolution a ex:BridgeResolutionPolicy, owl:NamedIndividual .
ex:BridgeAdapterKind a owl:Class ; owl:oneOf ( ex:NoAdapter ex:InversePropertyAdapter ex:ScopedProjectionAdapter ex:SignatureEquivalenceAdapter ex:ProjectionFrameAdapter ex:FamilySplitAdapter ex:DomainSpecializationAdapter ex:RelatedConceptAdapter ) .
ex:NoAdapter a ex:BridgeAdapterKind, owl:NamedIndividual .
ex:InversePropertyAdapter a ex:BridgeAdapterKind, owl:NamedIndividual .
