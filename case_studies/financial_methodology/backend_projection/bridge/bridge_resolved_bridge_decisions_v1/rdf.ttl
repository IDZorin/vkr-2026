  a4:sourceText "fact direct_adapter_resolution_decisions :\n  bridge_pair_resolved_as(N07_respective_exchange, N10_respective_exchange_for_index_component, ScopedProjectionAdapterResolution)\n  and bridge_pair_adapter_kind(N07_respective_exchange, N10_respective_exchange_for_index_component, ScopedProjectionAdapter)\n  and bridge_pair_resolved_as(N27_selection_day_for_rebalance_day, Section3_1_selection_day_of_rebalance, InverseAdapterResolution)\n  and bridge_pair_adapter_kind(N27_selection_day_for_rebalance_day, Section3_1_selection_day_of_rebalance, InversePropertyAdapter)\n  and bridge_pair_resolved_as(Section2_1_rbics_subindustry_classification_in_appendix, Appendix8_1_appendix_includes_rbics_subindustry, InverseAdapterResolution)\n  and bridge_pair_adapter_kind(Section2_1_rbics_subindustry_classification_in_appendix, Appendix8_1_appendix_includes_rbics_subindustry, InversePropertyAdapter)\n  and bridge_pair_resolved_as(Section2_1_rbics_subindustry_classification_of_system, Appendix8_1_rbics_classifies_subindustry, InverseAdapterResolution)\n  and bridge_pair_adapter_kind(Section2_1_rbics_subindustry_classification_of_system, Appendix8_1_rbics_classifies_subindustry, InversePropertyAdapter)" .
