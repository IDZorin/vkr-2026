  a4:assertionKind "constraint" ;
  a4:exprText "forall i: Index, (<count>) <= (1)" .
g002:SolactiveTransatlanticCleanEnergyEURIndexPR g002:published_on g002:SolactiveWebsite .
g002:SolactiveTransatlanticCleanEnergyEURIndexPR g002:available_via g002:BoerseStuttgartGmbHPriceMarketingServices .
