g049:TwentyBusinessDays owl:sameAs "20"^^xsd:integer .
g049:ASSERT_selection_day_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall sd: SelectionDay, forall rd: RebalanceDay, (selection_day_for_rebalance_day(sd, rd)) iff ((business_day_count_before(sd, rd)) = (TwentyBusinessDays))" .
g049:ASSERT_rebalance_day_change_disregarded_for_selection_day a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall sd: SelectionDay, forall rd: RebalanceDay, (selection_day_for_rebalance_day(sd, rd)) implies (change_of_rebalance_day_disregarded_for_selection_day(sd, rd))" .


