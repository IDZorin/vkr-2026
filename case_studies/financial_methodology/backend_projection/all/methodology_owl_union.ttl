g048:N26 a owl:Ontology .

g048:RebalanceDay a owl:Class .
g048:RebalanceDay rdfs:subClassOf g048:Day .
g048:ScheduledRebalanceDay a owl:Class .
g048:ScheduledRebalanceDay rdfs:subClassOf g048:Day .
g048:WeekdayOrdinal a owl:Class .
g048:WeekdayOrdinal rdfs:subClassOf g048:Nat .
g048:Month a owl:Class ; owl:oneOf ( g048:May g048:November ) .
g048:May a g048:Month, owl:NamedIndividual .
g048:November a g048:Month, owl:NamedIndividual .

g048:FirstWeekdayOrdinal a g048:WeekdayOrdinal, owl:NamedIndividual .
g048:nth_wednesday_in_month a owl:Class, a4:NaryRelationClass .
g048:nth_wednesday_in_month_arg_0 a owl:ObjectProperty ;
  rdfs:domain g048:nth_wednesday_in_month ;
  rdfs:range g048:Day .
g048:nth_wednesday_in_month_arg_1 a owl:ObjectProperty ;
  rdfs:domain g048:nth_wednesday_in_month ;
  rdfs:range g048:Month .
g048:nth_wednesday_in_month_arg_2 a owl:ObjectProperty ;
  rdfs:domain g048:nth_wednesday_in_month ;
  rdfs:range g048:WeekdayOrdinal .
g048:scheduled_rebalance_day a owl:Class ; rdfs:subClassOf g048:Day .
g048:eligible_rebalance_day a owl:Class ; rdfs:subClassOf g048:Day .
g048:rebalance_day a owl:Class ; rdfs:subClassOf g048:Day .
g048:immediately_following_eligible_rebalance_day_after a owl:ObjectProperty ;
  rdfs:domain g048:Day ;
  rdfs:range g048:Day .
g048:strictly_before a owl:ObjectProperty ;
  rdfs:domain g048:Day ;
  rdfs:range g048:Day .

g048:FirstWeekdayOrdinal owl:sameAs "1"^^xsd:integer .
g048:ASSERT_scheduled_rebalance_day_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: Day, (scheduled_rebalance_day(d)) iff ((nth_wednesday_in_month(d, May, FirstWeekdayOrdinal)) or (nth_wednesday_in_month(d, November, FirstWeekdayOrdinal)))" .
g048:ASSERT_rebalance_day_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: Day, (rebalance_day(d)) iff (((scheduled_rebalance_day(d)) and (eligible_rebalance_day(d))) or (exists s: Day, (scheduled_rebalance_day(s)) and (not (eligible_rebalance_day(s))) and (eligible_rebalance_day(d)) and (immediately_following_eligible_rebalance_day_after(d, s))))" .
g048:ASSERT_immediately_following_eligible_rebalance_day_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: Day, forall s: Day, (immediately_following_eligible_rebalance_day_after(d, s)) implies ((strictly_before(s, d)) and (eligible_rebalance_day(d)) and (forall e: Day, ((strictly_before(s, e)) and (strictly_before(e, d))) implies (not (eligible_rebalance_day(e)))))" .


