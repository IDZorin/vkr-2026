g016:ASSERT_efforts_to_accurately_calculate_and_maintain_indices a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall i: Index, (index_of(i, Solactive)) implies ((effort_goal(SolactiveGreatestPossibleEfforts, i, AccurateCalculation)) and (effort_goal(SolactiveGreatestPossibleEfforts, i, AccurateMaintenance)))" .
g016:DeterminationProcessErrorPossibility g016:error_possibility_in_determination_process g016:SolactiveDeterminationProcess .
g016:DeterminationProcessErrorDescription g016:description_of_error_possibility g016:DeterminationProcessErrorPossibility .
g016:DeterminationProcessErrorDescription g016:description_occurrence_term g016:FromTimeToTime .
g016:DeterminationProcessErrorDescription g016:description_reason_term g016:VarietyReasons .
g016:DeterminationProcessErrorDescription g016:description_polarity_term g016:CannotBeCompletelyRuledOut .
g016:DeterminationProcessErrorPossibility g016:error_possibility_reason g016:Internal .
g016:DeterminationProcessErrorPossibility g016:error_possibility_reason g016:External .
g016:ASSERT_determination_process_errors_may_occur_not_ruled_out a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(error_possibility_in_determination_process(DeterminationProcessErrorPossibility, SolactiveDeterminationProcess)) and (description_of_error_possibility(DeterminationProcessErrorDescription, DeterminationProcessErrorPossibility)) and (description_occurrence_term(DeterminationProcessErrorDescription, FromTimeToTime)) and (description_reason_term(DeterminationProcessErrorDescription, VarietyReasons)) and (description_polarity_term(DeterminationProcessErrorDescription, CannotBeCompletelyRuledOut)) and (error_possibility_reason(DeterminationProcessErrorPossibility, Internal)) and (error_possibility_reason(DeterminationProcessErrorPossibility, External)) and (not (completely_ruled_out(DeterminationProcessErrorPossibility)))" .
g016:ASSERT_identified_errors_correction_endeavor a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall e: Error, ((error_in_determination_process(e, SolactiveDeterminationProcess)) and (identified(e))) implies (exists v: Endeavor, exists t: Period, (endeavor_by(v, Solactive)) and (endeavor_to_correct(v, e)) and (reasonable_period_for_error(e, t)) and (period_described_by(t, ReasonablePeriodOfTime)) and (endeavor_within(v, t)))" .
g016:ASSERT_period_understanding_and_measures_depend_on_underlying a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "exists u: Underlying, (dependency_understanding(PeriodAndMeasureUnderlyingDependency, ReasonablePeriodOfTimeUnderstanding)) and (dependency_general_measure(PeriodAndMeasureUnderlyingDependency, GeneralMeasuresToBeTaken)) and (dependency_underlying(PeriodAndMeasureUnderlyingDependency, u)) and (generally_applies(PeriodAndMeasureUnderlyingDependency))" .
g016:ReasonablePeriodOfTimeUnderstanding g016:understanding_of g016:ReasonablePeriodOfTime .
g016:GeneralMeasuresToBeTaken a g016:general_measure_to_be_taken .
g016:CorrectionPolicySpecification g016:specification_understanding g016:ReasonablePeriodOfTimeUnderstanding .
g016:CorrectionPolicySpecification g016:specification_general_measure g016:GeneralMeasuresToBeTaken .
g016:CorrectionPolicySpecification g016:specification_policy g016:SolactiveCorrectionPolicy .
g016:SolactiveCorrectionPolicy g016:incorporated_by_reference_into g016:ThisGuideline .
g016:SolactiveCorrectionPolicy g016:available_on g016:SolactiveWebsite .
g016:SolactiveWebsite g016:website_of g016:Solactive .


