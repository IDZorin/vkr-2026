g002:ASSERT_solactive_website a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(has_url(SolactiveWebsite, HttpsWwwSolactiveCom)) and (website_of(SolactiveWebsite, Solactive))" .
g002:EquityIndexMethodology g002:available_on g002:SolactiveWebsite .
g002:ASSERT_equity_index_methodology_location a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(document_url(EquityIndexMethodology, HttpsWwwSolactiveComDocumentsEquityIndexMethodology)) and (available_on(EquityIndexMethodology, SolactiveWebsite))" .
g002:ASSERT_section_4_location a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(part_of_document(Section4, Guideline)) and (document_part_locator(Section4, Section4Locator))" .
