g020:DescribedMethod g020:method_for_purpose g020:Composition .
g020:DescribedMethod g020:method_for_purpose g020:Calculation .
g020:DescribedMethodApplication g020:application_by g020:TheIndexAdministrator .
g020:DescribedMethodApplication g020:application_of_method g020:DescribedMethod .
g020:DescribedMethodApplication a g020:final .
g020:DescribedMethodApplication a g020:binding .
g020:IndexTermsAndConditions g020:terms_and_conditions_of g020:TheIndex .
g020:MarketEnvironment g020:potentially_requires_change_to_method g020:DescribedMethod .
g020:SupervisoryReason g020:potentially_requires_change_to_method g020:DescribedMethod .
g020:LegalReason g020:potentially_requires_change_to_method g020:DescribedMethod .
g020:FinancialReason g020:potentially_requires_change_to_method g020:DescribedMethod .
g020:TaxReason g020:potentially_requires_change_to_method g020:DescribedMethod .
g020:ASSERT_deemed_modification_or_change_scope a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ch: DeemedModificationOrChange, (modification_or_change_of_index(ch, TheIndex)) and ((change_to_terms_and_conditions(ch, IndexTermsAndConditions)) or (change_to_calculation_method(ch, calculation_method_applied(TheIndex)))) and (deemed_by(ch, TheIndexAdministrator, Necessary)) and (deemed_by(ch, TheIndexAdministrator, Desirable)) and ((exists e: Error, ((error_described_by(e, Obvious)) or (error_described_by(e, Demonstrable))) and (prevents_error(ch, e))) or ((incorrect_terms_and_conditions(IndexTermsAndConditions)) and ((remedies_terms_and_conditions(ch, IndexTermsAndConditions)) or (corrects_terms_and_conditions(ch, IndexTermsAndConditions)) or (supplements_terms_and_conditions(ch, IndexTermsAndConditions)))))" .
g020:AppropriateSteps a g020:appropriate .
g020:ASSERT_appropriate_steps_consistency_target a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(appropriate(AppropriateSteps)) and (step_ensures_consistency_with(AppropriateSteps, calculation_method_applied(TheIndex), DescribedMethod))" .
g020:ASSERT_information_withheld_means_information_not_provided a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall a: IndexAdministrator, forall ch: ModificationOrChange, (information_withheld_on_modification_or_change(a, ch, ModificationOrChangeInformation)) iff (not (provide_information_on_modification_or_change(a, ch, ModificationOrChangeInformation)))" .


