g026:ASSERT_business_day_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: Day, (business_day(d)) iff (((WeekdayOf(d)) = (Monday)) or ((WeekdayOf(d)) = (Tuesday)) or ((WeekdayOf(d)) = (Wednesday)) or ((WeekdayOf(d)) = (Thursday)) or ((WeekdayOf(d)) = (Friday)))" .


