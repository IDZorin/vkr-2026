g015:ASSERT_considered_corporate_actions_result_in_index_adjustment a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ca: IndexMaintenanceCorporateAction, (considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)) implies ((adjustment_to_index(index_adjustment(ca), TheIndex)) and (exists r1: RegularRebalanceDay, exists r2: RegularRebalanceDay, (adjustment_between_regular_rebalance_days(index_adjustment(ca), r1, r2)) and (not ((r1) = (r2)))))" .
g015:ASSERT_considered_corporate_actions_have_material_impact a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ca: IndexMaintenanceCorporateAction, (considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)) implies (exists c: IndexComponent, exists attr: IndexComponentAttribute, (component_of_index(c, TheIndex)) and (material_impact_on(ca, c, attr)))" .
g015:ASSERT_corporate_action_implementation_period_and_price_effect a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ca: IndexMaintenanceCorporateAction, (considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)) implies ((implemented_from_to(ca, cum_day(ca), ex_day(ca))) and (adjustment_coincides_with_price_effect_occurrence(index_adjustment(ca), price_effect(ca))))" .
g015:ASSERT_equity_index_methodology_material_for_covered_corporate_actions a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall k: CorporateActionKind, (methodology_covers_corporate_action_kind(EquityIndexMethodology, k)) implies (exists d: BriefCorporateActionDefinition, exists v: IndexVariable, (methodology_contains_definition(EquityIndexMethodology, k, d)) and (methodology_specifies_relevant_adjustment_to_index_variable(EquityIndexMethodology, k, v)) and (index_variable_of(v, TheIndex)))" .
g015:ASSERT_non_conclusive_means_not_conclusive a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall l: CorporateActionList, (non_conclusive(l)) iff (not (conclusive(l)))" .
g015:ASSERT_corporate_action_deviation_conditions a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: PermittedCorporateActionDeviation, (deviation_in_accordance_with_methodology(d, EquityIndexMethodology)) and (exists ca: IndexMaintenanceCorporateAction, (deviation_for_corporate_action(d, ca)) and (considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)) and ((unusual(ca)) or (complex(ca)) or ((deviation_preserves_index_quality_over_time(d, TheIndex, Comparability)) and (deviation_preserves_index_quality_over_time(d, TheIndex, Representativeness)))))" .


