g004:ICE owl:sameAs g004:IntercontinentalExchange .
g004:ASSERT_intraday_calculation_window a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, (intraday_calculation_time(d, t)) implies ((calculation_mode(t, IntradayCalculation)) and (calculation_time_from_to(t, Time1_00AMCET, Time10_50PMCET, CET)) and (intraday_level_calculated_on(intraday_level(TheIndex, d, t), d, t)))" .
g004:ASSERT_intraday_level_uses_exchange_trading_prices a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c))) implies (exists e: Exchange, (listed_on_exchanges(d, c, e)) and (price_on_exchange(intraday_source_price(c, d, t), e)) and (price_used_for_level(intraday_level(TheIndex, d, t), c, intraday_calculation_price(c, d, t))))" .
g004:ASSERT_current_trading_price_used_when_available a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c)) and (current_trading_price_available(c, d, t))) implies ((intraday_source_price(c, d, t)) = (current_trading_price(c, d, t)))" .
g004:ASSERT_no_current_trading_price_fallback a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c)) and (not (current_trading_price_available(c, d, t)))) implies ((intraday_source_price(c, d, t)) = (later_of(most_recent_closing_price(c, d, t), last_available_trading_price(c, preceding_trading_day(d)))))" .
g004:ASSERT_fallback_price_candidates_are_temporally_comparable a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c))) implies ((price_selection_order(most_recent_closing_price(c, d, t), last_available_trading_price(c, preceding_trading_day(d)))) or (price_selection_order(last_available_trading_price(c, preceding_trading_day(d)), most_recent_closing_price(c, d, t))))" .
g004:ASSERT_later_of_returns_a_candidate a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall p1: Price, forall p2: Price, ((later_of(p1, p2)) = (p1)) or ((later_of(p1, p2)) = (p2))" .
g004:ASSERT_later_of_selects_temporally_later_candidate a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall p1: Price, forall p2: Price, ((price_selection_order(p1, p2)) implies ((later_of(p1, p2)) = (p1))) and ((price_selection_order(p2, p1)) implies ((later_of(p1, p2)) = (p2)))" .
g004:ASSERT_intraday_price_kept_when_listed_in_index_currency a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c)) and ((listed_currency(d, c)) = (index_currency(TheIndex)))) implies ((intraday_calculation_price(c, d, t)) = (intraday_source_price(c, d, t)))" .
g004:ASSERT_intraday_price_converted_when_not_listed_in_index_currency a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c)) and (not ((listed_currency(d, c)) = (index_currency(TheIndex))))) implies (converted_from_using(intraday_calculation_price(c, d, t), intraday_source_price(c, d, t), current_ice_spot_foreign_exchange_rate(listed_currency(d, c), index_currency(TheIndex), d, t)))" .
g004:ASSERT_current_ice_spot_foreign_exchange_rate_source a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall src: Currency, forall tgt: Currency, forall d: CalculationDay, forall t: CalculationTime, foreign_exchange_rate_provider(current_ice_spot_foreign_exchange_rate(src, tgt, d, t), IntercontinentalExchange)" .
g004:ASSERT_closing_level_calculated_each_calculation_day a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall d: CalculationDay, closing_level_calculated_on(closing_level(TheIndex, d), d)" .
g004:ASSERT_closing_level_based_on_closing_prices a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall c: IndexComponent, (index_component(d, c)) implies (exists e: Exchange, (listed_on_exchanges(d, c, e)) and (price_on_exchange(closing_price(c, d), e)) and (price_used_for_level(closing_level(TheIndex, d), c, closing_calculation_price(c, d))))" .
g004:ASSERT_closing_price_kept_when_listed_in_index_currency a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall c: IndexComponent, ((index_component(d, c)) and ((listed_currency(d, c)) = (index_currency(TheIndex)))) implies ((closing_calculation_price(c, d)) = (closing_price(c, d)))" .
g004:ASSERT_closing_price_converted_with_available_wm_fixing a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall c: IndexComponent, ((index_component(d, c)) and (not ((listed_currency(d, c)) = (index_currency(TheIndex)))) and (wm_fixing_4pm_london_available(listed_currency(d, c), index_currency(TheIndex), d))) implies (((wm_fixing_for_closing_level(listed_currency(d, c), index_currency(TheIndex), d)) = (wm_fixing_4pm_london(listed_currency(d, c), index_currency(TheIndex), d))) and (converted_from_using(closing_calculation_price(c, d), closing_price(c, d), wm_fixing_for_closing_level(listed_currency(d, c), index_currency(TheIndex), d))))" .
g004:ASSERT_closing_price_converted_with_last_available_wm_fixing a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: CalculationDay, forall c: IndexComponent, ((index_component(d, c)) and (not ((listed_currency(d, c)) = (index_currency(TheIndex)))) and (not (wm_fixing_4pm_london_available(listed_currency(d, c), index_currency(TheIndex), d)))) implies (((wm_fixing_for_closing_level(listed_currency(d, c), index_currency(TheIndex), d)) = (last_available_wm_fixing_4pm_london(listed_currency(d, c), index_currency(TheIndex), d))) and (converted_from_using(closing_calculation_price(c, d), closing_price(c, d), wm_fixing_for_closing_level(listed_currency(d, c), index_currency(TheIndex), d))))" .
g004:ASSERT_wm_fixing_4pm_london_quoted_by_reuters a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall src: Currency, forall tgt: Currency, forall d: CalculationDay, (wm_fixing_quoted_by(wm_fixing_4pm_london(src, tgt, d), Reuters)) and (fixing_time(wm_fixing_4pm_london(src, tgt, d), Time04_00PMLondon, LondonTime))" .
g004:ASSERT_last_available_wm_fixing_4pm_london_quoted_by_reuters a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall src: Currency, forall tgt: Currency, forall d: CalculationDay, (wm_fixing_quoted_by(last_available_wm_fixing_4pm_london(src, tgt, d), Reuters)) and (fixing_time(last_available_wm_fixing_4pm_london(src, tgt, d), Time04_00PMLondon, LondonTime))" .


