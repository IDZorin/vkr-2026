# --- definition / N30 / definitions/N30/main_ir.a4v3 ---
g052:N30 a owl:Ontology .

g052:Index a owl:Class .
g052:Security a owl:Class .
g052:Security rdfs:subClassOf g052:FinancialInstrument .
g052:IndexComponent a owl:Class .
g052:IndexComponent rdfs:subClassOf g052:Security .
g052:RebalanceDay a owl:Class .
g052:RebalanceDay rdfs:subClassOf g052:Day .
g052:CalculationDay a owl:Class .
g052:CalculationDay rdfs:subClassOf g052:Day .
g052:Exchange a owl:Class .
g052:IndexAdministrator a owl:Class .
g052:IndexAdministrator rdfs:subClassOf g052:Organization .
g052:IndexAdministratorForThisIndex a owl:Class .
g052:IndexAdministratorForThisIndex rdfs:subClassOf g052:IndexAdministrator .
g052:IndexComponentInclusion a owl:Class .
g052:TradingDayContext a owl:Class .
g052:TradingDayDetermination a owl:Class .
g052:ExchangeClosingTime a owl:Class .
g052:TradingCessationPossibility a owl:Class .
g052:ScheduledShortenedPeriod a owl:Class .
g052:ScheduledShortenedPeriod rdfs:subClassOf g052:Period .
g052:CloseOfTrading a owl:Class .
g052:CloseOfTrading rdfs:subClassOf g052:Event .

g052:TheIndex a g052:Index, owl:NamedIndividual .
g052:TheIndexAdministrator a g052:IndexAdministratorForThisIndex, owl:NamedIndividual .
g052:relevant_exchange a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain g052:IndexComponent ;
  rdfs:range g052:Exchange .
g052:scheduled_exchange_closing_time a owl:Class, a4:NaryRelationClass .
g052:scheduled_exchange_closing_time_arg_0 a owl:ObjectProperty ;
  rdfs:domain g052:scheduled_exchange_closing_time ;
  rdfs:range g052:Exchange .
g052:scheduled_exchange_closing_time_arg_1 a owl:ObjectProperty ;
  rdfs:domain g052:scheduled_exchange_closing_time ;
  rdfs:range g052:Day .
g052:scheduled_exchange_closing_time_result a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain g052:scheduled_exchange_closing_time ;
  rdfs:range g052:ExchangeClosingTime .
g052:inclusion_component a owl:ObjectProperty ;
  rdfs:domain g052:IndexComponentInclusion ;
  rdfs:range g052:IndexComponent .
g052:inclusion_index a owl:ObjectProperty ;
  rdfs:domain g052:IndexComponentInclusion ;
  rdfs:range g052:Index .
g052:inclusion_day a owl:ObjectProperty ;
  rdfs:domain g052:IndexComponentInclusion ;
  rdfs:range g052:Day .
g052:calculation_day_immediately_following_rebalance_day a owl:ObjectProperty ;
  rdfs:domain g052:CalculationDay ;
  rdfs:range g052:RebalanceDay .
g052:context_rebalance_day a owl:ObjectProperty ;
  rdfs:domain g052:TradingDayContext ;
  rdfs:range g052:RebalanceDay .
g052:context_day a owl:ObjectProperty ;
  rdfs:domain g052:TradingDayContext ;
  rdfs:range g052:Day .
g052:context_component a owl:ObjectProperty ;
  rdfs:domain g052:TradingDayContext ;
  rdfs:range g052:IndexComponent .
g052:context_exchange a owl:ObjectProperty ;
  rdfs:domain g052:TradingDayContext ;
  rdfs:range g052:Exchange .
g052:valid_trading_day_context a owl:Class ; rdfs:subClassOf g052:TradingDayContext .
g052:context_component_included_at_rebalance_day a owl:Class ; rdfs:subClassOf g052:TradingDayContext .
g052:context_component_included_at_following_calculation_day a owl:Class ; rdfs:subClassOf g052:TradingDayContext .
g052:context_satisfies_open_for_trading_condition a owl:Class ; rdfs:subClassOf g052:TradingDayContext .
g052:context_satisfies_market_disruption_counterfactual a owl:Class ; rdfs:subClassOf g052:TradingDayContext .
g052:context_excluded_by_prior_to_close_cessation a owl:Class ; rdfs:subClassOf g052:TradingDayContext .
g052:context_excluded_by_scheduled_shortened_period a owl:Class ; rdfs:subClassOf g052:TradingDayContext .
g052:trading_day a owl:Class ; rdfs:subClassOf g052:TradingDayContext .
g052:exchange_open_for_trading a owl:ObjectProperty ;
  rdfs:domain g052:Exchange ;
  rdfs:range g052:Day .
g052:market_disruption_occurred a owl:ObjectProperty ;
  rdfs:domain g052:Exchange ;
  rdfs:range g052:Day .
g052:would_have_been_open_for_trading_without_market_disruption a owl:ObjectProperty ;
  rdfs:domain g052:Exchange ;
  rdfs:range g052:Day .
g052:cessation_possibility_exchange a owl:ObjectProperty ;
  rdfs:domain g052:TradingCessationPossibility ;
  rdfs:range g052:Exchange .
g052:cessation_possibility_day a owl:ObjectProperty ;
  rdfs:domain g052:TradingCessationPossibility ;
  rdfs:range g052:Day .
g052:prior_to a owl:ObjectProperty ;
  rdfs:domain g052:TradingCessationPossibility ;
  rdfs:range g052:ExchangeClosingTime .
g052:shortened_period_exchange a owl:ObjectProperty ;
  rdfs:domain g052:ScheduledShortenedPeriod ;
  rdfs:range g052:Exchange .
g052:shortened_period_day a owl:ObjectProperty ;
  rdfs:domain g052:ScheduledShortenedPeriod ;
  rdfs:range g052:Day .
g052:security_to_be_included_in_index_as_new_index_component a owl:ObjectProperty ;
  rdfs:domain g052:Security ;
  rdfs:range g052:Index .
g052:close_of_trading_exchange a owl:ObjectProperty ;
  rdfs:domain g052:CloseOfTrading ;
  rdfs:range g052:Exchange .
g052:close_of_trading_rebalance_day a owl:ObjectProperty ;
  rdfs:domain g052:CloseOfTrading ;
  rdfs:range g052:RebalanceDay .
g052:context_captures_new_index_component_close_of_trading a owl:Class ; rdfs:subClassOf g052:TradingDayContext .
g052:determination_decides_whether_context_is_trading_day a owl:ObjectProperty ;
  rdfs:domain g052:TradingDayDetermination ;
  rdfs:range g052:TradingDayContext .
g052:ultimately_responsible_for_trading_day_determination a owl:ObjectProperty ;
  rdfs:domain g052:IndexAdministratorForThisIndex ;
  rdfs:range g052:TradingDayDetermination .

g052:ASSERT_trading_day_context_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ctx: TradingDayContext, (valid_trading_day_context(ctx)) iff (exists rd: RebalanceDay, exists d: Day, exists c: IndexComponent, (context_rebalance_day(ctx, rd)) and (context_day(ctx, d)) and (context_component(ctx, c)) and (context_exchange(ctx, relevant_exchange(c))) and ((context_component_included_at_rebalance_day(ctx)) or (context_component_included_at_following_calculation_day(ctx))))" .
g052:ASSERT_rebalance_day_component_scope a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ctx: TradingDayContext, (context_component_included_at_rebalance_day(ctx)) iff (exists rd: RebalanceDay, exists c: IndexComponent, exists inc: IndexComponentInclusion, (context_rebalance_day(ctx, rd)) and (context_component(ctx, c)) and (inclusion_component(inc, c)) and (inclusion_index(inc, TheIndex)) and (inclusion_day(inc, rd)))" .
g052:ASSERT_following_calculation_day_component_scope a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ctx: TradingDayContext, (context_component_included_at_following_calculation_day(ctx)) iff (exists rd: RebalanceDay, exists cd: CalculationDay, exists c: IndexComponent, exists inc: IndexComponentInclusion, (context_rebalance_day(ctx, rd)) and (calculation_day_immediately_following_rebalance_day(cd, rd)) and (context_component(ctx, c)) and (inclusion_component(inc, c)) and (inclusion_index(inc, TheIndex)) and (inclusion_day(inc, cd)))" .
g052:ASSERT_open_for_trading_condition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ctx: TradingDayContext, (context_satisfies_open_for_trading_condition(ctx)) iff (exists d: Day, exists g052: Exchange, (context_day(ctx, d)) and (context_exchange(ctx, ex)) and (exchange_open_for_trading(ex, d)))" .
g052:ASSERT_market_disruption_counterfactual_condition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ctx: TradingDayContext, (context_satisfies_market_disruption_counterfactual(ctx)) iff (exists d: Day, exists g052: Exchange, (context_day(ctx, d)) and (context_exchange(ctx, ex)) and (market_disruption_occurred(ex, d)) and (would_have_been_open_for_trading_without_market_disruption(ex, d)))" .
g052:ASSERT_early_cessation_exclusion a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ctx: TradingDayContext, (context_excluded_by_prior_to_close_cessation(ctx)) iff (exists d: Day, exists g052: Exchange, exists cp: TradingCessationPossibility, (context_day(ctx, d)) and (context_exchange(ctx, ex)) and (cessation_possibility_exchange(cp, ex)) and (cessation_possibility_day(cp, d)) and (prior_to(cp, scheduled_exchange_closing_time(ex, d))))" .
g052:ASSERT_scheduled_shortened_period_exclusion a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ctx: TradingDayContext, (context_excluded_by_scheduled_shortened_period(ctx)) iff (exists d: Day, exists g052: Exchange, exists sp: ScheduledShortenedPeriod, (context_day(ctx, d)) and (context_exchange(ctx, ex)) and (shortened_period_exchange(sp, ex)) and (shortened_period_day(sp, d)))" .
g052:ASSERT_trading_day_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ctx: TradingDayContext, (valid_trading_day_context(ctx)) implies ((trading_day(ctx)) iff (((context_satisfies_open_for_trading_condition(ctx)) or (context_satisfies_market_disruption_counterfactual(ctx))) and (not (context_excluded_by_prior_to_close_cessation(ctx))) and (not (context_excluded_by_scheduled_shortened_period(ctx)))))" .
g052:ASSERT_new_index_components_close_of_trading_clarification a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ctx: TradingDayContext, (context_captures_new_index_component_close_of_trading(ctx)) iff (exists rd: RebalanceDay, exists c: IndexComponent, exists close: CloseOfTrading, (context_rebalance_day(ctx, rd)) and (context_component(ctx, c)) and (security_to_be_included_in_index_as_new_index_component(c, TheIndex)) and (close_of_trading_exchange(close, relevant_exchange(c))) and (close_of_trading_rebalance_day(close, rd)))" .
g052:ASSERT_index_administrator_responsibility_for_trading_day_determination a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall det: TradingDayDetermination, forall ctx: TradingDayContext, ((determination_decides_whether_context_is_trading_day(det, ctx)) and (valid_trading_day_context(ctx))) implies (ultimately_responsible_for_trading_day_determination(TheIndexAdministrator, det))" .


# --- definition / N31 / definitions/N31/main_ir.a4v3 ---
g053:N31 a owl:Ontology .

g053:IndexComponent a owl:Class .
g053:IndexComponent rdfs:subClassOf g053:FinancialInstrument .
g053:TradingDay a owl:Class .
g053:TradingDay rdfs:subClassOf g053:Day .
g053:Exchange a owl:Class .
g053:Price a owl:Class .
g053:Price rdfs:subClassOf g053:Real .
g053:TradingPrice a owl:Class .
g053:TradingPrice rdfs:subClassOf g053:Price .
g053:Trade a owl:Class .
g053:TradeTime a owl:Class .
g053:TradeTime rdfs:subClassOf g053:Real .

g053:trading_price a owl:Class, a4:NaryRelationClass .
g053:trading_price_arg_0 a owl:ObjectProperty ;
  rdfs:domain g053:trading_price ;
  rdfs:range g053:IndexComponent .
g053:trading_price_arg_1 a owl:ObjectProperty ;
  rdfs:domain g053:trading_price ;
  rdfs:range g053:TradingDay .
g053:trading_price_result a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain g053:trading_price ;
  rdfs:range g053:TradingPrice .
g053:respective_exchange a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain g053:IndexComponent ;
  rdfs:range g053:Exchange .
g053:trade_price a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain g053:Trade ;
  rdfs:range g053:Price .
g053:trade_time a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain g053:Trade ;
  rdfs:range g053:TradeTime .
g053:trade_component a owl:ObjectProperty ;
  rdfs:domain g053:Trade ;
  rdfs:range g053:IndexComponent .
g053:trade_day a owl:ObjectProperty ;
  rdfs:domain g053:Trade ;
  rdfs:range g053:TradingDay .
g053:trade_exchange a owl:ObjectProperty ;
  rdfs:domain g053:Trade ;
  rdfs:range g053:Exchange .
g053:published_trade a owl:Class ; rdfs:subClassOf g053:Trade .
g053:most_recent_published_trade_for a owl:Class, a4:NaryRelationClass .
g053:most_recent_published_trade_for_arg_0 a owl:ObjectProperty ;
  rdfs:domain g053:most_recent_published_trade_for ;
  rdfs:range g053:Trade .
g053:most_recent_published_trade_for_arg_1 a owl:ObjectProperty ;
  rdfs:domain g053:most_recent_published_trade_for ;
  rdfs:range g053:IndexComponent .
g053:most_recent_published_trade_for_arg_2 a owl:ObjectProperty ;
  rdfs:domain g053:most_recent_published_trade_for ;
  rdfs:range g053:TradingDay .

g053:ASSERT_most_recent_published_trade_scope a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall t: Trade, forall c: IndexComponent, forall d: TradingDay, (most_recent_published_trade_for(t, c, d)) implies ((published_trade(t)) and (trade_component(t, c)) and (trade_day(t, d)) and (trade_exchange(t, respective_exchange(c))))" .
g053:ASSERT_most_recent_published_trade_temporal_ordering a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall t: Trade, forall other: Trade, forall c: IndexComponent, forall d: TradingDay, ((most_recent_published_trade_for(t, c, d)) and (published_trade(other)) and (trade_component(other, c)) and (trade_day(other, d)) and (trade_exchange(other, respective_exchange(c)))) implies ((trade_time(t)) >= (trade_time(other)))" .
g053:ASSERT_most_recent_published_trade_uniqueness a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall t1: Trade, forall t2: Trade, forall c: IndexComponent, forall d: TradingDay, ((most_recent_published_trade_for(t1, c, d)) and (most_recent_published_trade_for(t2, c, d))) implies ((t1) = (t2))" .
g053:ASSERT_trading_price_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall c: IndexComponent, forall d: TradingDay, exists t: Trade, (most_recent_published_trade_for(t, c, d)) and ((trading_price(c, d)) = (trade_price(t)))" .


