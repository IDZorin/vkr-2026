# --- section / section_1_1 / sections/section_1_1/main_ir.a4v3 ---
g001:section_1_1 a owl:Ontology .

g001:Index a owl:Class .
g001:Security a owl:Class .
g001:AssetClass a owl:Class ; owl:oneOf ( g001:Equity ) .
g001:Equity a g001:AssetClass, owl:NamedIndividual .
g001:IndexStrategy a owl:Class .
g001:BusinessField a owl:Class ; owl:oneOf ( g001:CleanEnergy ) .
g001:CleanEnergy a g001:BusinessField, owl:NamedIndividual .
g001:RegionalAllocation a owl:Class ; owl:oneOf ( g001:DevelopedMarketsEurope g001:UnitedStates g001:Canada ) .
g001:DevelopedMarketsEurope a g001:RegionalAllocation, owl:NamedIndividual .
g001:UnitedStates a g001:RegionalAllocation, owl:NamedIndividual .
g001:Canada a g001:RegionalAllocation, owl:NamedIndividual .
g001:RebalancingFeeStatus a owl:Class ; owl:oneOf ( g001:NoRebalancingFee ) .
g001:NoRebalancingFee a g001:RebalancingFeeStatus, owl:NamedIndividual .
g001:RebalancingFrequency a owl:Class ; owl:oneOf ( g001:SemiAnnual ) .
g001:SemiAnnual a g001:RebalancingFrequency, owl:NamedIndividual .

g001:TheIndex a g001:Index, owl:NamedIndividual .
g001:CleanEnergyBusinessOperationsStrategy a g001:IndexStrategy, owl:NamedIndividual .
g001:asset_class a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain g001:Index ;
  rdfs:range g001:AssetClass .
g001:rebalancing_fee_status a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain g001:Index ;
  rdfs:range g001:RebalancingFeeStatus .
g001:rebalancing_frequency a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain g001:Index ;
  rdfs:range g001:RebalancingFrequency .
g001:index_strategy a owl:ObjectProperty ;
  rdfs:domain g001:Index ;
  rdfs:range g001:IndexStrategy .
g001:regional_allocation a owl:ObjectProperty ;
  rdfs:domain g001:Index ;
  rdfs:range g001:RegionalAllocation .
g001:rebalancing_fee_charged a owl:Class ; rdfs:subClassOf g001:Index .
g001:strategy_representation_of_security a owl:ObjectProperty ;
  rdfs:domain g001:IndexStrategy ;
  rdfs:range g001:Security .
g001:security_has_business_operations_in a owl:ObjectProperty ;
  rdfs:domain g001:Security ;
  rdfs:range g001:BusinessField .

g001:TheIndex g001:asset_class g001:Equity .
g001:TheIndex g001:index_strategy g001:CleanEnergyBusinessOperationsStrategy .
g001:TheIndex g001:regional_allocation g001:DevelopedMarketsEurope .
g001:TheIndex g001:regional_allocation g001:UnitedStates .
g001:TheIndex g001:regional_allocation g001:Canada .
g001:TheIndex g001:rebalancing_fee_status g001:NoRebalancingFee .
g001:TheIndex g001:rebalancing_frequency g001:SemiAnnual .
g001:ASSERT_clean_energy_strategy_represents_clean_energy_securities a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall s: Security, (strategy_representation_of_security(CleanEnergyBusinessOperationsStrategy, s)) implies (security_has_business_operations_in(s, CleanEnergy))" .
g001:ASSERT_no_rebalancing_fee_means_rebalancing_fee_not_charged a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall i: Index, ((rebalancing_fee_status(i)) = (NoRebalancingFee)) implies (not (rebalancing_fee_charged(i)))" .


# --- section / section_1_2 / sections/section_1_2/main_ir.a4v3 ---
