g003:LiveDate29_09_2025 a g003:live_date .
g003:Article8OfBMR g003:article_number "8"^^xsd:integer .
g003:ASSERT_article_8_of_bmr a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(part_of_document(Article8OfBMR, BMR)) and ((article_number(Article8OfBMR)) = (8))" .
g003:ASSERT_initial_level_default_on_start_date a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall i: Index, ((section_1_3_index(i)) and (not ((i) = (SolactiveTransatlanticCleanEnergyEURIndex50AR)))) implies ((initial_level(i, StartDate05_08_2017)) = (1000))" .
g003:FACT_initial_level_50_ar_on_start_date_initial_level_0 a g003:initial_level .
g003:FACT_initial_level_50_ar_on_start_date_initial_level_0 g003:initial_level_arg_0 g003:SolactiveTransatlanticCleanEnergyEURIndex50AR .
g003:FACT_initial_level_50_ar_on_start_date_initial_level_0 g003:initial_level_arg_1 g003:StartDate05_08_2017 .
g003:FACT_initial_level_50_ar_on_start_date_initial_level_0 g003:initial_level_result "739.08"^^xsd:decimal .
g003:ASSERT_historical_values_from_live_date_recorded_in_accordance_with_article_8_of_bmr a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall i: Index, forall d: Day, forall l: IndexLevel, ((section_1_3_index(i)) and (historical_value(l, i, d)) and (not (day_before(d, LiveDate29_09_2025)))) implies (recorded_in_accordance_with(l, Article8OfBMR))" .
g003:ASSERT_levels_published_prior_to_live_date_back_tested a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall i: Index, forall p: Period, forall l: IndexLevel, ((section_1_3_index(i)) and (published_level_for_period(l, i, p)) and (period_prior_to(p, LiveDate29_09_2025))) implies (back_tested(l))" .


