@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:N15 a a4:ProjectionTarget ;
  a4:relativePath "definitions/N15/main_ir.a4v3" ;
  a4:targetKind "definition" .

ex:GbsIndex a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:Security a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:Security rdfs:subClassOf ex:FinancialInstrument .

ex:GbsIndexSpecifiedInSection2_1 a ex:GbsIndex, owl:NamedIndividual .
ex:Section2_1 a ex:DocumentPart, owl:NamedIndividual .
ex:gbs_index_component a rdf:Property, a4:RelSymbol ;
  a4:arity "2"^^xsd:integer .
ex:gbs_index_component_arg_0 a a4:Argument ; a4:position "0"^^xsd:integer ; a4:sort ex:Security .
ex:gbs_index_component a4:argument ex:gbs_index_component_arg_0 .
ex:gbs_index_component_arg_1 a a4:Argument ; a4:position "1"^^xsd:integer ; a4:sort ex:GbsIndex .
ex:gbs_index_component a4:argument ex:gbs_index_component_arg_1 .
ex:security_reflected_in_gbs_index a rdf:Property, a4:RelSymbol ;
  a4:arity "2"^^xsd:integer .
ex:security_reflected_in_gbs_index_arg_0 a a4:Argument ; a4:position "0"^^xsd:integer ; a4:sort ex:Security .
ex:security_reflected_in_gbs_index a4:argument ex:security_reflected_in_gbs_index_arg_0 .
ex:security_reflected_in_gbs_index_arg_1 a a4:Argument ; a4:position "1"^^xsd:integer ; a4:sort ex:GbsIndex .
ex:security_reflected_in_gbs_index a4:argument ex:security_reflected_in_gbs_index_arg_1 .
ex:gbs_index_specified_in_section a rdf:Property, a4:RelSymbol ;
  a4:arity "2"^^xsd:integer .
ex:gbs_index_specified_in_section_arg_0 a a4:Argument ; a4:position "0"^^xsd:integer ; a4:sort ex:GbsIndex .
ex:gbs_index_specified_in_section a4:argument ex:gbs_index_specified_in_section_arg_0 .
ex:gbs_index_specified_in_section_arg_1 a a4:Argument ; a4:position "1"^^xsd:integer ; a4:sort ex:DocumentPart .
ex:gbs_index_specified_in_section a4:argument ex:gbs_index_specified_in_section_arg_1 .

ex:ASSERT_gbs_index_specified_in_section_2_1 a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "11"^^xsd:integer ;
  a4:exprText "gbs_index_specified_in_section(GbsIndexSpecifiedInSection2_1, Section2_1)" ;
  a4:sourceText "fact gbs_index_specified_in_section_2_1 :\n  gbs_index_specified_in_section(GbsIndexSpecifiedInSection2_1, Section2_1)" .
ex:ASSERT_gbs_index_component_definition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "14"^^xsd:integer ;
  a4:exprText "forall s: Security, (gbs_index_component(s, GbsIndexSpecifiedInSection2_1)) iff (security_reflected_in_gbs_index(s, GbsIndexSpecifiedInSection2_1))" ;
  a4:sourceText "constraint gbs_index_component_definition :\n  forall s: Security,\n    gbs_index_component(s, GbsIndexSpecifiedInSection2_1)\n    iff security_reflected_in_gbs_index(s, GbsIndexSpecifiedInSection2_1)" .
