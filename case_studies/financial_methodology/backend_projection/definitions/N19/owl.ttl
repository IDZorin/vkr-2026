@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:N19 a owl:Ontology .

ex:Index a owl:Class .
ex:Security a owl:Class .
ex:Security rdfs:subClassOf ex:FinancialInstrument .

ex:TheIndex a ex:Index, owl:NamedIndividual .
ex:index_component a owl:ObjectProperty ;
  rdfs:domain ex:Security ;
  rdfs:range ex:Index .
ex:security_reflected_in_index a owl:ObjectProperty ;
  rdfs:domain ex:Security ;
  rdfs:range ex:Index .

ex:ASSERT_index_component_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall s: Security, (index_component(s, TheIndex)) iff (security_reflected_in_index(s, TheIndex))" .
