ex:ASSERT_trading_day_context_definition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "60"^^xsd:integer ;
  a4:exprText "forall ctx: TradingDayContext, (valid_trading_day_context(ctx)) iff (exists rd: RebalanceDay, exists d: Day, exists c: IndexComponent, (context_rebalance_day(ctx, rd)) and (context_day(ctx, d)) and (context_component(ctx, c)) and (context_exchange(ctx, relevant_exchange(c))) and ((context_component_included_at_rebalance_day(ctx)) or (context_component_included_at_following_calculation_day(ctx))))" ;
  a4:sourceText "constraint trading_day_context_definition :\n  forall ctx: TradingDayContext,\n    valid_trading_day_context(ctx)\n    iff\n      exists rd: RebalanceDay, exists d: Day, exists c: IndexComponent,\n        context_rebalance_day(ctx, rd)\n        and context_day(ctx, d)\n        and context_component(ctx, c)\n        and context_exchange(ctx, relevant_exchange(c))\n        and\n          (\n            context_component_included_at_rebalance_day(ctx)\n            or context_component_included_at_following_calculation_day(ctx)\n          )" .
ex:ASSERT_rebalance_day_component_scope a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "75"^^xsd:integer ;
  a4:exprText "forall ctx: TradingDayContext, (context_component_included_at_rebalance_day(ctx)) iff (exists rd: RebalanceDay, exists c: IndexComponent, exists inc: IndexComponentInclusion, (context_rebalance_day(ctx, rd)) and (context_component(ctx, c)) and (inclusion_component(inc, c)) and (inclusion_index(inc, TheIndex)) and (inclusion_day(inc, rd)))" ;
  a4:sourceText "constraint rebalance_day_component_scope :\n  forall ctx: TradingDayContext,\n    context_component_included_at_rebalance_day(ctx)\n    iff\n      exists rd: RebalanceDay, exists c: IndexComponent, exists inc: IndexComponentInclusion,\n        context_rebalance_day(ctx, rd)\n        and context_component(ctx, c)\n        and inclusion_component(inc, c)\n        and inclusion_index(inc, TheIndex)\n        and inclusion_day(inc, rd)" .
ex:ASSERT_following_calculation_day_component_scope a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "86"^^xsd:integer ;
  a4:exprText "forall ctx: TradingDayContext, (context_component_included_at_following_calculation_day(ctx)) iff (exists rd: RebalanceDay, exists cd: CalculationDay, exists c: IndexComponent, exists inc: IndexComponentInclusion, (context_rebalance_day(ctx, rd)) and (calculation_day_immediately_following_rebalance_day(cd, rd)) and (context_component(ctx, c)) and (inclusion_component(inc, c)) and (inclusion_index(inc, TheIndex)) and (inclusion_day(inc, cd)))" ;
  a4:sourceText "constraint following_calculation_day_component_scope :\n  forall ctx: TradingDayContext,\n    context_component_included_at_following_calculation_day(ctx)\n    iff\n      exists rd: RebalanceDay, exists cd: CalculationDay, exists c: IndexComponent, exists inc: IndexComponentInclusion,\n        context_rebalance_day(ctx, rd)\n        and calculation_day_immediately_following_rebalance_day(cd, rd)\n        and context_component(ctx, c)\n        and inclusion_component(inc, c)\n        and inclusion_index(inc, TheIndex)\n        and inclusion_day(inc, cd)" .
ex:ASSERT_open_for_trading_condition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "98"^^xsd:integer ;
  a4:exprText "forall ctx: TradingDayContext, (context_satisfies_open_for_trading_condition(ctx)) iff (exists d: Day, exists ex: Exchange, (context_day(ctx, d)) and (context_exchange(ctx, ex)) and (exchange_open_for_trading(ex, d)))" ;
  a4:sourceText "constraint open_for_trading_condition :\n  forall ctx: TradingDayContext,\n    context_satisfies_open_for_trading_condition(ctx)\n    iff\n      exists d: Day, exists ex: Exchange,\n        context_day(ctx, d)\n        and context_exchange(ctx, ex)\n        and exchange_open_for_trading(ex, d)" .
ex:ASSERT_market_disruption_counterfactual_condition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "107"^^xsd:integer ;
  a4:exprText "forall ctx: TradingDayContext, (context_satisfies_market_disruption_counterfactual(ctx)) iff (exists d: Day, exists ex: Exchange, (context_day(ctx, d)) and (context_exchange(ctx, ex)) and (market_disruption_occurred(ex, d)) and (would_have_been_open_for_trading_without_market_disruption(ex, d)))" ;
  a4:sourceText "constraint market_disruption_counterfactual_condition :\n  forall ctx: TradingDayContext,\n    context_satisfies_market_disruption_counterfactual(ctx)\n    iff\n      exists d: Day, exists ex: Exchange,\n        context_day(ctx, d)\n        and context_exchange(ctx, ex)\n        and market_disruption_occurred(ex, d)\n        and would_have_been_open_for_trading_without_market_disruption(ex, d)" .
ex:ASSERT_early_cessation_exclusion a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "117"^^xsd:integer ;
  a4:exprText "forall ctx: TradingDayContext, (context_excluded_by_prior_to_close_cessation(ctx)) iff (exists d: Day, exists ex: Exchange, exists cp: TradingCessationPossibility, (context_day(ctx, d)) and (context_exchange(ctx, ex)) and (cessation_possibility_exchange(cp, ex)) and (cessation_possibility_day(cp, d)) and (prior_to(cp, scheduled_exchange_closing_time(ex, d))))" ;
  a4:sourceText "constraint early_cessation_exclusion :\n  forall ctx: TradingDayContext,\n    context_excluded_by_prior_to_close_cessation(ctx)\n    iff\n      exists d: Day, exists ex: Exchange, exists cp: TradingCessationPossibility,\n        context_day(ctx, d)\n        and context_exchange(ctx, ex)\n        and cessation_possibility_exchange(cp, ex)\n        and cessation_possibility_day(cp, d)\n        and prior_to(cp, scheduled_exchange_closing_time(ex, d))" .
ex:ASSERT_scheduled_shortened_period_exclusion a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "128"^^xsd:integer ;
  a4:exprText "forall ctx: TradingDayContext, (context_excluded_by_scheduled_shortened_period(ctx)) iff (exists d: Day, exists ex: Exchange, exists sp: ScheduledShortenedPeriod, (context_day(ctx, d)) and (context_exchange(ctx, ex)) and (shortened_period_exchange(sp, ex)) and (shortened_period_day(sp, d)))" ;
  a4:sourceText "constraint scheduled_shortened_period_exclusion :\n  forall ctx: TradingDayContext,\n    context_excluded_by_scheduled_shortened_period(ctx)\n    iff\n      exists d: Day, exists ex: Exchange, exists sp: ScheduledShortenedPeriod,\n        context_day(ctx, d)\n        and context_exchange(ctx, ex)\n        and shortened_period_exchange(sp, ex)\n        and shortened_period_day(sp, d)" .
ex:ASSERT_trading_day_definition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "138"^^xsd:integer ;
  a4:exprText "forall ctx: TradingDayContext, (valid_trading_day_context(ctx)) implies ((trading_day(ctx)) iff (((context_satisfies_open_for_trading_condition(ctx)) or (context_satisfies_market_disruption_counterfactual(ctx))) and (not (context_excluded_by_prior_to_close_cessation(ctx))) and (not (context_excluded_by_scheduled_shortened_period(ctx)))))" ;
  a4:sourceText "constraint trading_day_definition :\n  forall ctx: TradingDayContext,\n    valid_trading_day_context(ctx)\n    implies\n      (\n        trading_day(ctx)\n        iff\n          (\n            (\n              context_satisfies_open_for_trading_condition(ctx)\n              or context_satisfies_market_disruption_counterfactual(ctx)\n            )\n            and not context_excluded_by_prior_to_close_cessation(ctx)\n            and not context_excluded_by_scheduled_shortened_period(ctx)\n          )\n      )" .
ex:ASSERT_new_index_components_close_of_trading_clarification a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "155"^^xsd:integer ;
  a4:exprText "forall ctx: TradingDayContext, (context_captures_new_index_component_close_of_trading(ctx)) iff (exists rd: RebalanceDay, exists c: IndexComponent, exists close: CloseOfTrading, (context_rebalance_day(ctx, rd)) and (context_component(ctx, c)) and (security_to_be_included_in_index_as_new_index_component(c, TheIndex)) and (close_of_trading_exchange(close, relevant_exchange(c))) and (close_of_trading_rebalance_day(close, rd)))" ;
  a4:sourceText "constraint new_index_components_close_of_trading_clarification :\n  forall ctx: TradingDayContext,\n    context_captures_new_index_component_close_of_trading(ctx)\n    iff\n      exists rd: RebalanceDay, exists c: IndexComponent, exists close: CloseOfTrading,\n        context_rebalance_day(ctx, rd)\n        and context_component(ctx, c)\n        and security_to_be_included_in_index_as_new_index_component(c, TheIndex)\n        and close_of_trading_exchange(close, relevant_exchange(c))\n        and close_of_trading_rebalance_day(close, rd)" .
ex:ASSERT_index_administrator_responsibility_for_trading_day_determination a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "166"^^xsd:integer ;
  a4:exprText "forall det: TradingDayDetermination, forall ctx: TradingDayContext, ((determination_decides_whether_context_is_trading_day(det, ctx)) and (valid_trading_day_context(ctx))) implies (ultimately_responsible_for_trading_day_determination(TheIndexAdministrator, det))" ;
  a4:sourceText "constraint index_administrator_responsibility_for_trading_day_determination :\n  forall det: TradingDayDetermination, forall ctx: TradingDayContext,\n    determination_decides_whether_context_is_trading_day(det, ctx)\n    and valid_trading_day_context(ctx)\n    implies\n      ultimately_responsible_for_trading_day_determination(TheIndexAdministrator, det)" .
