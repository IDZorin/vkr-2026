@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:N12 a owl:Ontology .

ex:SelectionDay a owl:Class .
ex:SelectionDay rdfs:subClassOf ex:Day .
ex:Security a owl:Class .
ex:Security rdfs:subClassOf ex:FinancialInstrument .
ex:ShareClass a owl:Class .
ex:Share a owl:Class .
ex:ShareCount a owl:Class .
ex:ShareCount rdfs:subClassOf ex:Nat .
ex:Fraction a owl:Class .
ex:Fraction rdfs:subClassOf ex:Real .
ex:FreeFloat a owl:Class .
ex:FreeFloat rdfs:subClassOf ex:Fraction .
ex:DataVendor a owl:Class .

ex:share_class a owl:Class, a4:NaryRelationClass .
ex:share_class_arg_0 a owl:ObjectProperty ;
  rdfs:domain ex:share_class ;
  rdfs:range ex:SelectionDay .
ex:share_class_arg_1 a owl:ObjectProperty ;
  rdfs:domain ex:share_class ;
  rdfs:range ex:Security .
ex:share_class_result a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:share_class ;
  rdfs:range ex:ShareClass .
ex:free_float a owl:Class, a4:NaryRelationClass .
ex:free_float_arg_0 a owl:ObjectProperty ;
  rdfs:domain ex:free_float ;
  rdfs:range ex:SelectionDay .
ex:free_float_arg_1 a owl:ObjectProperty ;
  rdfs:domain ex:free_float ;
  rdfs:range ex:Security .
ex:free_float_result a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:free_float ;
  rdfs:range ex:FreeFloat .
ex:free_float_numerator a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:FreeFloat ;
  rdfs:range ex:ShareCount .
ex:free_float_denominator a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:FreeFloat ;
  rdfs:range ex:ShareCount .
ex:fulfills_index_component_requirements a owl:ObjectProperty ;
  rdfs:domain ex:SelectionDay ;
  rdfs:range ex:Security .
ex:share_of_share_class a owl:ObjectProperty ;
  rdfs:domain ex:Share ;
  rdfs:range ex:ShareClass .
ex:issued_share_on_selection_day a owl:ObjectProperty ;
  rdfs:domain ex:SelectionDay ;
  rdfs:range ex:Share .
ex:available_for_trading_by_market_participants a owl:ObjectProperty ;
  rdfs:domain ex:SelectionDay ;
  rdfs:range ex:Share .
ex:locked_in_by_long_term_holders a owl:ObjectProperty ;
  rdfs:domain ex:SelectionDay ;
  rdfs:range ex:Share .
ex:sourced_from_data_vendor a owl:ObjectProperty ;
  rdfs:domain ex:FreeFloat ;
  rdfs:range ex:DataVendor .

ex:ASSERT_free_float_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (fulfills_index_component_requirements(d, s)) implies (((free_float_numerator(free_float(d, s))) = (<count>)) and ((free_float_denominator(free_float(d, s))) = (<count>)) and ((free_float(d, s)) = ((free_float_numerator(free_float(d, s))) / (free_float_denominator(free_float(d, s))))) and (exists vendor: DataVendor, sourced_from_data_vendor(free_float(d, s), vendor)))" .
