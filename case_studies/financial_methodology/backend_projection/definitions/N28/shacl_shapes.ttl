@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:N28 a a4:ShaclProjectionTarget .

ex:DefinedTerm a rdfs:Class .
ex:DefinedTermShape a sh:NodeShape ; sh:targetClass ex:DefinedTerm .

ex:SolactiveTerm a ex:DefinedTerm .
ex:IntroductionSection a ex:DocumentPart .
ex:term_shall_have_meaning_defined_in_section a rdf:Property .
ex:DefinedTermShape sh:property [ sh:path ex:term_shall_have_meaning_defined_in_section ; sh:class ex:DocumentPart ] .

ex:SolactiveTerm ex:term_shall_have_meaning_defined_in_section ex:IntroductionSection .
