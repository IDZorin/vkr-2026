@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:N20 a owl:Ontology .

ex:DefinedTerm a owl:Class .

ex:IndexComponentRequirementsTerm a ex:DefinedTerm, owl:NamedIndividual .
ex:Section2_2 a ex:DocumentPart, owl:NamedIndividual .
ex:term_shall_have_meaning_defined_in_section a owl:ObjectProperty ;
  rdfs:domain ex:DefinedTerm ;
  rdfs:range ex:DocumentPart .

ex:IndexComponentRequirementsTerm ex:term_shall_have_meaning_defined_in_section ex:Section2_2 .
