@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:N23 a a4:ShaclProjectionTarget .

ex:IndexUniverse a rdfs:Class .
ex:IndexUniverseShape a sh:NodeShape ; sh:targetClass ex:IndexUniverse .
ex:IndexUniverseRequirements a rdfs:Class .
ex:IndexUniverseRequirementsShape a sh:NodeShape ; sh:targetClass ex:IndexUniverseRequirements .

ex:TheIndexUniverse a ex:IndexUniverse .
ex:TheIndexUniverseRequirements a ex:IndexUniverseRequirements .
ex:financial_instrument_in_index_universe a rdf:Property .
ex:FinancialInstrumentShape sh:property [ sh:path ex:financial_instrument_in_index_universe ; sh:class ex:IndexUniverse ] .
ex:fulfills_index_universe_requirements a rdf:Property .
ex:FinancialInstrumentShape sh:property [ sh:path ex:fulfills_index_universe_requirements ; sh:class ex:IndexUniverseRequirements ] .
ex:index_universe_is_sum_of_financial_instruments_fulfilling_requirements a rdf:Property .
ex:IndexUniverseShape sh:property [ sh:path ex:index_universe_is_sum_of_financial_instruments_fulfilling_requirements ; sh:class ex:IndexUniverseRequirements ] .

ex:TheIndexUniverse ex:index_universe_is_sum_of_financial_instruments_fulfilling_requirements ex:TheIndexUniverseRequirements .
