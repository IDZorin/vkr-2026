@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:N13 a a4:ProjectionTarget ;
  a4:relativePath "definitions/N13/main_ir.a4v3" ;
  a4:targetKind "definition" .

ex:SelectionDay a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:SelectionDay rdfs:subClassOf ex:Day .
ex:Security a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:Security rdfs:subClassOf ex:FinancialInstrument .
ex:ShareClass a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:ShareCount a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:ShareCount rdfs:subClassOf ex:Nat .
ex:ClosingPrice a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:ClosingPrice rdfs:subClassOf ex:MonetaryAmount .
ex:FreeFloatMarketCapitalization a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:FreeFloatMarketCapitalization rdfs:subClassOf ex:MonetaryAmount .
ex:DataVendor a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .

ex:share_class a rdf:Property, a4:FunSymbol ;
  a4:arity "2"^^xsd:integer .
ex:share_class_arg_0 a a4:Argument ; a4:position "0"^^xsd:integer ; a4:sort ex:SelectionDay .
ex:share_class a4:argument ex:share_class_arg_0 .
ex:share_class_arg_1 a a4:Argument ; a4:position "1"^^xsd:integer ; a4:sort ex:Security .
ex:share_class a4:argument ex:share_class_arg_1 .
ex:share_class a4:resultSort ex:ShareClass .
ex:share_class a4:functionFlag "required" .
ex:free_float_market_capitalization a rdf:Property, a4:FunSymbol ;
  a4:arity "2"^^xsd:integer .
ex:free_float_market_capitalization_arg_0 a a4:Argument ; a4:position "0"^^xsd:integer ; a4:sort ex:SelectionDay .
ex:free_float_market_capitalization a4:argument ex:free_float_market_capitalization_arg_0 .
ex:free_float_market_capitalization_arg_1 a a4:Argument ; a4:position "1"^^xsd:integer ; a4:sort ex:Security .
ex:free_float_market_capitalization a4:argument ex:free_float_market_capitalization_arg_1 .
ex:free_float_market_capitalization a4:resultSort ex:FreeFloatMarketCapitalization .
ex:free_float_market_capitalization a4:functionFlag "required" .
ex:shares_outstanding_in_free_float a rdf:Property, a4:FunSymbol ;
  a4:arity "2"^^xsd:integer .
ex:shares_outstanding_in_free_float_arg_0 a a4:Argument ; a4:position "0"^^xsd:integer ; a4:sort ex:SelectionDay .
ex:shares_outstanding_in_free_float a4:argument ex:shares_outstanding_in_free_float_arg_0 .
ex:shares_outstanding_in_free_float_arg_1 a a4:Argument ; a4:position "1"^^xsd:integer ; a4:sort ex:ShareClass .
ex:shares_outstanding_in_free_float a4:argument ex:shares_outstanding_in_free_float_arg_1 .
ex:shares_outstanding_in_free_float a4:resultSort ex:ShareCount .
ex:shares_outstanding_in_free_float a4:functionFlag "required" .
ex:closing_price_of_share_class a rdf:Property, a4:FunSymbol ;
  a4:arity "2"^^xsd:integer .
ex:closing_price_of_share_class_arg_0 a a4:Argument ; a4:position "0"^^xsd:integer ; a4:sort ex:SelectionDay .
ex:closing_price_of_share_class a4:argument ex:closing_price_of_share_class_arg_0 .
ex:closing_price_of_share_class_arg_1 a a4:Argument ; a4:position "1"^^xsd:integer ; a4:sort ex:ShareClass .
ex:closing_price_of_share_class a4:argument ex:closing_price_of_share_class_arg_1 .
ex:closing_price_of_share_class a4:resultSort ex:ClosingPrice .
ex:closing_price_of_share_class a4:functionFlag "required" .
ex:fulfills_index_component_requirements a rdf:Property, a4:RelSymbol ;
  a4:arity "2"^^xsd:integer .
ex:fulfills_index_component_requirements_arg_0 a a4:Argument ; a4:position "0"^^xsd:integer ; a4:sort ex:SelectionDay .
ex:fulfills_index_component_requirements a4:argument ex:fulfills_index_component_requirements_arg_0 .
ex:fulfills_index_component_requirements_arg_1 a a4:Argument ; a4:position "1"^^xsd:integer ; a4:sort ex:Security .
ex:fulfills_index_component_requirements a4:argument ex:fulfills_index_component_requirements_arg_1 .
ex:sourced_from_data_vendor a rdf:Property, a4:RelSymbol ;
  a4:arity "2"^^xsd:integer .
ex:sourced_from_data_vendor_arg_0 a a4:Argument ; a4:position "0"^^xsd:integer ; a4:sort ex:ShareCount .
ex:sourced_from_data_vendor a4:argument ex:sourced_from_data_vendor_arg_0 .
ex:sourced_from_data_vendor_arg_1 a a4:Argument ; a4:position "1"^^xsd:integer ; a4:sort ex:DataVendor .
ex:sourced_from_data_vendor a4:argument ex:sourced_from_data_vendor_arg_1 .

ex:ASSERT_free_float_market_capitalization_calculated_as_multiplication_definition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "17"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (fulfills_index_component_requirements(d, s)) implies (((free_float_market_capitalization(d, s)) = ((shares_outstanding_in_free_float(d, share_class(d, s))) * (closing_price_of_share_class(d, share_class(d, s))))) and (exists vendor: DataVendor, sourced_from_data_vendor(shares_outstanding_in_free_float(d, share_class(d, s)), vendor)))" ;
  a4:sourceText "constraint free_float_market_capitalization_calculated_as_multiplication_definition :\n  forall d: SelectionDay, forall s: Security,\n    fulfills_index_component_requirements(d, s)\n    implies\n      free_float_market_capitalization(d, s)\n      =\n      shares_outstanding_in_free_float(d, share_class(d, s))\n      * closing_price_of_share_class(d, share_class(d, s))\n      and exists vendor: DataVendor,\n        sourced_from_data_vendor(\n          shares_outstanding_in_free_float(d, share_class(d, s)),\n          vendor\n        )" .
