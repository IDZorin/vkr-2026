@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:N08 a a4:ShaclProjectionTarget .

ex:IndexComponent a rdfs:Class .
ex:IndexComponent rdfs:subClassOf ex:FinancialInstrument .
ex:IndexComponentShape a sh:NodeShape ; sh:targetClass ex:IndexComponent .
ex:TradingDay a rdfs:Class .
ex:TradingDay rdfs:subClassOf ex:Day .
ex:TradingDayShape a sh:NodeShape ; sh:targetClass ex:TradingDay .
ex:Exchange a rdfs:Class .
ex:ExchangeShape a sh:NodeShape ; sh:targetClass ex:Exchange .
ex:ClosingPrice a rdfs:Class .
ex:ClosingPrice rdfs:subClassOf ex:MonetaryAmount .
ex:ClosingPriceShape a sh:NodeShape ; sh:targetClass ex:ClosingPrice .
ex:DailyValueTraded a rdfs:Class .
ex:DailyValueTraded rdfs:subClassOf ex:MonetaryAmount .
ex:DailyValueTradedShape a sh:NodeShape ; sh:targetClass ex:DailyValueTraded .
ex:VolumeNumberOfShares a rdfs:Class .
ex:VolumeNumberOfShares rdfs:subClassOf ex:Nat .
ex:VolumeNumberOfSharesShape a sh:NodeShape ; sh:targetClass ex:VolumeNumberOfShares .

ex:closing_price a rdfs:Class .
ex:closing_priceShape a sh:NodeShape ; sh:targetClass ex:closing_price .
ex:closing_priceShape sh:property [ sh:path ex:closing_price_arg_0 ; sh:class ex:IndexComponent ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:closing_priceShape sh:property [ sh:path ex:closing_price_arg_1 ; sh:class ex:TradingDay ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:closing_priceShape sh:property [ sh:path ex:closing_price_result ; sh:class ex:ClosingPrice ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:daily_value_traded a rdfs:Class .
ex:daily_value_tradedShape a sh:NodeShape ; sh:targetClass ex:daily_value_traded .
ex:daily_value_tradedShape sh:property [ sh:path ex:daily_value_traded_arg_0 ; sh:class ex:IndexComponent ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:daily_value_tradedShape sh:property [ sh:path ex:daily_value_traded_arg_1 ; sh:class ex:TradingDay ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:daily_value_tradedShape sh:property [ sh:path ex:daily_value_traded_result ; sh:class ex:DailyValueTraded ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:volume_traded_on_exchange_during_trading_day a rdfs:Class .
ex:volume_traded_on_exchange_during_trading_dayShape a sh:NodeShape ; sh:targetClass ex:volume_traded_on_exchange_during_trading_day .
ex:volume_traded_on_exchange_during_trading_dayShape sh:property [ sh:path ex:volume_traded_on_exchange_during_trading_day_arg_0 ; sh:class ex:IndexComponent ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:volume_traded_on_exchange_during_trading_dayShape sh:property [ sh:path ex:volume_traded_on_exchange_during_trading_day_arg_1 ; sh:class ex:Exchange ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:volume_traded_on_exchange_during_trading_dayShape sh:property [ sh:path ex:volume_traded_on_exchange_during_trading_day_arg_2 ; sh:class ex:TradingDay ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:volume_traded_on_exchange_during_trading_dayShape sh:property [ sh:path ex:volume_traded_on_exchange_during_trading_day_result ; sh:class ex:VolumeNumberOfShares ; sh:minCount 1 ; sh:maxCount 1 ] .
ex:respective_exchange a rdf:Property .
ex:IndexComponentShape sh:property [ sh:path ex:respective_exchange ; sh:class ex:Exchange ; sh:minCount 1 ; sh:maxCount 1 ] .
