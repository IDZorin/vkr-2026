ex:ASSERT_section_4_7_index_scope a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "62"^^xsd:integer ;
  a4:exprText "index_of(TheIndex, Solactive)" ;
  a4:sourceText "fact section_4_7_index_scope :\n  index_of(TheIndex, Solactive)" .
ex:ASSERT_disruption_policy_reference a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "65"^^xsd:integer ;
  a4:exprText "(incorporated_by_reference_into(SolactiveDisruptionPolicy, ThisGuideline)) and (available_on(SolactiveDisruptionPolicy, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive))" ;
  a4:sourceText "fact disruption_policy_reference :\n  incorporated_by_reference_into(SolactiveDisruptionPolicy, ThisGuideline)\n  and available_on(SolactiveDisruptionPolicy, SolactiveWebsite)\n  and website_of(SolactiveWebsite, Solactive)" .
ex:ASSERT_disruption_arrangements_properties a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "70"^^xsd:integer ;
  a4:exprText "(predefined(SolactiveDisruptionArrangements)) and (exhaustive(SolactiveDisruptionArrangements)) and (described_in(SolactiveDisruptionArrangements, SolactiveDisruptionPolicy))" ;
  a4:sourceText "fact disruption_arrangements_properties :\n  predefined(SolactiveDisruptionArrangements)\n  and exhaustive(SolactiveDisruptionArrangements)\n  and described_in(SolactiveDisruptionArrangements, SolactiveDisruptionPolicy)" .
ex:ASSERT_calculation_during_market_stress_follows_arrangements a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "75"^^xsd:integer ;
  a4:exprText "forall i: Index, forall p: Period, forall s: MarketStress, ((index_of(i, Solactive)) and (period_of_market_stress(p, s))) implies (calculates_index_following_arrangement(Solactive, i, p, SolactiveDisruptionArrangements))" ;
  a4:sourceText "constraint calculation_during_market_stress_follows_arrangements :\n  forall i: Index, forall p: Period, forall s: MarketStress,\n    index_of(i, Solactive)\n    and period_of_market_stress(p, s)\n    implies\n      calculates_index_following_arrangement(\n        Solactive,\n        i,\n        p,\n        SolactiveDisruptionArrangements\n      )" .
ex:ASSERT_market_stress_can_arise_due_to_variety_of_reasons a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "87"^^xsd:integer ;
  a4:exprText "forall p: Period, forall s: MarketStress, (period_of_market_stress(p, s)) implies (market_stress_arises_due_to(s, VarietyOfReasons))" ;
  a4:sourceText "constraint market_stress_can_arise_due_to_variety_of_reasons :\n  forall p: Period, forall s: MarketStress,\n    period_of_market_stress(p, s)\n    implies\n      market_stress_arises_due_to(s, VarietyOfReasons)" .
ex:ASSERT_market_stress_generally_results_in_price_conditions a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "93"^^xsd:integer ;
  a4:exprText "forall p: Period, forall s: MarketStress, (period_of_market_stress(p, s)) implies (exists o: MarketStressPriceOutcome, exists c: IndexComponent, (market_stress_price_outcome(o, s)) and (price_outcome_component(o, c)) and (price_outcome_component_scope(o, OneOrMoreIndexComponents)) and (index_component_of(c, TheIndex)) and (price_outcome_qualified_by(o, Generally)) and ((price_outcome_inaccurate_or_delayed(o, Inaccurate)) or (price_outcome_inaccurate_or_delayed(o, Delayed))))" ;
  a4:sourceText "constraint market_stress_generally_results_in_price_conditions :\n  forall p: Period, forall s: MarketStress,\n    period_of_market_stress(p, s)\n    implies\n      exists o: MarketStressPriceOutcome,\n      exists c: IndexComponent,\n        market_stress_price_outcome(o, s)\n        and price_outcome_component(o, c)\n        and price_outcome_component_scope(o, OneOrMoreIndexComponents)\n        and index_component_of(c, TheIndex)\n        and price_outcome_qualified_by(o, Generally)\n        and (\n          price_outcome_inaccurate_or_delayed(o, Inaccurate)\n          or price_outcome_inaccurate_or_delayed(o, Delayed)\n        )" .
ex:ASSERT_index_determination_may_be_limited_or_impaired a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "109"^^xsd:integer ;
  a4:exprText "forall p: Period, ((exists s: MarketStress, period_of_market_stress(p, s)) or (exists m: IlliquidMarket, period_of_market_disruption(p, m)) or (exists f: FragmentedMarket, period_of_market_disruption(p, f))) implies (exists possibility: DeterminationConditionPossibility, (determination_possibility_for_index(possibility, TheIndex)) and (determination_possibility_at_period(possibility, p)) and (determination_possibility_qualified_by(possibility, MayBeLimitedOrImpaired)) and (determination_possibility_qualified_by(possibility, AtTimesOfMarketDisruption)) and ((determination_condition_possible(possibility, Limited)) or (determination_condition_possible(possibility, Impaired))))" ;
  a4:sourceText "constraint index_determination_may_be_limited_or_impaired :\n  forall p: Period,\n    (\n      (exists s: MarketStress,\n        period_of_market_stress(p, s))\n      or (exists m: IlliquidMarket,\n        period_of_market_disruption(p, m))\n      or (exists f: FragmentedMarket,\n        period_of_market_disruption(p, f))\n    )\n    implies\n      exists possibility: DeterminationConditionPossibility,\n        determination_possibility_for_index(possibility, TheIndex)\n        and determination_possibility_at_period(possibility, p)\n        and determination_possibility_qualified_by(\n          possibility,\n          MayBeLimitedOrImpaired\n        )\n        and determination_possibility_qualified_by(\n          possibility,\n          AtTimesOfMarketDisruption\n        )\n        and (\n          determination_condition_possible(possibility, Limited)\n          or determination_condition_possible(possibility, Impaired)\n        )" .
