ex:ASSERT_section_5_2_methodology_review_reference a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "110"^^xsd:integer ;
  a4:exprText "document_part_locator(Section5_2MethodologyReview, Section5_2MethodologyReviewLocator)" ;
  a4:sourceText "fact section_5_2_methodology_review_reference :\ndocument_part_locator(\n  Section5_2MethodologyReview,\n  Section5_2MethodologyReviewLocator\n)" .
ex:ASSERT_termination_policy_location a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "116"^^xsd:integer ;
  a4:exprText "(document_url(SolactiveTerminationPolicy, HttpsWwwSolactiveComDocumentsTerminationPolicy)) and (available_on(SolactiveTerminationPolicy, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive))" ;
  a4:sourceText "fact termination_policy_location :\ndocument_url(\n  SolactiveTerminationPolicy,\n  HttpsWwwSolactiveComDocumentsTerminationPolicy\n)\nand available_on(SolactiveTerminationPolicy, SolactiveWebsite)\nand website_of(SolactiveWebsite, Solactive)" .
ex:ASSERT_solactive_effort a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "124"^^xsd:integer ;
  a4:exprText "(effort_by(SolactiveGreatestPossibleEfforts, Solactive)) and (greatest_possible(SolactiveGreatestPossibleEfforts)) and (over_time(SolactiveGreatestPossibleEfforts))" ;
  a4:sourceText "fact solactive_effort :\neffort_by(SolactiveGreatestPossibleEfforts, Solactive)\nand greatest_possible(SolactiveGreatestPossibleEfforts)\nand over_time(SolactiveGreatestPossibleEfforts)" .
ex:ASSERT_solactive_efforts_for_resilience_and_integrity a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "129"^^xsd:integer ;
  a4:exprText "forall i: Index, (index_of(i, Solactive)) implies ((effort_to_ensure(SolactiveGreatestPossibleEfforts, i, Resilience)) and (effort_to_ensure(SolactiveGreatestPossibleEfforts, i, ContinuedIntegrity)))" ;
  a4:sourceText "constraint solactive_efforts_for_resilience_and_integrity :\nforall i: Index,\n  index_of(i, Solactive)\n  implies\n    effort_to_ensure(SolactiveGreatestPossibleEfforts, i, Resilience)\n    and effort_to_ensure(\n      SolactiveGreatestPossibleEfforts,\n      i,\n      ContinuedIntegrity\n    )" .
ex:ASSERT_methodology_adaptation_where_necessary a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "140"^^xsd:integer ;
  a4:exprText "forall i: Index, forall m: IndexMethodology, forall u: UnderlyingMarket, ((index_of(i, Solactive)) and (methodology_of_index(m, i)) and (necessary_to_adapt_methodology(m, u)) and (changing_underlying_market(u))) implies (exists p: Procedure, (follows(Solactive, p)) and (clearly_defined(p)) and (transparent(p)) and (adapts_index_methodology(p, m, u)) and (procedure_maintains(p, i, ContinuedReliability)) and (procedure_maintains(p, i, Comparability)) and (see(p, Section5_2MethodologyReview)))" ;
  a4:sourceText "constraint methodology_adaptation_where_necessary :\nforall i: Index, forall m: IndexMethodology, forall u: UnderlyingMarket,\n  index_of(i, Solactive)\n  and methodology_of_index(m, i)\n  and necessary_to_adapt_methodology(m, u)\n  and changing_underlying_market(u)\n  implies\n    exists p: Procedure,\n      follows(Solactive, p)\n      and clearly_defined(p)\n      and transparent(p)\n      and adapts_index_methodology(p, m, u)\n      and procedure_maintains(p, i, ContinuedReliability)\n      and procedure_maintains(p, i, Comparability)\n      and see(p, Section5_2MethodologyReview)" .
ex:ASSERT_cessation_usual_when_underlying_market_changes a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "156"^^xsd:integer ;
  a4:exprText "forall i: Index, (exists u: UnderlyingMarket, ((index_set_to_measure_underlying_market(i, u)) or (index_set_to_reflect_underlying_market(i, u))) and (underlying_market_changes(u)) and (underlying_market_change_described_by(u, Substantially)) and (not (underlying_market_change_foreseeable_at_inception(u, i)))) implies (usual_case_for_cessation(i))" ;
  a4:sourceText "constraint cessation_usual_when_underlying_market_changes :\nforall i: Index,\n  (\n    exists u: UnderlyingMarket,\n      (\n        index_set_to_measure_underlying_market(i, u)\n        or index_set_to_reflect_underlying_market(i, u)\n      )\n      and underlying_market_changes(u)\n      and underlying_market_change_described_by(u, Substantially)\n      and not underlying_market_change_foreseeable_at_inception(u, i)\n  )\n  implies usual_case_for_cessation(i)" .
ex:ASSERT_cessation_usual_when_economic_reality_changes a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "170"^^xsd:integer ;
  a4:exprText "forall i: Index, (exists e: EconomicReality, ((index_set_to_measure_economic_reality(i, e)) or (index_set_to_reflect_economic_reality(i, e))) and (economic_reality_changes(e)) and (economic_reality_change_described_by(e, Substantially)) and (not (economic_reality_change_foreseeable_at_inception(e, i)))) implies (usual_case_for_cessation(i))" ;
  a4:sourceText "constraint cessation_usual_when_economic_reality_changes :\nforall i: Index,\n  (\n    exists e: EconomicReality,\n      (\n        index_set_to_measure_economic_reality(i, e)\n        or index_set_to_reflect_economic_reality(i, e)\n      )\n      and economic_reality_changes(e)\n      and economic_reality_change_described_by(e, Substantially)\n      and not economic_reality_change_foreseeable_at_inception(e, i)\n  )\n  implies usual_case_for_cessation(i)" .
ex:ASSERT_cessation_usual_when_rules_not_applied_coherently a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "184"^^xsd:integer ;
  a4:exprText "forall i: Index, (exists r: IndexRule, (rule_of_index(r, i)) and (not (applied_coherently(r, i)))) implies (usual_case_for_cessation(i))" ;
  a4:sourceText "constraint cessation_usual_when_rules_not_applied_coherently :\nforall i: Index,\n  (\n    exists r: IndexRule,\n      rule_of_index(r, i)\n      and not applied_coherently(r, i)\n  )\n  implies usual_case_for_cessation(i)" .
ex:ASSERT_cessation_usual_when_selection_criteria_not_applied_coherently a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "193"^^xsd:integer ;
  a4:exprText "forall i: Index, (exists sc: SelectionCriteria, (rule_of_index(sc, i)) and (not (applied_coherently(sc, i)))) implies (usual_case_for_cessation(i))" ;
  a4:sourceText "constraint cessation_usual_when_selection_criteria_not_applied_coherently :\nforall i: Index,\n  (\n    exists sc: SelectionCriteria,\n      rule_of_index(sc, i)\n      and not applied_coherently(sc, i)\n  )\n  implies usual_case_for_cessation(i)" .
ex:ASSERT_cessation_usual_when_index_not_used_as_underlying_value a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "202"^^xsd:integer ;
  a4:exprText "forall i: Index, ((not (exists fi: FinancialInstrument, used_as_underlying_value_for_financial_instrument(i, fi))) and (not (exists f: InvestmentFund, used_as_underlying_value_for_investment_fund(i, f))) and (not (exists c: FinancialContract, used_as_underlying_value_for_financial_contract(i, c)))) implies (usual_case_for_cessation(i))" ;
  a4:sourceText "constraint cessation_usual_when_index_not_used_as_underlying_value :\nforall i: Index,\n  (\n    not exists fi: FinancialInstrument,\n      used_as_underlying_value_for_financial_instrument(i, fi)\n  )\n  and\n  (\n    not exists f: InvestmentFund,\n      used_as_underlying_value_for_investment_fund(i, f)\n  )\n  and\n  (\n    not exists c: FinancialContract,\n      used_as_underlying_value_for_financial_contract(i, c)\n  )\n  implies usual_case_for_cessation(i)" .
ex:ASSERT_orderly_cessation_indication_available_if_no_options a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "220"^^xsd:integer ;
  a4:exprText "forall i: Index, ((index_of(i, Solactive)) and (usual_case_for_cessation(i)) and ((<count>) = (0))) implies (orderly_cessation_indication_available(i))" ;
  a4:sourceText "constraint orderly_cessation_indication_available_if_no_options :\nforall i: Index,\n  index_of(i, Solactive)\n  and usual_case_for_cessation(i)\n  and count(o in Option where available_option_for_index(o, i)) = 0\n  implies orderly_cessation_indication_available(i)" .
ex:ASSERT_solactive_cessation_guidelines a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "227"^^xsd:integer ;
  a4:exprText "(established_by(SolactiveCessationGuidelines, Solactive)) and (maintained_by(SolactiveCessationGuidelines, Solactive)) and (clear(SolactiveCessationGuidelines))" ;
  a4:sourceText "fact solactive_cessation_guidelines :\nestablished_by(SolactiveCessationGuidelines, Solactive)\nand maintained_by(SolactiveCessationGuidelines, Solactive)\nand clear(SolactiveCessationGuidelines)" .
ex:ASSERT_guidelines_identify_unavoidable_cessation_situations a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "232"^^xsd:integer ;
  a4:exprText "forall s: CessationSituation, (guidelines_identify(SolactiveCessationGuidelines, s)) implies (unavoidable(s))" ;
  a4:sourceText "constraint guidelines_identify_unavoidable_cessation_situations :\nforall s: CessationSituation,\n  guidelines_identify(SolactiveCessationGuidelines, s)\n  implies unavoidable(s)" .
ex:ASSERT_guidelines_include_stakeholder_information_and_consultation_procedures a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "237"^^xsd:integer ;
  a4:exprText "exists p: Procedure, (procedure_in_guidelines(SolactiveCessationGuidelines, p)) and (procedure_for_informing(p, Stakeholders)) and (exists q: Procedure, (procedure_in_guidelines(SolactiveCessationGuidelines, q)) and (procedure_for_consulting(q, Stakeholders)))" ;
  a4:sourceText "fact guidelines_include_stakeholder_information_and_consultation_procedures :\nexists p: Procedure,\n  procedure_in_guidelines(SolactiveCessationGuidelines, p)\n  and procedure_for_informing(p, Stakeholders)\nand\nexists q: Procedure,\n  procedure_in_guidelines(SolactiveCessationGuidelines, q)\n  and procedure_for_consulting(q, Stakeholders)" .
ex:ASSERT_guidelines_include_termination_procedure a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "246"^^xsd:integer ;
  a4:exprText "exists p: Procedure, (procedure_in_guidelines(SolactiveCessationGuidelines, p)) and (procedure_for_termination(p))" ;
  a4:sourceText "fact guidelines_include_termination_procedure :\nexists p: Procedure,\n  procedure_in_guidelines(SolactiveCessationGuidelines, p)\n  and procedure_for_termination(p)" .
ex:ASSERT_guidelines_include_transition_procedure a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "251"^^xsd:integer ;
  a4:exprText "exists p: Procedure, exists a: AlternativeIndex, (procedure_in_guidelines(SolactiveCessationGuidelines, p)) and (procedure_for_transition_to_alternative_index(p, a))" ;
  a4:sourceText "fact guidelines_include_transition_procedure :\nexists p: Procedure, exists a: AlternativeIndex,\n  procedure_in_guidelines(SolactiveCessationGuidelines, p)\n  and procedure_for_transition_to_alternative_index(p, a)" .
ex:ASSERT_termination_policy_details a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "256"^^xsd:integer ;
  a4:exprText "(details_specified_in(SolactiveCessationGuidelines, SolactiveTerminationPolicy)) and (incorporated_by_reference(SolactiveTerminationPolicy))" ;
