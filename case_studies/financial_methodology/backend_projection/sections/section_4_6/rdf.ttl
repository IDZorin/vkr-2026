ex:ASSERT_solactive_greatest_possible_efforts a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "76"^^xsd:integer ;
  a4:exprText "(makes_effort(Solactive, SolactiveGreatestPossibleEfforts)) and (greatest_possible(SolactiveGreatestPossibleEfforts))" ;
  a4:sourceText "fact solactive_greatest_possible_efforts :\n  makes_effort(Solactive, SolactiveGreatestPossibleEfforts)\n  and greatest_possible(SolactiveGreatestPossibleEfforts)" .
ex:ASSERT_efforts_to_accurately_calculate_and_maintain_indices a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "80"^^xsd:integer ;
  a4:exprText "forall i: Index, (index_of(i, Solactive)) implies ((effort_goal(SolactiveGreatestPossibleEfforts, i, AccurateCalculation)) and (effort_goal(SolactiveGreatestPossibleEfforts, i, AccurateMaintenance)))" ;
  a4:sourceText "constraint efforts_to_accurately_calculate_and_maintain_indices :\n  forall i: Index,\n    index_of(i, Solactive)\n    implies\n      effort_goal(SolactiveGreatestPossibleEfforts, i, AccurateCalculation)\n      and effort_goal(SolactiveGreatestPossibleEfforts, i, AccurateMaintenance)" .
ex:ASSERT_determination_process_errors_may_occur_not_ruled_out a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "87"^^xsd:integer ;
  a4:exprText "(error_possibility_in_determination_process(DeterminationProcessErrorPossibility, SolactiveDeterminationProcess)) and (description_of_error_possibility(DeterminationProcessErrorDescription, DeterminationProcessErrorPossibility)) and (description_occurrence_term(DeterminationProcessErrorDescription, FromTimeToTime)) and (description_reason_term(DeterminationProcessErrorDescription, VarietyReasons)) and (description_polarity_term(DeterminationProcessErrorDescription, CannotBeCompletelyRuledOut)) and (error_possibility_reason(DeterminationProcessErrorPossibility, Internal)) and (error_possibility_reason(DeterminationProcessErrorPossibility, External)) and (not (completely_ruled_out(DeterminationProcessErrorPossibility)))" ;
  a4:sourceText "fact determination_process_errors_may_occur_not_ruled_out :\n  error_possibility_in_determination_process(\n    DeterminationProcessErrorPossibility,\n    SolactiveDeterminationProcess\n  )\n  and description_of_error_possibility(\n    DeterminationProcessErrorDescription,\n    DeterminationProcessErrorPossibility\n  )\n  and description_occurrence_term(\n    DeterminationProcessErrorDescription,\n    FromTimeToTime\n  )\n  and description_reason_term(\n    DeterminationProcessErrorDescription,\n    VarietyReasons\n  )\n  and description_polarity_term(\n    DeterminationProcessErrorDescription,\n    CannotBeCompletelyRuledOut\n  )\n  and error_possibility_reason(DeterminationProcessErrorPossibility, Internal)\n  and error_possibility_reason(DeterminationProcessErrorPossibility, External)\n  and not completely_ruled_out(DeterminationProcessErrorPossibility)" .
ex:ASSERT_identified_errors_correction_endeavor a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "112"^^xsd:integer ;
  a4:exprText "forall e: Error, ((error_in_determination_process(e, SolactiveDeterminationProcess)) and (identified(e))) implies (exists v: Endeavor, exists t: Period, (endeavor_by(v, Solactive)) and (endeavor_to_correct(v, e)) and (reasonable_period_for_error(e, t)) and (period_described_by(t, ReasonablePeriodOfTime)) and (endeavor_within(v, t)))" ;
  a4:sourceText "constraint identified_errors_correction_endeavor :\n  forall e: Error,\n    error_in_determination_process(e, SolactiveDeterminationProcess)\n    and identified(e)\n    implies\n      exists v: Endeavor, exists t: Period,\n        endeavor_by(v, Solactive)\n        and endeavor_to_correct(v, e)\n        and reasonable_period_for_error(e, t)\n        and period_described_by(t, ReasonablePeriodOfTime)\n        and endeavor_within(v, t)" .
ex:ASSERT_period_understanding_and_measures_depend_on_underlying a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "124"^^xsd:integer ;
  a4:exprText "exists u: Underlying, (dependency_understanding(PeriodAndMeasureUnderlyingDependency, ReasonablePeriodOfTimeUnderstanding)) and (dependency_general_measure(PeriodAndMeasureUnderlyingDependency, GeneralMeasuresToBeTaken)) and (dependency_underlying(PeriodAndMeasureUnderlyingDependency, u)) and (generally_applies(PeriodAndMeasureUnderlyingDependency))" ;
  a4:sourceText "fact period_understanding_and_measures_depend_on_underlying :\n  exists u: Underlying,\n      dependency_understanding(\n        PeriodAndMeasureUnderlyingDependency,\n        ReasonablePeriodOfTimeUnderstanding\n      )\n      and dependency_general_measure(\n        PeriodAndMeasureUnderlyingDependency,\n        GeneralMeasuresToBeTaken\n      )\n      and dependency_underlying(\n        PeriodAndMeasureUnderlyingDependency,\n        u\n      )\n      and generally_applies(PeriodAndMeasureUnderlyingDependency)" .
ex:ASSERT_correction_policy_specifies_period_understanding_and_measures a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "140"^^xsd:integer ;
  a4:exprText "(understanding_of(ReasonablePeriodOfTimeUnderstanding, ReasonablePeriodOfTime)) and (general_measure_to_be_taken(GeneralMeasuresToBeTaken)) and (specification_understanding(CorrectionPolicySpecification, ReasonablePeriodOfTimeUnderstanding)) and (specification_general_measure(CorrectionPolicySpecification, GeneralMeasuresToBeTaken)) and (specification_policy(CorrectionPolicySpecification, SolactiveCorrectionPolicy))" ;
  a4:sourceText "fact correction_policy_specifies_period_understanding_and_measures :\n  understanding_of(\n    ReasonablePeriodOfTimeUnderstanding,\n    ReasonablePeriodOfTime\n  )\n  and general_measure_to_be_taken(GeneralMeasuresToBeTaken)\n  and specification_understanding(\n    CorrectionPolicySpecification,\n    ReasonablePeriodOfTimeUnderstanding\n  )\n  and specification_general_measure(\n    CorrectionPolicySpecification,\n    GeneralMeasuresToBeTaken\n  )\n  and specification_policy(CorrectionPolicySpecification, SolactiveCorrectionPolicy)" .
ex:ASSERT_correction_policy_reference a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "156"^^xsd:integer ;
  a4:exprText "(incorporated_by_reference_into(SolactiveCorrectionPolicy, ThisGuideline)) and (available_on(SolactiveCorrectionPolicy, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive))" ;
  a4:sourceText "fact correction_policy_reference :\n  incorporated_by_reference_into(SolactiveCorrectionPolicy, ThisGuideline)\n  and available_on(SolactiveCorrectionPolicy, SolactiveWebsite)\n  and website_of(SolactiveWebsite, Solactive)" .
