ex:PriceReturnIndexVersion a ex:section_4_1_index .
ex:NTRIndexVersion a ex:section_4_1_index .
ex:GTRIndexVersion a ex:section_4_1_index .
ex:AdjustedReturnVersion a ex:section_4_1_index .
ex:SOLTCA50 a ex:section_4_1_index .
ex:PriceReturnIndexVersion ex:index_type ex:PriceReturn .
ex:NTRIndexVersion ex:index_type ex:NetTotalReturn .
ex:GTRIndexVersion ex:index_type ex:GrossTotalReturn .
ex:AdjustedReturnVersion ex:index_type ex:AdjustedReturnIndex .
ex:SOLTCA50 ex:index_type ex:AdjustedReturnIndex .
ex:EquityIndexMethodology ex:available_on ex:SolactiveWebsite .
ex:EquityIndexMethodology a ex:incorporated_by_reference .
ex:StandardIndexFormula ex:formula_in_methodology ex:EquityIndexMethodology .
ex:StandardIndexFormula a ex:standard_index_formula .
ex:AdjustedReturnFormula ex:formula_in_methodology ex:EquityIndexMethodology .
ex:AdjustedReturnFormula a ex:adjusted_return_formula .
ex:ASSERT_equity_index_methodology_reference a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(available_on(EquityIndexMethodology, SolactiveWebsite)) and (incorporated_by_reference(EquityIndexMethodology)) and (formula_in_methodology(StandardIndexFormula, EquityIndexMethodology)) and (standard_index_formula(StandardIndexFormula)) and (formula_in_methodology(AdjustedReturnFormula, EquityIndexMethodology)) and (adjusted_return_formula(AdjustedReturnFormula)) and (part_of_document(EquityIndexMethodologySection1_2, EquityIndexMethodology)) and (document_part_locator(EquityIndexMethodologySection1_2, EquityIndexMethodologySection1_2Locator)) and (detailed_description_found_in(mechanics(StandardIndexFormula), EquityIndexMethodologySection1_2))" .
ex:ASSERT_calculation_performed_according_to_equity_index_methodology a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall i: Index, (section_4_1_index(i)) implies (calculated_according_to(i, EquityIndexMethodology))" .
ex:ASSERT_standard_index_formula_basis a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall i: Index, forall d: CalculationDay, forall c: IndexComponent, ((section_4_1_index(i)) and (index_component_of(i, d, c))) implies ((formula_applies_to_index(StandardIndexFormula, i)) and (formula_level_change_based_on_price_change(StandardIndexFormula, i, d, c, component_price_change(c, d))) and (formula_level_change_takes_weight(StandardIndexFormula, i, d, c, component_weight(i, d, c))) and ((not ((quoted_currency(component_price(c, d))) = (index_currency(i)))) implies (formula_level_change_takes_currency_conversion(StandardIndexFormula, i, d, c, currency_conversion(i, d, c)))))" .
ex:ASSERT_distributions_reinvested_back_at_opening_of_effective_ex_date a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall p: Payment, forall dist: Distribution, forall c: IndexComponent, ((payment_of(p, dist)) and (pays_distribution(c, dist))) implies (((ex_date(p)) = (effective_date(p))) and (reinvested_back_into(dist, c, opening(effective_date(p)))))" .
ex:AdjustedReturnVersion ex:underlying_index_of ex:NTRIndexVersion .
ex:ASSERT_adjusted_return_version_decrement_from_ntr a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "((underlying_index_of(AdjustedReturnVersion)) = (NTRIndexVersion)) and ((percent_per_annum(decrement_of(AdjustedReturnVersion))) = (5%)) and (deducted_from(decrement_of(AdjustedReturnVersion), NTRIndexVersion)) and (decrement_applied_on_each_index_calculation_day(decrement_of(AdjustedReturnVersion))) and (applied_in_compliance_with(decrement_of(AdjustedReturnVersion), EquityIndexMethodology))" .
ex:AdjustedReturnFormula ex:formula_applies_to_index ex:SOLTCA50 .
ex:SOLTCA50 ex:underlying_index_of ex:GTRIndexVersion .
ex:ASSERT_soltca50_decrement_from_gtr a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(formula_applies_to_index(AdjustedReturnFormula, SOLTCA50)) and ((underlying_index_of(SOLTCA50)) = (GTRIndexVersion)) and ((decrement_of(SOLTCA50)) = (synthetic_dividend_of(SOLTCA50))) and ((index_points_per_annum(synthetic_dividend_of(SOLTCA50))) = (50)) and (deducted_from(decrement_of(SOLTCA50), GTRIndexVersion)) and (decrement_applied_on_each_index_calculation_day(decrement_of(SOLTCA50)))" .
ex:ASSERT_calendar_day_count_for_adjusted_return_formula a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall t: CalculationDay, forall t_prev: CalculationDay, (previous_calculation_day_of(t_prev, t)) implies ((includes_day(number_of_calendar_days_between(t, t_prev), t)) and (excludes_day(number_of_calendar_days_between(t, t_prev), t_prev)))" .
ex:ASSERT_soltca50_adjusted_return_index_formula a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall t: CalculationDay, forall t_prev: CalculationDay, (previous_calculation_day_of(t_prev, t)) implies ((index_level(SOLTCA50, t)) = ((((index_level(SOLTCA50, t_prev)) * (index_level(underlying_index_of(SOLTCA50), t))) / (index_level(underlying_index_of(SOLTCA50), t_prev))) - (((index_points_per_annum(synthetic_dividend_of(SOLTCA50))) * (number_of_calendar_days_between(t, t_prev))) / (360))))" .
