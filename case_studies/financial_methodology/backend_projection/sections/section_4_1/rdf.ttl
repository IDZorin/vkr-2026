ex:ASSERT_section_4_1_index_scope a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "88"^^xsd:integer ;
  a4:exprText "(section_4_1_index(PriceReturnIndexVersion)) and (section_4_1_index(NTRIndexVersion)) and (section_4_1_index(GTRIndexVersion)) and (section_4_1_index(AdjustedReturnVersion)) and (section_4_1_index(SOLTCA50))" ;
  a4:sourceText "fact section_4_1_index_scope :\n  section_4_1_index(PriceReturnIndexVersion)\n  and section_4_1_index(NTRIndexVersion)\n  and section_4_1_index(GTRIndexVersion)\n  and section_4_1_index(AdjustedReturnVersion)\n  and section_4_1_index(SOLTCA50)" .
ex:ASSERT_index_calculated_as_return_forms a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "95"^^xsd:integer ;
  a4:exprText "((index_type(PriceReturnIndexVersion)) = (PriceReturn)) and ((index_type(NTRIndexVersion)) = (NetTotalReturn)) and ((index_type(GTRIndexVersion)) = (GrossTotalReturn)) and ((index_type(AdjustedReturnVersion)) = (AdjustedReturnIndex)) and ((index_type(SOLTCA50)) = (AdjustedReturnIndex))" ;
  a4:sourceText "fact index_calculated_as_return_forms :\n  index_type(PriceReturnIndexVersion) = PriceReturn\n  and index_type(NTRIndexVersion) = NetTotalReturn\n  and index_type(GTRIndexVersion) = GrossTotalReturn\n  and index_type(AdjustedReturnVersion) = AdjustedReturnIndex\n  and index_type(SOLTCA50) = AdjustedReturnIndex" .
ex:ASSERT_equity_index_methodology_reference a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "102"^^xsd:integer ;
  a4:exprText "(available_on(EquityIndexMethodology, SolactiveWebsite)) and (incorporated_by_reference(EquityIndexMethodology)) and (formula_in_methodology(StandardIndexFormula, EquityIndexMethodology)) and (standard_index_formula(StandardIndexFormula)) and (formula_in_methodology(AdjustedReturnFormula, EquityIndexMethodology)) and (adjusted_return_formula(AdjustedReturnFormula)) and (part_of_document(EquityIndexMethodologySection1_2, EquityIndexMethodology)) and (document_part_locator(EquityIndexMethodologySection1_2, EquityIndexMethodologySection1_2Locator)) and (detailed_description_found_in(mechanics(StandardIndexFormula), EquityIndexMethodologySection1_2))" ;
  a4:sourceText "fact equity_index_methodology_reference :\n  available_on(EquityIndexMethodology, SolactiveWebsite)\n  and incorporated_by_reference(EquityIndexMethodology)\n  and formula_in_methodology(StandardIndexFormula, EquityIndexMethodology)\n  and standard_index_formula(StandardIndexFormula)\n  and formula_in_methodology(AdjustedReturnFormula, EquityIndexMethodology)\n  and adjusted_return_formula(AdjustedReturnFormula)\n  and part_of_document(EquityIndexMethodologySection1_2, EquityIndexMethodology)\n  and document_part_locator(EquityIndexMethodologySection1_2, EquityIndexMethodologySection1_2Locator)\n  and detailed_description_found_in(mechanics(StandardIndexFormula), EquityIndexMethodologySection1_2)" .
ex:ASSERT_calculation_performed_according_to_equity_index_methodology a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "113"^^xsd:integer ;
  a4:exprText "forall i: Index, (section_4_1_index(i)) implies (calculated_according_to(i, EquityIndexMethodology))" ;
  a4:sourceText "fact calculation_performed_according_to_equity_index_methodology :\n  forall i: Index,\n    section_4_1_index(i)\n    implies calculated_according_to(i, EquityIndexMethodology)" .
ex:ASSERT_standard_index_formula_basis a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "118"^^xsd:integer ;
  a4:exprText "forall i: Index, forall d: CalculationDay, forall c: IndexComponent, ((section_4_1_index(i)) and (index_component_of(i, d, c))) implies ((formula_applies_to_index(StandardIndexFormula, i)) and (formula_level_change_based_on_price_change(StandardIndexFormula, i, d, c, component_price_change(c, d))) and (formula_level_change_takes_weight(StandardIndexFormula, i, d, c, component_weight(i, d, c))) and ((not ((quoted_currency(component_price(c, d))) = (index_currency(i)))) implies (formula_level_change_takes_currency_conversion(StandardIndexFormula, i, d, c, currency_conversion(i, d, c)))))" ;
  a4:sourceText "fact standard_index_formula_basis :\n  forall i: Index, forall d: CalculationDay, forall c: IndexComponent,\n    section_4_1_index(i)\n    and index_component_of(i, d, c)\n    implies\n      formula_applies_to_index(StandardIndexFormula, i)\n      and formula_level_change_based_on_price_change(StandardIndexFormula, i, d, c, component_price_change(c, d))\n      and formula_level_change_takes_weight(StandardIndexFormula, i, d, c, component_weight(i, d, c))\n      and (\n        not (quoted_currency(component_price(c, d)) = index_currency(i))\n        implies formula_level_change_takes_currency_conversion(StandardIndexFormula, i, d, c, currency_conversion(i, d, c))\n      )" .
ex:ASSERT_distributions_reinvested_back_at_opening_of_effective_ex_date a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "131"^^xsd:integer ;
  a4:exprText "forall p: Payment, forall dist: Distribution, forall c: IndexComponent, ((payment_of(p, dist)) and (pays_distribution(c, dist))) implies (((ex_date(p)) = (effective_date(p))) and (reinvested_back_into(dist, c, opening(effective_date(p)))))" ;
  a4:sourceText "constraint distributions_reinvested_back_at_opening_of_effective_ex_date :\n  forall p: Payment, forall dist: Distribution, forall c: IndexComponent,\n    payment_of(p, dist)\n    and pays_distribution(c, dist)\n    implies\n      ex_date(p) = effective_date(p)\n      and reinvested_back_into(dist, c, opening(effective_date(p)))" .
ex:ASSERT_adjusted_return_version_decrement_from_ntr a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "139"^^xsd:integer ;
  a4:exprText "((underlying_index_of(AdjustedReturnVersion)) = (NTRIndexVersion)) and ((percent_per_annum(decrement_of(AdjustedReturnVersion))) = (5%)) and (deducted_from(decrement_of(AdjustedReturnVersion), NTRIndexVersion)) and (decrement_applied_on_each_index_calculation_day(decrement_of(AdjustedReturnVersion))) and (applied_in_compliance_with(decrement_of(AdjustedReturnVersion), EquityIndexMethodology))" ;
  a4:sourceText "fact adjusted_return_version_decrement_from_ntr :\n  underlying_index_of(AdjustedReturnVersion) = NTRIndexVersion\n  and percent_per_annum(decrement_of(AdjustedReturnVersion)) = 5%\n  and deducted_from(decrement_of(AdjustedReturnVersion), NTRIndexVersion)\n  and decrement_applied_on_each_index_calculation_day(decrement_of(AdjustedReturnVersion))\n  and applied_in_compliance_with(decrement_of(AdjustedReturnVersion), EquityIndexMethodology)" .
ex:ASSERT_soltca50_decrement_from_gtr a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "146"^^xsd:integer ;
  a4:exprText "(formula_applies_to_index(AdjustedReturnFormula, SOLTCA50)) and ((underlying_index_of(SOLTCA50)) = (GTRIndexVersion)) and ((decrement_of(SOLTCA50)) = (synthetic_dividend_of(SOLTCA50))) and ((index_points_per_annum(synthetic_dividend_of(SOLTCA50))) = (50)) and (deducted_from(decrement_of(SOLTCA50), GTRIndexVersion)) and (decrement_applied_on_each_index_calculation_day(decrement_of(SOLTCA50)))" ;
  a4:sourceText "fact soltca50_decrement_from_gtr :\n  formula_applies_to_index(AdjustedReturnFormula, SOLTCA50)\n  and underlying_index_of(SOLTCA50) = GTRIndexVersion\n  and decrement_of(SOLTCA50) = synthetic_dividend_of(SOLTCA50)\n  and index_points_per_annum(synthetic_dividend_of(SOLTCA50)) = 50\n  and deducted_from(decrement_of(SOLTCA50), GTRIndexVersion)\n  and decrement_applied_on_each_index_calculation_day(decrement_of(SOLTCA50))" .
ex:ASSERT_calendar_day_count_for_adjusted_return_formula a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "154"^^xsd:integer ;
  a4:exprText "forall t: CalculationDay, forall t_prev: CalculationDay, (previous_calculation_day_of(t_prev, t)) implies ((includes_day(number_of_calendar_days_between(t, t_prev), t)) and (excludes_day(number_of_calendar_days_between(t, t_prev), t_prev)))" ;
  a4:sourceText "fact calendar_day_count_for_adjusted_return_formula :\n  forall t: CalculationDay, forall t_prev: CalculationDay,\n    previous_calculation_day_of(t_prev, t)\n    implies\n      includes_day(number_of_calendar_days_between(t, t_prev), t)\n      and excludes_day(number_of_calendar_days_between(t, t_prev), t_prev)" .
ex:ASSERT_soltca50_adjusted_return_index_formula a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "161"^^xsd:integer ;
  a4:exprText "forall t: CalculationDay, forall t_prev: CalculationDay, (previous_calculation_day_of(t_prev, t)) implies ((index_level(SOLTCA50, t)) = ((((index_level(SOLTCA50, t_prev)) * (index_level(underlying_index_of(SOLTCA50), t))) / (index_level(underlying_index_of(SOLTCA50), t_prev))) - (((index_points_per_annum(synthetic_dividend_of(SOLTCA50))) * (number_of_calendar_days_between(t, t_prev))) / (360))))" ;
  a4:sourceText "constraint soltca50_adjusted_return_index_formula :\n  forall t: CalculationDay, forall t_prev: CalculationDay,\n    previous_calculation_day_of(t_prev, t)\n    implies\n      index_level(SOLTCA50, t)\n      =\n      index_level(SOLTCA50, t_prev)\n      * index_level(underlying_index_of(SOLTCA50), t)\n      / index_level(underlying_index_of(SOLTCA50), t_prev)\n      - index_points_per_annum(synthetic_dividend_of(SOLTCA50))\n        * number_of_calendar_days_between(t, t_prev)\n        / 360" .
