ex:ASSERT_news_section_location a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "39"^^xsd:integer ;
  a4:exprText "(document_part_url(NewsSection, HttpsWwwSolactiveComNewsAnnouncements)) and (section_of_website(NewsSection, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive))" ;
  a4:sourceText "fact news_section_location :\n  document_part_url(NewsSection, HttpsWwwSolactiveComNewsAnnouncements)\n  and section_of_website(NewsSection, SolactiveWebsite)\n  and website_of(SolactiveWebsite, Solactive)" .
ex:ASSERT_solactive_policies a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "44"^^xsd:integer ;
  a4:exprText "policy_of(SolactivePolicies, Solactive)" ;
  a4:sourceText "fact solactive_policies :\n  policy_of(SolactivePolicies, Solactive)" .
ex:ASSERT_termination_and_announcement_at_zero_or_below a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "47"^^xsd:integer ;
  a4:exprText "forall c: IndexCalculation, forall i: AdjustedReturnIndex, ((calculated_index(c, i)) and ((calculated_level(c)) <= (0))) implies (exists t: IndexTermination, exists a: TerminationAnnouncement, (terminates_index(t, i)) and (termination_calculation(t, c)) and (announces_termination(a, t)) and (announcement_by(a, Solactive)) and (announced_on(a, SolactiveWebsite)) and (announcement_under_section(a, NewsSection)) and (after(a, c)) and (announcement_timing_described_by(a, AsSoonAsReasonablyPossible)))" ;
  a4:sourceText "constraint termination_and_announcement_at_zero_or_below :\n  forall c: IndexCalculation, forall i: AdjustedReturnIndex,\n    calculated_index(c, i)\n    and calculated_level(c) <= 0\n    implies\n      exists t: IndexTermination, exists a: TerminationAnnouncement,\n        terminates_index(t, i)\n        and termination_calculation(t, c)\n        and announces_termination(a, t)\n        and announcement_by(a, Solactive)\n        and announced_on(a, SolactiveWebsite)\n        and announcement_under_section(a, NewsSection)\n        and after(a, c)\n        and announcement_timing_described_by(a, AsSoonAsReasonablyPossible)" .
ex:ASSERT_other_reason_termination_in_accordance_with_solactive_policies a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "71"^^xsd:integer ;
  a4:exprText "forall t: IndexTermination, forall i: Index, ((terminates_index(t, i)) and (termination_reason_qualified_by(t, OtherReasons))) implies (termination_in_accordance_with_policy(t, SolactivePolicies))" ;
  a4:sourceText "constraint other_reason_termination_in_accordance_with_solactive_policies :\n  forall t: IndexTermination, forall i: Index,\n    terminates_index(t, i)\n    and termination_reason_qualified_by(t, OtherReasons)\n    implies\n      termination_in_accordance_with_policy(t, SolactivePolicies)" .
