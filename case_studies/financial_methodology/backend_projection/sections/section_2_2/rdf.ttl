ex:ASSERT_eligible_iff_index_universe_for_component_requirements a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "37"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (eligible(d, s)) iff (index_universe(d, s))" ;
  a4:sourceText "constraint eligible_iff_index_universe_for_component_requirements :\n  forall d: SelectionDay, forall s: Security,\n    eligible(d, s) iff index_universe(d, s)" .
ex:ASSERT_security_classified_into_one_of_two_regions a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "41"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (eligible(d, s)) implies (((region(d, s)) = (Americas)) or ((region(d, s)) = (EuropeRegion)))" ;
  a4:sourceText "constraint security_classified_into_one_of_two_regions :\n  forall d: SelectionDay, forall s: Security,\n    eligible(d, s) implies\n      (region(d, s) = Americas or region(d, s) = EuropeRegion)" .
ex:ASSERT_americas_country_assignment_classification a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "46"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (eligible(d, s)) implies (((region(d, s)) = (Americas)) iff (((gbs_country_assignment(d, s)) = (Canada)) or ((gbs_country_assignment(d, s)) = (UnitedStates))))" ;
  a4:sourceText "constraint americas_country_assignment_classification :\n  forall d: SelectionDay, forall s: Security,\n    eligible(d, s) implies\n      (region(d, s) = Americas iff\n        (gbs_country_assignment(d, s) = Canada or gbs_country_assignment(d, s) = UnitedStates))" .
ex:ASSERT_europe_country_assignment_classification a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "52"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (eligible(d, s)) implies (((region(d, s)) = (EuropeRegion)) iff ((gbs_country_assignment(d, s)) = (Europe)))" ;
  a4:sourceText "constraint europe_country_assignment_classification :\n  forall d: SelectionDay, forall s: Security,\n    eligible(d, s) implies\n      (region(d, s) = EuropeRegion iff gbs_country_assignment(d, s) = Europe)" .
ex:ASSERT_descending_order_by_free_float_market_capizatlization a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "57"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall r: Region, forall s1: Security, forall s2: Security, ((eligible(d, s1)) and (eligible(d, s2)) and ((region(d, s1)) = (r)) and ((region(d, s2)) = (r)) and ((free_float_market_capizatlization(d, s1)) > (free_float_market_capizatlization(d, s2)))) implies ((rank(d, r, s1)) < (rank(d, r, s2)))" ;
  a4:sourceText "constraint descending_order_by_free_float_market_capizatlization :\n  forall d: SelectionDay, forall r: Region, forall s1: Security, forall s2: Security,\n    eligible(d, s1)\n    and eligible(d, s2)\n    and region(d, s1) = r\n    and region(d, s2) = r\n    and free_float_market_capizatlization(d, s1) > free_float_market_capizatlization(d, s2)\n    implies rank(d, r, s1) < rank(d, r, s2)" .
ex:ASSERT_selected_top_20_for_each_region a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "66"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (selected_for_index_inclusion(d, s)) iff ((eligible(d, s)) and ((rank(d, region(d, s), s)) <= (20)))" ;
  a4:sourceText "constraint selected_top_20_for_each_region :\n  forall d: SelectionDay, forall s: Security,\n    selected_for_index_inclusion(d, s)\n    iff\n      eligible(d, s)\n      and rank(d, region(d, s), s) <= 20" .
ex:ASSERT_index_components_selected_for_index_inclusion a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "73"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (index_component(d, s)) iff (selected_for_index_inclusion(d, s))" ;
  a4:sourceText "constraint index_components_selected_for_index_inclusion :\n  forall d: SelectionDay, forall s: Security,\n    index_component(d, s) iff selected_for_index_inclusion(d, s)" .
ex:ASSERT_initial_composition_determined_by_index_component_requirements a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "77"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (initial_composition(d, s)) iff (selected_for_index_inclusion(d, s))" ;
  a4:sourceText "constraint initial_composition_determined_by_index_component_requirements :\n  forall d: SelectionDay, forall s: Security,\n    initial_composition(d, s) iff selected_for_index_inclusion(d, s)" .
ex:ASSERT_ordinary_rebalance_selection_determined_by_index_component_requirements a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "81"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, (ordinary_rebalance_selection(d, s)) iff (selected_for_index_inclusion(d, s))" ;
  a4:sourceText "constraint ordinary_rebalance_selection_determined_by_index_component_requirements :\n  forall d: SelectionDay, forall s: Security,\n    ordinary_rebalance_selection(d, s) iff selected_for_index_inclusion(d, s)" .
ex:ASSERT_less_than_20_per_region_less_than_40_index_components a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "85"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, (exists r: Region, (<count>) < (20)) implies ((<count>) < (40))" ;
  a4:sourceText "constraint less_than_20_per_region_less_than_40_index_components :\n  forall d: SelectionDay,\n    (exists r: Region,\n      count(s in Security where eligible(d, s) and region(d, s) = r) < 20)\n    implies\n      count(s in Security where index_component(d, s)) < 40" .
ex:ASSERT_selection_fully_rule_based a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "92"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, fully_rule_based(selection_of_index_components(d))" ;
  a4:sourceText "fact selection_fully_rule_based :\n  forall d: SelectionDay,\n    fully_rule_based(selection_of_index_components(d))" .
