ex:Rank rdfs:subClassOf ex:Nat .
ex:IndexAdministrator a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:IndexAdministrator rdfs:subClassOf ex:Organization .
ex:SelectionOfIndexComponents a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:DiscretionaryDecision a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .

