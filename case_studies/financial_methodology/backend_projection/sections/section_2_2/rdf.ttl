  a4:declKind "subtype" .
ex:SelectionDay rdfs:subClassOf ex:Day .
ex:Security a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:Security rdfs:subClassOf ex:FinancialInstrument .
ex:Region a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:CountryAssignment a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:FreeFloatMarketCapizatlization a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:FreeFloatMarketCapizatlization rdfs:subClassOf ex:MonetaryAmount .
ex:Rank a rdfs:Class, a4:Sort ;
