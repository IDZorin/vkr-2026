ex:ASSERT_ice_alias a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "76"^^xsd:integer ;
  a4:exprText "(ICE) = (IntercontinentalExchange)" ;
  a4:sourceText "fact ice_alias :\n  ICE = IntercontinentalExchange" .
ex:ASSERT_intraday_calculation_window a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "79"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, (intraday_calculation_time(d, t)) implies ((calculation_mode(t, IntradayCalculation)) and (calculation_time_from_to(t, Time1_00AMCET, Time10_50PMCET, CET)) and (intraday_level_calculated_on(intraday_level(TheIndex, d, t), d, t)))" ;
  a4:sourceText "fact intraday_calculation_window :\n  forall d: CalculationDay, forall t: CalculationTime,\n    intraday_calculation_time(d, t)\n    implies\n      calculation_mode(t, IntradayCalculation)\n      and calculation_time_from_to(t, Time1_00AMCET, Time10_50PMCET, CET)\n      and intraday_level_calculated_on(intraday_level(TheIndex, d, t), d, t)" .
ex:ASSERT_intraday_level_uses_exchange_trading_prices a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "87"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c))) implies (exists e: Exchange, (listed_on_exchanges(d, c, e)) and (price_on_exchange(intraday_source_price(c, d, t), e)) and (price_used_for_level(intraday_level(TheIndex, d, t), c, intraday_calculation_price(c, d, t))))" ;
  a4:sourceText "constraint intraday_level_uses_exchange_trading_prices :\n  forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent,\n    intraday_calculation_time(d, t)\n    and index_component(d, c)\n    implies\n      exists e: Exchange,\n        listed_on_exchanges(d, c, e)\n        and price_on_exchange(intraday_source_price(c, d, t), e)\n        and price_used_for_level(\n          intraday_level(TheIndex, d, t),\n          c,\n          intraday_calculation_price(c, d, t)\n        )" .
ex:ASSERT_current_trading_price_used_when_available a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "101"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c)) and (current_trading_price_available(c, d, t))) implies ((intraday_source_price(c, d, t)) = (current_trading_price(c, d, t)))" ;
  a4:sourceText "constraint current_trading_price_used_when_available :\n  forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent,\n    intraday_calculation_time(d, t)\n    and index_component(d, c)\n    and current_trading_price_available(c, d, t)\n    implies\n      intraday_source_price(c, d, t) = current_trading_price(c, d, t)" .
ex:ASSERT_no_current_trading_price_fallback a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "109"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c)) and (not (current_trading_price_available(c, d, t)))) implies ((intraday_source_price(c, d, t)) = (later_of(most_recent_closing_price(c, d, t), last_available_trading_price(c, preceding_trading_day(d)))))" ;
  a4:sourceText "constraint no_current_trading_price_fallback :\n  forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent,\n    intraday_calculation_time(d, t)\n    and index_component(d, c)\n    and not current_trading_price_available(c, d, t)\n    implies\n      intraday_source_price(c, d, t) =\n        later_of(\n          most_recent_closing_price(c, d, t),\n          last_available_trading_price(c, preceding_trading_day(d))\n        )" .
ex:ASSERT_fallback_price_candidates_are_temporally_comparable a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "121"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c))) implies ((price_selection_order(most_recent_closing_price(c, d, t), last_available_trading_price(c, preceding_trading_day(d)))) or (price_selection_order(last_available_trading_price(c, preceding_trading_day(d)), most_recent_closing_price(c, d, t))))" ;
  a4:sourceText "constraint fallback_price_candidates_are_temporally_comparable :\n  forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent,\n    intraday_calculation_time(d, t)\n    and index_component(d, c)\n    implies\n      price_selection_order(\n        most_recent_closing_price(c, d, t),\n        last_available_trading_price(c, preceding_trading_day(d))\n      )\n      or\n      price_selection_order(\n        last_available_trading_price(c, preceding_trading_day(d)),\n        most_recent_closing_price(c, d, t)\n      )" .
ex:ASSERT_later_of_returns_a_candidate a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "136"^^xsd:integer ;
  a4:exprText "forall p1: Price, forall p2: Price, ((later_of(p1, p2)) = (p1)) or ((later_of(p1, p2)) = (p2))" ;
  a4:sourceText "constraint later_of_returns_a_candidate :\n  forall p1: Price, forall p2: Price,\n    later_of(p1, p2) = p1\n    or\n    later_of(p1, p2) = p2" .
ex:ASSERT_later_of_selects_temporally_later_candidate a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "142"^^xsd:integer ;
  a4:exprText "forall p1: Price, forall p2: Price, ((price_selection_order(p1, p2)) implies ((later_of(p1, p2)) = (p1))) and ((price_selection_order(p2, p1)) implies ((later_of(p1, p2)) = (p2)))" ;
  a4:sourceText "constraint later_of_selects_temporally_later_candidate :\n  forall p1: Price, forall p2: Price,\n    (price_selection_order(p1, p2) implies later_of(p1, p2) = p1)\n    and\n    (price_selection_order(p2, p1) implies later_of(p1, p2) = p2)" .
ex:ASSERT_intraday_price_kept_when_listed_in_index_currency a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "148"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c)) and ((listed_currency(d, c)) = (index_currency(TheIndex)))) implies ((intraday_calculation_price(c, d, t)) = (intraday_source_price(c, d, t)))" ;
  a4:sourceText "constraint intraday_price_kept_when_listed_in_index_currency :\n  forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent,\n    intraday_calculation_time(d, t)\n    and index_component(d, c)\n    and listed_currency(d, c) = index_currency(TheIndex)\n    implies\n      intraday_calculation_price(c, d, t) = intraday_source_price(c, d, t)" .
ex:ASSERT_intraday_price_converted_when_not_listed_in_index_currency a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "156"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent, ((intraday_calculation_time(d, t)) and (index_component(d, c)) and (not ((listed_currency(d, c)) = (index_currency(TheIndex))))) implies (converted_from_using(intraday_calculation_price(c, d, t), intraday_source_price(c, d, t), current_ice_spot_foreign_exchange_rate(listed_currency(d, c), index_currency(TheIndex), d, t)))" ;
  a4:sourceText "constraint intraday_price_converted_when_not_listed_in_index_currency :\n  forall d: CalculationDay, forall t: CalculationTime, forall c: IndexComponent,\n    intraday_calculation_time(d, t)\n    and index_component(d, c)\n    and listed_currency(d, c) != index_currency(TheIndex)\n    implies\n      converted_from_using(\n        intraday_calculation_price(c, d, t),\n        intraday_source_price(c, d, t),\n        current_ice_spot_foreign_exchange_rate(\n          listed_currency(d, c),\n          index_currency(TheIndex),\n          d,\n          t\n        )\n      )" .
ex:ASSERT_current_ice_spot_foreign_exchange_rate_source a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "173"^^xsd:integer ;
  a4:exprText "forall src: Currency, forall tgt: Currency, forall d: CalculationDay, forall t: CalculationTime, foreign_exchange_rate_provider(current_ice_spot_foreign_exchange_rate(src, tgt, d, t), IntercontinentalExchange)" ;
  a4:sourceText "fact current_ice_spot_foreign_exchange_rate_source :\n  forall src: Currency, forall tgt: Currency,\n  forall d: CalculationDay, forall t: CalculationTime,\n    foreign_exchange_rate_provider(\n      current_ice_spot_foreign_exchange_rate(src, tgt, d, t),\n      IntercontinentalExchange\n    )" .
ex:ASSERT_closing_level_calculated_each_calculation_day a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "181"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, closing_level_calculated_on(closing_level(TheIndex, d), d)" ;
  a4:sourceText "fact closing_level_calculated_each_calculation_day :\n  forall d: CalculationDay,\n    closing_level_calculated_on(closing_level(TheIndex, d), d)" .
ex:ASSERT_closing_level_based_on_closing_prices a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "185"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall c: IndexComponent, (index_component(d, c)) implies (exists e: Exchange, (listed_on_exchanges(d, c, e)) and (price_on_exchange(closing_price(c, d), e)) and (price_used_for_level(closing_level(TheIndex, d), c, closing_calculation_price(c, d))))" ;
  a4:sourceText "constraint closing_level_based_on_closing_prices :\n  forall d: CalculationDay, forall c: IndexComponent,\n    index_component(d, c)\n    implies\n      exists e: Exchange,\n        listed_on_exchanges(d, c, e)\n        and price_on_exchange(closing_price(c, d), e)\n        and price_used_for_level(\n          closing_level(TheIndex, d),\n          c,\n          closing_calculation_price(c, d)\n        )" .
ex:ASSERT_closing_price_kept_when_listed_in_index_currency a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "198"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall c: IndexComponent, ((index_component(d, c)) and ((listed_currency(d, c)) = (index_currency(TheIndex)))) implies ((closing_calculation_price(c, d)) = (closing_price(c, d)))" ;
  a4:sourceText "constraint closing_price_kept_when_listed_in_index_currency :\n  forall d: CalculationDay, forall c: IndexComponent,\n    index_component(d, c)\n    and listed_currency(d, c) = index_currency(TheIndex)\n    implies\n      closing_calculation_price(c, d) = closing_price(c, d)" .
ex:ASSERT_closing_price_converted_with_available_wm_fixing a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "205"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall c: IndexComponent, ((index_component(d, c)) and (not ((listed_currency(d, c)) = (index_currency(TheIndex)))) and (wm_fixing_4pm_london_available(listed_currency(d, c), index_currency(TheIndex), d))) implies (((wm_fixing_for_closing_level(listed_currency(d, c), index_currency(TheIndex), d)) = (wm_fixing_4pm_london(listed_currency(d, c), index_currency(TheIndex), d))) and (converted_from_using(closing_calculation_price(c, d), closing_price(c, d), wm_fixing_for_closing_level(listed_currency(d, c), index_currency(TheIndex), d))))" ;
  a4:sourceText "constraint closing_price_converted_with_available_wm_fixing :\n  forall d: CalculationDay, forall c: IndexComponent,\n    index_component(d, c)\n    and listed_currency(d, c) != index_currency(TheIndex)\n    and wm_fixing_4pm_london_available(\n      listed_currency(d, c),\n      index_currency(TheIndex),\n      d\n    )\n    implies\n      wm_fixing_for_closing_level(\n        listed_currency(d, c),\n        index_currency(TheIndex),\n        d\n      ) =\n        wm_fixing_4pm_london(\n          listed_currency(d, c),\n          index_currency(TheIndex),\n          d\n        )\n      and\n      converted_from_using(\n        closing_calculation_price(c, d),\n        closing_price(c, d),\n        wm_fixing_for_closing_level(\n          listed_currency(d, c),\n          index_currency(TheIndex),\n          d\n        )\n      )" .
ex:ASSERT_closing_price_converted_with_last_available_wm_fixing a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "236"^^xsd:integer ;
  a4:exprText "forall d: CalculationDay, forall c: IndexComponent, ((index_component(d, c)) and (not ((listed_currency(d, c)) = (index_currency(TheIndex)))) and (not (wm_fixing_4pm_london_available(listed_currency(d, c), index_currency(TheIndex), d)))) implies (((wm_fixing_for_closing_level(listed_currency(d, c), index_currency(TheIndex), d)) = (last_available_wm_fixing_4pm_london(listed_currency(d, c), index_currency(TheIndex), d))) and (converted_from_using(closing_calculation_price(c, d), closing_price(c, d), wm_fixing_for_closing_level(listed_currency(d, c), index_currency(TheIndex), d))))" ;
  a4:sourceText "constraint closing_price_converted_with_last_available_wm_fixing :\n  forall d: CalculationDay, forall c: IndexComponent,\n    index_component(d, c)\n    and listed_currency(d, c) != index_currency(TheIndex)\n    and not wm_fixing_4pm_london_available(\n      listed_currency(d, c),\n      index_currency(TheIndex),\n      d\n    )\n    implies\n      wm_fixing_for_closing_level(\n        listed_currency(d, c),\n        index_currency(TheIndex),\n        d\n      ) =\n        last_available_wm_fixing_4pm_london(\n          listed_currency(d, c),\n          index_currency(TheIndex),\n          d\n        )\n      and\n      converted_from_using(\n        closing_calculation_price(c, d),\n        closing_price(c, d),\n        wm_fixing_for_closing_level(\n          listed_currency(d, c),\n          index_currency(TheIndex),\n          d\n        )\n      )" .
ex:ASSERT_wm_fixing_4pm_london_quoted_by_reuters a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "267"^^xsd:integer ;
  a4:exprText "forall src: Currency, forall tgt: Currency, forall d: CalculationDay, (wm_fixing_quoted_by(wm_fixing_4pm_london(src, tgt, d), Reuters)) and (fixing_time(wm_fixing_4pm_london(src, tgt, d), Time04_00PMLondon, LondonTime))" ;
  a4:sourceText "fact wm_fixing_4pm_london_quoted_by_reuters :\n  forall src: Currency, forall tgt: Currency, forall d: CalculationDay,\n    wm_fixing_quoted_by(wm_fixing_4pm_london(src, tgt, d), Reuters)\n    and fixing_time(wm_fixing_4pm_london(src, tgt, d), Time04_00PMLondon, LondonTime)" .
ex:ASSERT_last_available_wm_fixing_4pm_london_quoted_by_reuters a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "272"^^xsd:integer ;
  a4:exprText "forall src: Currency, forall tgt: Currency, forall d: CalculationDay, (wm_fixing_quoted_by(last_available_wm_fixing_4pm_london(src, tgt, d), Reuters)) and (fixing_time(last_available_wm_fixing_4pm_london(src, tgt, d), Time04_00PMLondon, LondonTime))" ;
  a4:sourceText "fact last_available_wm_fixing_4pm_london_quoted_by_reuters :\n  forall src: Currency, forall tgt: Currency, forall d: CalculationDay,\n    wm_fixing_quoted_by(last_available_wm_fixing_4pm_london(src, tgt, d), Reuters)\n    and fixing_time(\n      last_available_wm_fixing_4pm_london(src, tgt, d),\n      Time04_00PMLondon,\n      LondonTime\n    )" .
