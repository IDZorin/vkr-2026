@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:section_3_2 a owl:Ontology .

ex:Index a owl:Class .
ex:Rebalance a owl:Class .
ex:ExtraordinaryRebalance a owl:Class .
ex:ExtraordinaryRebalance rdfs:subClassOf ex:Rebalance .

ex:TheIndex a ex:Index, owl:NamedIndividual .
ex:rebalance_of_index a owl:ObjectProperty ;
  rdfs:domain ex:Rebalance ;
  rdfs:range ex:Index .

ex:ASSERT_index_not_rebalanced_extraordinarily a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall r: ExtraordinaryRebalance, not (rebalance_of_index(r, TheIndex))" .
