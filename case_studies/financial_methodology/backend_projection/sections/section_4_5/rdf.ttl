ex:ASSERT_index_maintenance_scope a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "142"^^xsd:integer ;
  a4:exprText "(index_maintenance_of(IndexMaintenanceOfTheIndex, TheIndex)) and (calculation_of_index(CalculationOfTheIndex, TheIndex))" ;
  a4:sourceText "fact index_maintenance_scope :\n  index_maintenance_of(IndexMaintenanceOfTheIndex, TheIndex)\n  and calculation_of_index(CalculationOfTheIndex, TheIndex)" .
ex:ASSERT_equity_index_methodology_available_on_solactive_website a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "146"^^xsd:integer ;
  a4:exprText "(available_on(EquityIndexMethodology, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive))" ;
  a4:sourceText "fact equity_index_methodology_available_on_solactive_website :\n  available_on(EquityIndexMethodology, SolactiveWebsite)\n  and website_of(SolactiveWebsite, Solactive)" .
ex:ASSERT_corporate_action_treatment_methodology_aim a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "150"^^xsd:integer ;
  a4:exprText "(aims_at_creating(Solactive, EquityIndexMethodology)) and (aims_at_maintaining(Solactive, EquityIndexMethodology)) and (methodology_for_treatment_of_corporate_actions(EquityIndexMethodology)) and (methodology_quality(EquityIndexMethodology, Generic)) and (methodology_quality_described_by(EquityIndexMethodology, Generic, AsPossible)) and (methodology_quality(EquityIndexMethodology, Transparent)) and (methodology_quality_described_by(EquityIndexMethodology, Transparent, AsPossible)) and (in_line_with(EquityIndexMethodology, RegulatoryRequirements)) and (standard_procedures_in_methodology(CorporateActionStandardProcedures, EquityIndexMethodology))" ;
  a4:sourceText "fact corporate_action_treatment_methodology_aim :\n  aims_at_creating(Solactive, EquityIndexMethodology)\n  and aims_at_maintaining(Solactive, EquityIndexMethodology)\n  and methodology_for_treatment_of_corporate_actions(EquityIndexMethodology)\n  and methodology_quality(EquityIndexMethodology, Generic)\n  and methodology_quality_described_by(EquityIndexMethodology, Generic, AsPossible)\n  and methodology_quality(EquityIndexMethodology, Transparent)\n  and methodology_quality_described_by(EquityIndexMethodology, Transparent, AsPossible)\n  and in_line_with(EquityIndexMethodology, RegulatoryRequirements)\n  and standard_procedures_in_methodology(CorporateActionStandardProcedures, EquityIndexMethodology)" .
ex:ASSERT_relevant_corporate_action_list a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "161"^^xsd:integer ;
  a4:exprText "(non_conclusive(RelevantCorporateActionList)) and (list_item(RelevantCorporateActionList, CashDistributions)) and (considers_relevant_for_index_maintenance(Solactive, CashDistributions, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, CashDistributions)) and (list_item(RelevantCorporateActionList, StockDistributions)) and (considers_relevant_for_index_maintenance(Solactive, StockDistributions, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, StockDistributions)) and (list_item(RelevantCorporateActionList, StockDistributionsOfAnotherCompany)) and (considers_relevant_for_index_maintenance(Solactive, StockDistributionsOfAnotherCompany, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, StockDistributionsOfAnotherCompany)) and (list_item(RelevantCorporateActionList, ShareSplits)) and (considers_relevant_for_index_maintenance(Solactive, ShareSplits, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, ShareSplits)) and (list_item(RelevantCorporateActionList, ReverseSplits)) and (considers_relevant_for_index_maintenance(Solactive, ReverseSplits, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, ReverseSplits)) and (list_item(RelevantCorporateActionList, CapitalIncreases)) and (considers_relevant_for_index_maintenance(Solactive, CapitalIncreases, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, CapitalIncreases)) and (list_item(RelevantCorporateActionList, ShareRepurchases)) and (considers_relevant_for_index_maintenance(Solactive, ShareRepurchases, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, ShareRepurchases)) and (list_item(RelevantCorporateActionList, SpinOffs)) and (considers_relevant_for_index_maintenance(Solactive, SpinOffs, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, SpinOffs)) and (list_item(RelevantCorporateActionList, MergersAndAcquisitions)) and (considers_relevant_for_index_maintenance(Solactive, MergersAndAcquisitions, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, MergersAndAcquisitions)) and (list_item(RelevantCorporateActionList, Delistings)) and (considers_relevant_for_index_maintenance(Solactive, Delistings, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, Delistings)) and (list_item(RelevantCorporateActionList, Nationalization)) and (considers_relevant_for_index_maintenance(Solactive, Nationalization, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, Nationalization)) and (list_item(RelevantCorporateActionList, Insolvency)) and (considers_relevant_for_index_maintenance(Solactive, Insolvency, IndexMaintenanceOfTheIndex)) and (methodology_covers_corporate_action_kind(EquityIndexMethodology, Insolvency))" ;
  a4:sourceText "fact relevant_corporate_action_list :\n  non_conclusive(RelevantCorporateActionList)\n  and list_item(RelevantCorporateActionList, CashDistributions)\n  and considers_relevant_for_index_maintenance(Solactive, CashDistributions, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, CashDistributions)\n  and list_item(RelevantCorporateActionList, StockDistributions)\n  and considers_relevant_for_index_maintenance(Solactive, StockDistributions, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, StockDistributions)\n  and list_item(RelevantCorporateActionList, StockDistributionsOfAnotherCompany)\n  and considers_relevant_for_index_maintenance(Solactive, StockDistributionsOfAnotherCompany, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, StockDistributionsOfAnotherCompany)\n  and list_item(RelevantCorporateActionList, ShareSplits)\n  and considers_relevant_for_index_maintenance(Solactive, ShareSplits, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, ShareSplits)\n  and list_item(RelevantCorporateActionList, ReverseSplits)\n  and considers_relevant_for_index_maintenance(Solactive, ReverseSplits, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, ReverseSplits)\n  and list_item(RelevantCorporateActionList, CapitalIncreases)\n  and considers_relevant_for_index_maintenance(Solactive, CapitalIncreases, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, CapitalIncreases)\n  and list_item(RelevantCorporateActionList, ShareRepurchases)\n  and considers_relevant_for_index_maintenance(Solactive, ShareRepurchases, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, ShareRepurchases)\n  and list_item(RelevantCorporateActionList, SpinOffs)\n  and considers_relevant_for_index_maintenance(Solactive, SpinOffs, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, SpinOffs)\n  and list_item(RelevantCorporateActionList, MergersAndAcquisitions)\n  and considers_relevant_for_index_maintenance(Solactive, MergersAndAcquisitions, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, MergersAndAcquisitions)\n  and list_item(RelevantCorporateActionList, Delistings)\n  and considers_relevant_for_index_maintenance(Solactive, Delistings, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, Delistings)\n  and list_item(RelevantCorporateActionList, Nationalization)\n  and considers_relevant_for_index_maintenance(Solactive, Nationalization, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, Nationalization)\n  and list_item(RelevantCorporateActionList, Insolvency)\n  and considers_relevant_for_index_maintenance(Solactive, Insolvency, IndexMaintenanceOfTheIndex)\n  and methodology_covers_corporate_action_kind(EquityIndexMethodology, Insolvency)" .
ex:ASSERT_considered_corporate_actions_result_in_index_adjustment a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "200"^^xsd:integer ;
  a4:exprText "forall ca: IndexMaintenanceCorporateAction, (considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)) implies ((adjustment_to_index(index_adjustment(ca), TheIndex)) and (exists r1: RegularRebalanceDay, exists r2: RegularRebalanceDay, (adjustment_between_regular_rebalance_days(index_adjustment(ca), r1, r2)) and (not ((r1) = (r2)))))" ;
  a4:sourceText "constraint considered_corporate_actions_result_in_index_adjustment :\n  forall ca: IndexMaintenanceCorporateAction,\n    considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)\n    implies\n      adjustment_to_index(index_adjustment(ca), TheIndex)\n      and exists r1: RegularRebalanceDay, exists r2: RegularRebalanceDay,\n        adjustment_between_regular_rebalance_days(index_adjustment(ca), r1, r2)\n        and not (r1 = r2)" .
ex:ASSERT_considered_corporate_actions_have_material_impact a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "209"^^xsd:integer ;
  a4:exprText "forall ca: IndexMaintenanceCorporateAction, (considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)) implies (exists c: IndexComponent, exists attr: IndexComponentAttribute, (component_of_index(c, TheIndex)) and (material_impact_on(ca, c, attr)))" ;
  a4:sourceText "constraint considered_corporate_actions_have_material_impact :\n  forall ca: IndexMaintenanceCorporateAction,\n    considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)\n    implies\n      exists c: IndexComponent, exists attr: IndexComponentAttribute,\n        component_of_index(c, TheIndex)\n        and material_impact_on(ca, c, attr)" .
ex:ASSERT_corporate_action_implementation_period_and_price_effect a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "217"^^xsd:integer ;
  a4:exprText "forall ca: IndexMaintenanceCorporateAction, (considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)) implies ((implemented_from_to(ca, cum_day(ca), ex_day(ca))) and (adjustment_coincides_with_price_effect_occurrence(index_adjustment(ca), price_effect(ca))))" ;
  a4:sourceText "constraint corporate_action_implementation_period_and_price_effect :\n  forall ca: IndexMaintenanceCorporateAction,\n    considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)\n    implies\n      implemented_from_to(ca, cum_day(ca), ex_day(ca))\n      and adjustment_coincides_with_price_effect_occurrence(index_adjustment(ca), price_effect(ca))" .
ex:ASSERT_equity_index_methodology_material_for_covered_corporate_actions a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "224"^^xsd:integer ;
  a4:exprText "forall k: CorporateActionKind, (methodology_covers_corporate_action_kind(EquityIndexMethodology, k)) implies (exists d: BriefCorporateActionDefinition, exists v: IndexVariable, (methodology_contains_definition(EquityIndexMethodology, k, d)) and (methodology_specifies_relevant_adjustment_to_index_variable(EquityIndexMethodology, k, v)) and (index_variable_of(v, TheIndex)))" ;
  a4:sourceText "constraint equity_index_methodology_material_for_covered_corporate_actions :\n  forall k: CorporateActionKind,\n    methodology_covers_corporate_action_kind(EquityIndexMethodology, k)\n    implies\n      exists d: BriefCorporateActionDefinition, exists v: IndexVariable,\n        methodology_contains_definition(EquityIndexMethodology, k, d)\n        and methodology_specifies_relevant_adjustment_to_index_variable(EquityIndexMethodology, k, v)\n        and index_variable_of(v, TheIndex)" .
ex:ASSERT_non_conclusive_means_not_conclusive a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "233"^^xsd:integer ;
  a4:exprText "forall l: CorporateActionList, (non_conclusive(l)) iff (not (conclusive(l)))" ;
  a4:sourceText "constraint non_conclusive_means_not_conclusive :\n  forall l: CorporateActionList,\n    non_conclusive(l) iff not conclusive(l)" .
ex:ASSERT_corporate_action_deviation_conditions a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "237"^^xsd:integer ;
  a4:exprText "forall d: PermittedCorporateActionDeviation, (deviation_in_accordance_with_methodology(d, EquityIndexMethodology)) and (exists ca: IndexMaintenanceCorporateAction, (deviation_for_corporate_action(d, ca)) and (considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)) and ((unusual(ca)) or (complex(ca)) or ((deviation_preserves_index_quality_over_time(d, TheIndex, Comparability)) and (deviation_preserves_index_quality_over_time(d, TheIndex, Representativeness)))))" ;
  a4:sourceText "constraint corporate_action_deviation_conditions :\n  forall d: PermittedCorporateActionDeviation,\n    deviation_in_accordance_with_methodology(d, EquityIndexMethodology)\n    and exists ca: IndexMaintenanceCorporateAction,\n      deviation_for_corporate_action(d, ca)\n      and considers_for_index_maintenance(Solactive, ca, IndexMaintenanceOfTheIndex)\n      and (\n        unusual(ca)\n        or complex(ca)\n        or (\n          deviation_preserves_index_quality_over_time(d, TheIndex, Comparability)\n          and deviation_preserves_index_quality_over_time(d, TheIndex, Representativeness)\n        )\n      )" .
