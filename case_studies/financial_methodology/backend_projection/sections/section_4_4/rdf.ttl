ex:ASSERT_equity_index_methodology_reference a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "91"^^xsd:integer ;
  a4:exprText "(incorporated_by_reference_into(SolactiveEquityIndexMethodology, ThisGuideline)) and (available_on(SolactiveEquityIndexMethodology, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive))" ;
  a4:sourceText "fact equity_index_methodology_reference :\n  incorporated_by_reference_into(SolactiveEquityIndexMethodology, ThisGuideline)\n  and available_on(SolactiveEquityIndexMethodology, SolactiveWebsite)\n  and website_of(SolactiveWebsite, Solactive)" .
ex:ASSERT_announcements_section_on_solactive_website a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "96"^^xsd:integer ;
  a4:exprText "section_of_website(AnnouncementsSection, SolactiveWebsite)" ;
  a4:sourceText "fact announcements_section_on_solactive_website :\n  section_of_website(AnnouncementsSection, SolactiveWebsite)" .
ex:ASSERT_component_weighting_effect_qualified_by_certain_components a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "99"^^xsd:integer ;
  a4:exprText "adjustment_effect_described_by(ComponentWeightingEffect, CertainIndexComponents)" ;
  a4:sourceText "fact component_weighting_effect_qualified_by_certain_components :\n  adjustment_effect_described_by(ComponentWeightingEffect, CertainIndexComponents)" .
ex:ASSERT_index_adjustment_may_be_necessary_between_regular_rebalance_days a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "102"^^xsd:integer ;
  a4:exprText "exists p: IndexAdjustmentPossibility, exists interval: RebalanceInterval, (adjustment_possibility_of_index(p, TheIndex)) and (adjustment_possibility_described_by(p, CertainCircumstances)) and (adjustment_possibility_described_by(p, MayBeNecessary)) and (adjustment_possibility_between_interval(p, interval))" ;
  a4:sourceText "fact index_adjustment_may_be_necessary_between_regular_rebalance_days :\n  exists p: IndexAdjustmentPossibility,\n  exists interval: RebalanceInterval,\n    adjustment_possibility_of_index(p, TheIndex)\n    and adjustment_possibility_described_by(p, CertainCircumstances)\n    and adjustment_possibility_described_by(p, MayBeNecessary)\n    and adjustment_possibility_between_interval(p, interval)" .
ex:ASSERT_rebalance_interval_order a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "110"^^xsd:integer ;
  a4:exprText "forall interval: RebalanceInterval, forall r1: RegularRebalanceDay, forall r2: RegularRebalanceDay, ((interval_start_rebalance_day(interval, r1)) and (interval_end_rebalance_day(interval, r2))) implies (day_before(r1, r2))" ;
  a4:sourceText "constraint rebalance_interval_order :\n  forall interval: RebalanceInterval,\n  forall r1: RegularRebalanceDay,\n  forall r2: RegularRebalanceDay,\n    interval_start_rebalance_day(interval, r1)\n    and interval_end_rebalance_day(interval, r2)\n    implies day_before(r1, r2)" .
ex:ASSERT_corporate_action_creates_required_index_adjustment a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "118"^^xsd:integer ;
  a4:exprText "forall ca: CorporateAction, forall c: IndexComponent, forall d: Day, ((specified_in(ca, Section4_4Below)) and (corporate_action_in_relation_to_component(ca, c)) and (occurs_on(ca, d))) implies (exists a: RequiredIndexAdjustment, exists interval: RebalanceInterval, (adjustment_of_index(a, TheIndex)) and (adjustment_required_due_to_corporate_action(a, ca)) and (affected_index_component(a, c)) and (adjustment_between_interval(a, interval)))" ;
  a4:sourceText "constraint corporate_action_creates_required_index_adjustment :\n  forall ca: CorporateAction,\n  forall c: IndexComponent,\n  forall d: Day,\n    specified_in(ca, Section4_4Below)\n    and corporate_action_in_relation_to_component(ca, c)\n    and occurs_on(ca, d)\n    implies\n      exists a: RequiredIndexAdjustment,\n      exists interval: RebalanceInterval,\n        adjustment_of_index(a, TheIndex)\n        and adjustment_required_due_to_corporate_action(a, ca)\n        and affected_index_component(a, c)\n        and adjustment_between_interval(a, interval)" .
ex:ASSERT_required_adjustment_effect_scope a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "133"^^xsd:integer ;
  a4:exprText "forall a: RequiredIndexAdjustment, (adjustment_effect_scope_described_by(a, MayHaveToBeDone)) and ((possible_adjustment_effect(a, ComponentRelationEffect)) or (possible_adjustment_effect(a, ComponentNumberEffect)) or (possible_adjustment_effect(a, ComponentWeightingEffect)))" ;
  a4:sourceText "constraint required_adjustment_effect_scope :\n  forall a: RequiredIndexAdjustment,\n    adjustment_effect_scope_described_by(a, MayHaveToBeDone)\n    and (\n      possible_adjustment_effect(a, ComponentRelationEffect)\n      or possible_adjustment_effect(a, ComponentNumberEffect)\n      or possible_adjustment_effect(a, ComponentWeightingEffect)\n    )" .
ex:ASSERT_index_adjustment_notice_publication a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "142"^^xsd:integer ;
  a4:exprText "forall a: RequiredIndexAdjustment, forall n: Notice, (notice_for_index_adjustment(n, a)) implies ((announced_by(n, Solactive)) and (announced_on(n, SolactiveWebsite)) and (announced_under_section(n, AnnouncementsSection)))" ;
  a4:sourceText "constraint index_adjustment_notice_publication :\n  forall a: RequiredIndexAdjustment,\n  forall n: Notice,\n    notice_for_index_adjustment(n, a)\n    implies\n      announced_by(n, Solactive)\n      and announced_on(n, SolactiveWebsite)\n      and announced_under_section(n, AnnouncementsSection)" .
ex:ASSERT_notice_period_at_least_two_trading_days a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "151"^^xsd:integer ;
  a4:exprText "forall a: RequiredIndexAdjustment, forall n: Notice, forall p: NoticePeriod, forall c: IndexComponent, ((notice_for_index_adjustment(n, a)) and (notice_gives_notice_period(n, p)) and (affected_index_component(a, c)) and (notice_period_with_respect_to_component(p, c))) implies ((<count>) >= (2))" ;
  a4:sourceText "constraint notice_period_at_least_two_trading_days :\n  forall a: RequiredIndexAdjustment,\n  forall n: Notice,\n  forall p: NoticePeriod,\n  forall c: IndexComponent,\n    notice_for_index_adjustment(n, a)\n    and notice_gives_notice_period(n, p)\n    and affected_index_component(a, c)\n    and notice_period_with_respect_to_component(p, c)\n    implies\n      count(t in TradingDay where\n        notice_period_day(p, t)\n        and trading_day_with_respect_to(t, c)\n        and day_before(t, effective_day_specified_in_respective_notice(n))\n      ) >= 2" .
ex:ASSERT_index_adjustment_implemented_on_notice_effective_day a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "167"^^xsd:integer ;
  a4:exprText "forall a: RequiredIndexAdjustment, forall n: Notice, (notice_for_index_adjustment(n, a)) implies (implemented_on(a, effective_day_specified_in_respective_notice(n)))" ;
  a4:sourceText "constraint index_adjustment_implemented_on_notice_effective_day :\n  forall a: RequiredIndexAdjustment,\n  forall n: Notice,\n    notice_for_index_adjustment(n, a)\n    implies implemented_on(a, effective_day_specified_in_respective_notice(n))" .
