ex:SolactiveGBSGlobalMarketsAllCapUSDIndexPR ex:isin ex:DE000SLA78E2 .
ex:ASSERT_solactive_gbs_benchmark_series_pdf_url a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "document_url(SolactiveGBSBenchmarkSeriesPdf, HttpsWwwSolactiveComDownloadsGuidelineSolactiveGBSBenchmarkSeriesPdf)" .
ex:ASSERT_gbs_index_universe_framework_document_part a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "part_of_document(GbsIndexUniverseFrameworkDocumentPart, SolactiveGBSBenchmarkSeriesPdf)" .
ex:ASSERT_gbs_index_universe_framework_document_part_locator a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "document_part_locator(GbsIndexUniverseFrameworkDocumentPart, GbsIndexUniverseFrameworkDocumentLocator)" .
ex:ASSERT_gbs_index_universe_framework_document_part_url a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "document_part_url(GbsIndexUniverseFrameworkDocumentPart, HttpsWwwSolactiveComDownloadsGuidelineSolactiveGBSBenchmarkSeriesPdf)" .
ex:ASSERT_index_universe_minimum_average_daily_value_traded_threshold_currency a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(currency(IndexUniverseMinimumAverageDailyValueTradedThreshold)) = (USD)" .
ex:ASSERT_index_universe_minimum_average_daily_value_traded_threshold_value a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(monetary_amount_value(IndexUniverseMinimumAverageDailyValueTradedThreshold)) = (5)" .
ex:ASSERT_index_universe_minimum_average_daily_value_traded_threshold_scale a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(monetary_amount_scale(IndexUniverseMinimumAverageDailyValueTradedThreshold)) = (Million)" .
ex:OneMonth owl:sameAs "1"^^xsd:integer .
ex:SixMonths owl:sameAs "6"^^xsd:integer .
ex:ASSERT_declared_lookback_windows a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, ((months_over(months_prior_including_selection_day(OneMonth, d))) = (OneMonth)) and (lookback_window_anchor_day(months_prior_including_selection_day(OneMonth, d), d)) and (lookback_window_includes_anchor_day(months_prior_including_selection_day(OneMonth, d), d)) and ((months_over(months_prior_including_selection_day(SixMonths, d))) = (SixMonths)) and (lookback_window_anchor_day(months_prior_including_selection_day(SixMonths, d), d)) and (lookback_window_includes_anchor_day(months_prior_including_selection_day(SixMonths, d), d))" .
ex:ASSERT_minimum_average_daily_value_traded_over_declared_lookback_windows a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall s: Security, ((minimum_average_daily_value_traded(d, s)) <= (average_daily_value_traded(d, s, months_prior_including_selection_day(OneMonth, d)))) and ((minimum_average_daily_value_traded(d, s)) <= (average_daily_value_traded(d, s, months_prior_including_selection_day(SixMonths, d)))) and (((minimum_average_daily_value_traded(d, s)) = (average_daily_value_traded(d, s, months_prior_including_selection_day(OneMonth, d)))) or ((minimum_average_daily_value_traded(d, s)) = (average_daily_value_traded(d, s, months_prior_including_selection_day(SixMonths, d)))))" .
ex:ASSERT_appendix_rbics_subindustry_classification_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall cls: RBICSSubindustryClassification, (appendix_rbics_subindustry_classification(cls)) iff ((rbics_subindustry_classification_of_system(cls, FactSetRevereBusinessIndustryClassificationSystem)) and (rbics_subindustry_classification_in_appendix(cls, IndexGuidelineAppendix)))" .
ex:ASSERT_company_currently_included_in_index_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall co: Company, (company_currently_included_in_index(d, co)) iff (exists sc: ShareClass, ((company(sc)) = (co)) and (share_class_currently_included_in_index(d, sc)))" .
ex:ASSERT_highest_minimum_average_daily_value_traded_share_class_company a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall co: Company, (company(share_class_with_highest_minimum_average_daily_value_traded(d, co))) = (co)" .
ex:ASSERT_highest_minimum_average_daily_value_traded_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall co: Company, forall other: ShareClass, (((company(other)) = (co)) and (not ((other) = (share_class_with_highest_minimum_average_daily_value_traded(d, co))))) implies ((minimum_average_daily_value_traded(d, share_class_with_highest_minimum_average_daily_value_traded(d, co))) >= (minimum_average_daily_value_traded(d, other)))" .
ex:ASSERT_highest_minimum_average_daily_value_traded_predicate a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (highest_minimum_average_daily_value_traded(d, sc)) iff ((sc) = (share_class_with_highest_minimum_average_daily_value_traded(d, company(sc))))" .
ex:ASSERT_current_company_buffer_rule a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (eligible_by_current_company_buffer_rule(d, sc)) iff ((company_currently_included_in_index(d, company(sc))) and (share_class_currently_included_in_index(d, sc)) and (forall other: ShareClass, (((company(other)) = (company(sc))) and (not ((other) = (sc)))) implies ((minimum_average_daily_value_traded(d, sc)) >= ((60%) * (minimum_average_daily_value_traded(d, other))))))" .
ex:ASSERT_not_current_company_buffer_rule a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (eligible_by_not_current_company_buffer_rule(d, sc)) iff ((not (company_currently_included_in_index(d, company(sc)))) and (highest_minimum_average_daily_value_traded(d, sc)))" .
ex:ASSERT_share_class_satisfies_buffer_rule_definition a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (share_class_satisfies_buffer_rule(d, sc)) iff ((eligible_by_current_company_buffer_rule(d, sc)) or (eligible_by_not_current_company_buffer_rule(d, sc)))" .
ex:ASSERT_index_universe_bridge a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (index_universe(d, sc)) iff (eligible_for_index_universe(d, sc))" .
ex:ASSERT_eligible_for_index_universe_requirements a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (eligible_for_index_universe(d, sc)) iff ((part_component_of_gbs_index_universe(d, sc, gbs_index_universe(SolactiveGBSGlobalMarketsAllCapUSDIndexPR))) and (((gbs_index_universe_classification(d, sc)) = (DevelopedMarketsEurope)) or ((gbs_index_universe_classification(d, sc)) = (Canada)) or ((gbs_index_universe_classification(d, sc)) = (UnitedStates))) and ((minimum_average_daily_value_traded(d, sc)) >= (IndexUniverseMinimumAverageDailyValueTradedThreshold)) and (share_class_satisfies_buffer_rule(d, sc)) and (appendix_rbics_subindustry_classification(rbics_subindustry_classification(d, sc))))" .
ex:ASSERT_only_one_share_class_of_each_company a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall d: SelectionDay, forall co: Company, (<count>) <= (1)" .
ex:ASSERT_determination_of_index_universe_fully_rule_based a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall d: SelectionDay, fully_rule_based(determination_of_index_universe(d))" .
