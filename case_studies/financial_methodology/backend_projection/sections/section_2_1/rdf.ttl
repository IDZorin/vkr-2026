ex:ASSERT_declared_lookback_windows a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "73"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, ((months_over(months_prior_including_selection_day(OneMonth, d))) = (OneMonth)) and (lookback_window_anchor_day(months_prior_including_selection_day(OneMonth, d), d)) and (lookback_window_includes_anchor_day(months_prior_including_selection_day(OneMonth, d), d)) and ((months_over(months_prior_including_selection_day(SixMonths, d))) = (SixMonths)) and (lookback_window_anchor_day(months_prior_including_selection_day(SixMonths, d), d)) and (lookback_window_includes_anchor_day(months_prior_including_selection_day(SixMonths, d), d))" ;
  a4:sourceText "constraint declared_lookback_windows :\nforall d: SelectionDay,\nmonths_over(months_prior_including_selection_day(OneMonth, d)) = OneMonth\nand lookback_window_anchor_day(months_prior_including_selection_day(OneMonth, d), d)\nand lookback_window_includes_anchor_day(months_prior_including_selection_day(OneMonth, d), d)\nand months_over(months_prior_including_selection_day(SixMonths, d)) = SixMonths\nand lookback_window_anchor_day(months_prior_including_selection_day(SixMonths, d), d)\nand lookback_window_includes_anchor_day(months_prior_including_selection_day(SixMonths, d), d)" .
ex:ASSERT_minimum_average_daily_value_traded_over_declared_lookback_windows a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "85"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall s: Security, ((minimum_average_daily_value_traded(d, s)) <= (average_daily_value_traded(d, s, months_prior_including_selection_day(OneMonth, d)))) and ((minimum_average_daily_value_traded(d, s)) <= (average_daily_value_traded(d, s, months_prior_including_selection_day(SixMonths, d)))) and (((minimum_average_daily_value_traded(d, s)) = (average_daily_value_traded(d, s, months_prior_including_selection_day(OneMonth, d)))) or ((minimum_average_daily_value_traded(d, s)) = (average_daily_value_traded(d, s, months_prior_including_selection_day(SixMonths, d)))))" ;
  a4:sourceText "constraint minimum_average_daily_value_traded_over_declared_lookback_windows :\nforall d: SelectionDay, forall s: Security,\nminimum_average_daily_value_traded(d, s)\n<= average_daily_value_traded(d, s, months_prior_including_selection_day(OneMonth, d))\nand minimum_average_daily_value_traded(d, s)\n<= average_daily_value_traded(d, s, months_prior_including_selection_day(SixMonths, d))\nand (\nminimum_average_daily_value_traded(d, s)\n= average_daily_value_traded(d, s, months_prior_including_selection_day(OneMonth, d))\nor\nminimum_average_daily_value_traded(d, s)\n= average_daily_value_traded(d, s, months_prior_including_selection_day(SixMonths, d))\n)" .
ex:ASSERT_appendix_rbics_subindustry_classification_definition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "114"^^xsd:integer ;
  a4:exprText "forall cls: RBICSSubindustryClassification, (appendix_rbics_subindustry_classification(cls)) iff ((rbics_subindustry_classification_of_system(cls, FactSetRevereBusinessIndustryClassificationSystem)) and (rbics_subindustry_classification_in_appendix(cls, IndexGuidelineAppendix)))" ;
  a4:sourceText "constraint appendix_rbics_subindustry_classification_definition :\nforall cls: RBICSSubindustryClassification,\nappendix_rbics_subindustry_classification(cls)\niff\nrbics_subindustry_classification_of_system(\ncls,\nFactSetRevereBusinessIndustryClassificationSystem\n)\nand rbics_subindustry_classification_in_appendix(\ncls,\nIndexGuidelineAppendix\n)" .
ex:ASSERT_company_currently_included_in_index_definition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "144"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall co: Company, (company_currently_included_in_index(d, co)) iff (exists sc: ShareClass, ((company(sc)) = (co)) and (share_class_currently_included_in_index(d, sc)))" ;
  a4:sourceText "constraint company_currently_included_in_index_definition :\nforall d: SelectionDay, forall co: Company,\ncompany_currently_included_in_index(d, co)\niff\nexists sc: ShareClass,\ncompany(sc) = co\nand share_class_currently_included_in_index(d, sc)" .
ex:ASSERT_highest_minimum_average_daily_value_traded_share_class_company a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "165"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall co: Company, (company(share_class_with_highest_minimum_average_daily_value_traded(d, co))) = (co)" ;
  a4:sourceText "constraint highest_minimum_average_daily_value_traded_share_class_company :\nforall d: SelectionDay, forall co: Company,\ncompany(share_class_with_highest_minimum_average_daily_value_traded(d, co)) = co" .
ex:ASSERT_highest_minimum_average_daily_value_traded_definition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "169"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall co: Company, forall other: ShareClass, (((company(other)) = (co)) and (not ((other) = (share_class_with_highest_minimum_average_daily_value_traded(d, co))))) implies ((minimum_average_daily_value_traded(d, share_class_with_highest_minimum_average_daily_value_traded(d, co))) >= (minimum_average_daily_value_traded(d, other)))" ;
  a4:sourceText "constraint highest_minimum_average_daily_value_traded_definition :\nforall d: SelectionDay, forall co: Company, forall other: ShareClass,\ncompany(other) = co\nand other != share_class_with_highest_minimum_average_daily_value_traded(d, co)\nimplies\nminimum_average_daily_value_traded(\nd,\nshare_class_with_highest_minimum_average_daily_value_traded(d, co)\n)\n>= minimum_average_daily_value_traded(d, other)" .
ex:ASSERT_highest_minimum_average_daily_value_traded_predicate a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "180"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (highest_minimum_average_daily_value_traded(d, sc)) iff ((sc) = (share_class_with_highest_minimum_average_daily_value_traded(d, company(sc))))" ;
  a4:sourceText "constraint highest_minimum_average_daily_value_traded_predicate :\nforall d: SelectionDay, forall sc: ShareClass,\nhighest_minimum_average_daily_value_traded(d, sc)\niff\nsc = share_class_with_highest_minimum_average_daily_value_traded(\nd,\ncompany(sc)\n)" .
ex:ASSERT_current_company_buffer_rule a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "189"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (eligible_by_current_company_buffer_rule(d, sc)) iff ((company_currently_included_in_index(d, company(sc))) and (share_class_currently_included_in_index(d, sc)) and (forall other: ShareClass, (((company(other)) = (company(sc))) and (not ((other) = (sc)))) implies ((minimum_average_daily_value_traded(d, sc)) >= ((60%) * (minimum_average_daily_value_traded(d, other))))))" ;
  a4:sourceText "constraint current_company_buffer_rule [realizes: CurrentCompanyBufferRule] :\nforall d: SelectionDay, forall sc: ShareClass,\neligible_by_current_company_buffer_rule(d, sc)\niff\ncompany_currently_included_in_index(d, company(sc))\nand share_class_currently_included_in_index(d, sc)\nand forall other: ShareClass,\ncompany(other) = company(sc)\nand other != sc\nimplies\nminimum_average_daily_value_traded(d, sc)\n>= 60% * minimum_average_daily_value_traded(d, other)" .
ex:ASSERT_not_current_company_buffer_rule a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "202"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (eligible_by_not_current_company_buffer_rule(d, sc)) iff ((not (company_currently_included_in_index(d, company(sc)))) and (highest_minimum_average_daily_value_traded(d, sc)))" ;
  a4:sourceText "constraint not_current_company_buffer_rule [realizes: NotCurrentCompanyBufferRule] :\nforall d: SelectionDay, forall sc: ShareClass,\neligible_by_not_current_company_buffer_rule(d, sc)\niff\nnot company_currently_included_in_index(d, company(sc))\nand highest_minimum_average_daily_value_traded(d, sc)" .
ex:ASSERT_share_class_satisfies_buffer_rule_definition a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "209"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (share_class_satisfies_buffer_rule(d, sc)) iff ((eligible_by_current_company_buffer_rule(d, sc)) or (eligible_by_not_current_company_buffer_rule(d, sc)))" ;
  a4:sourceText "constraint share_class_satisfies_buffer_rule_definition :\nforall d: SelectionDay, forall sc: ShareClass,\nshare_class_satisfies_buffer_rule(d, sc)\niff\neligible_by_current_company_buffer_rule(d, sc)\nor eligible_by_not_current_company_buffer_rule(d, sc)" .
ex:ASSERT_index_universe_bridge a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "224"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (index_universe(d, sc)) iff (eligible_for_index_universe(d, sc))" ;
  a4:sourceText "constraint index_universe_bridge :\nforall d: SelectionDay, forall sc: ShareClass,\nindex_universe(d, sc) iff eligible_for_index_universe(d, sc)" .
ex:ASSERT_eligible_for_index_universe_requirements a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "228"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall sc: ShareClass, (eligible_for_index_universe(d, sc)) iff ((part_component_of_gbs_index_universe(d, sc, gbs_index_universe(SolactiveGBSGlobalMarketsAllCapUSDIndexPR))) and (((gbs_index_universe_classification(d, sc)) = (DevelopedMarketsEurope)) or ((gbs_index_universe_classification(d, sc)) = (Canada)) or ((gbs_index_universe_classification(d, sc)) = (UnitedStates))) and ((minimum_average_daily_value_traded(d, sc)) >= (IndexUniverseMinimumAverageDailyValueTradedThreshold)) and (share_class_satisfies_buffer_rule(d, sc)) and (appendix_rbics_subindustry_classification(rbics_subindustry_classification(d, sc))))" ;
  a4:sourceText "constraint eligible_for_index_universe_requirements :\nforall d: SelectionDay, forall sc: ShareClass,\neligible_for_index_universe(d, sc)\niff\npart_component_of_gbs_index_universe(\nd,\nsc,\ngbs_index_universe(SolactiveGBSGlobalMarketsAllCapUSDIndexPR)\n)\nand (\ngbs_index_universe_classification(d, sc) = DevelopedMarketsEurope\nor gbs_index_universe_classification(d, sc) = Canada\nor gbs_index_universe_classification(d, sc) = UnitedStates\n)\nand minimum_average_daily_value_traded(d, sc)\n>= IndexUniverseMinimumAverageDailyValueTradedThreshold\nand share_class_satisfies_buffer_rule(d, sc)\nand appendix_rbics_subindustry_classification(\nrbics_subindustry_classification(d, sc)\n)" .
ex:ASSERT_only_one_share_class_of_each_company a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "249"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, forall co: Company, (<count>) <= (1)" ;
  a4:sourceText "constraint only_one_share_class_of_each_company :\nforall d: SelectionDay, forall co: Company,\ncount(sc in ShareClass where eligible_for_index_universe(d, sc) and company(sc) = co) <= 1" .
ex:ASSERT_determination_of_index_universe_fully_rule_based a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "253"^^xsd:integer ;
  a4:exprText "forall d: SelectionDay, fully_rule_based(determination_of_index_universe(d))" ;
  a4:sourceText "fact determination_of_index_universe_fully_rule_based :\nforall d: SelectionDay,\nfully_rule_based(determination_of_index_universe(d))" .
