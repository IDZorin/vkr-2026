ex:ASSERT_index_methodology_scope a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "74"^^xsd:integer ;
  a4:exprText "methodology_of_index(TheIndexMethodology, TheIndex)" ;
  a4:sourceText "fact index_methodology_scope :\n  methodology_of_index(TheIndexMethodology, TheIndex)" .
ex:ASSERT_methodology_subject_to_regular_review_at_least_annually a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "77"^^xsd:integer ;
  a4:exprText "exists r: MethodologyReview, (review_of_methodology(r, TheIndexMethodology)) and (regular(r)) and (at_least_annually(r))" ;
  a4:sourceText "constraint methodology_subject_to_regular_review_at_least_annually :\n  exists r: MethodologyReview,\n    review_of_methodology(r, TheIndexMethodology)\n    and regular(r)\n    and at_least_annually(r)" .
ex:ASSERT_methodology_reviews_are_regular_at_least_annually a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "83"^^xsd:integer ;
  a4:exprText "forall r: MethodologyReview, (review_of_methodology(r, TheIndexMethodology)) implies ((regular(r)) and (at_least_annually(r)))" ;
  a4:sourceText "constraint methodology_reviews_are_regular_at_least_annually :\n  forall r: MethodologyReview,\n    review_of_methodology(r, TheIndexMethodology)\n    implies\n      regular(r)\n      and at_least_annually(r)" .
ex:ASSERT_identified_need_has_review_identified_change a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "90"^^xsd:integer ;
  a4:exprText "forall n: MethodologyChangeNeed, forall r: MethodologyReview, ((need_identified_within_review(n, r)) and (review_of_methodology(r, TheIndexMethodology))) implies ((change_need_of_methodology(n, TheIndexMethodology)) and (exists c: ReviewIdentifiedMethodologyChange, (change_for_need(c, n)) and (change_of_methodology(c, TheIndexMethodology))))" ;
  a4:sourceText "constraint identified_need_has_review_identified_change :\n  forall n: MethodologyChangeNeed, forall r: MethodologyReview,\n    need_identified_within_review(n, r)\n    and review_of_methodology(r, TheIndexMethodology)\n    implies\n      (\n        change_need_of_methodology(n, TheIndexMethodology)\n        and\n        exists c: ReviewIdentifiedMethodologyChange,\n          change_for_need(c, n)\n          and change_of_methodology(c, TheIndexMethodology)\n      )" .
ex:ASSERT_methodology_change_need_example_condition_catalog a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "116"^^xsd:integer ;
  a4:exprText "(example_condition_for_methodology_change_need(UnderlyingMarketChange)) and (example_condition_for_methodology_change_need(EconomicRealityChange)) and (example_condition_for_methodology_change_need(ObsoleteAssumption)) and (example_condition_for_methodology_change_need(ObsoleteFactor)) and (example_condition_for_methodology_change_need(NoLongerReflectsReality)) and (example_condition_changed_since_launch_of_index(UnderlyingMarketChange, TheIndex)) and (example_condition_changed_since_launch_of_index(EconomicRealityChange, TheIndex)) and (example_condition_obsolete_assumption_for_methodology(ObsoleteAssumption, TheIndexMethodology)) and (methodology_has_obsolete_basis(TheIndexMethodology, ObsoleteAssumption)) and (example_condition_obsolete_factor_for_methodology(ObsoleteFactor, TheIndexMethodology)) and (methodology_has_obsolete_basis(TheIndexMethodology, ObsoleteFactor)) and (example_condition_reflection_quality(NoLongerReflectsReality, Accuracy)) and (example_condition_reflection_quality(NoLongerReflectsReality, Reliability)) and (example_condition_reflection_quality(NoLongerReflectsReality, Appropriateness))" ;
  a4:sourceText "fact methodology_change_need_example_condition_catalog :\n  example_condition_for_methodology_change_need(UnderlyingMarketChange)\n  and example_condition_for_methodology_change_need(EconomicRealityChange)\n  and example_condition_for_methodology_change_need(ObsoleteAssumption)\n  and example_condition_for_methodology_change_need(ObsoleteFactor)\n  and example_condition_for_methodology_change_need(NoLongerReflectsReality)\n  and example_condition_changed_since_launch_of_index(\n    UnderlyingMarketChange,\n    TheIndex\n  )\n  and example_condition_changed_since_launch_of_index(\n    EconomicRealityChange,\n    TheIndex\n  )\n  and example_condition_obsolete_assumption_for_methodology(\n    ObsoleteAssumption,\n    TheIndexMethodology\n  )\n  and methodology_has_obsolete_basis(\n    TheIndexMethodology,\n    ObsoleteAssumption\n  )\n  and example_condition_obsolete_factor_for_methodology(\n    ObsoleteFactor,\n    TheIndexMethodology\n  )\n  and methodology_has_obsolete_basis(\n    TheIndexMethodology,\n    ObsoleteFactor\n  )\n  and example_condition_reflection_quality(NoLongerReflectsReality, Accuracy)\n  and example_condition_reflection_quality(NoLongerReflectsReality, Reliability)\n  and example_condition_reflection_quality(NoLongerReflectsReality, Appropriateness)" .
ex:ASSERT_no_longer_reflects_reality_condition_means_not_reflects_reality_as_before a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "150"^^xsd:integer ;
  a4:exprText "forall q: ReflectionQuality, (example_condition_reflection_quality(NoLongerReflectsReality, q)) implies (not (reflects_reality_as_before(TheIndexMethodology, q)))" ;
  a4:sourceText "constraint no_longer_reflects_reality_condition_means_not_reflects_reality_as_before :\n  forall q: ReflectionQuality,\n    example_condition_reflection_quality(NoLongerReflectsReality, q)\n    implies not reflects_reality_as_before(TheIndexMethodology, q)" .
ex:ASSERT_methodology_change_need_example_condition_scope a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "155"^^xsd:integer ;
  a4:exprText "forall n: MethodologyChangeNeed, forall c: MethodologyChangeNeedExampleCondition, (need_has_example_condition(n, c)) implies ((change_need_of_methodology(n, TheIndexMethodology)) and (example_condition_for_methodology_change_need(c)))" ;
  a4:sourceText "constraint methodology_change_need_example_condition_scope :\n  forall n: MethodologyChangeNeed,\n  forall c: MethodologyChangeNeedExampleCondition,\n    need_has_example_condition(n, c)\n    implies\n      change_need_of_methodology(n, TheIndexMethodology)\n      and example_condition_for_methodology_change_need(c)" .
ex:ASSERT_methodology_policy_location a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "163"^^xsd:integer ;
  a4:exprText "(document_url(SolactiveMethodologyPolicy, HttpsWwwSolactiveComDocumentsMethodologyPolicy)) and (available_on(SolactiveMethodologyPolicy, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive)) and (incorporated_by_reference_into(SolactiveMethodologyPolicy, Guideline))" ;
  a4:sourceText "fact methodology_policy_location :\n  document_url(\n    SolactiveMethodologyPolicy,\n    HttpsWwwSolactiveComDocumentsMethodologyPolicy\n  )\n  and available_on(SolactiveMethodologyPolicy, SolactiveWebsite)\n  and website_of(SolactiveWebsite, Solactive)\n  and incorporated_by_reference_into(SolactiveMethodologyPolicy, Guideline)" .
ex:ASSERT_announcement_section_location a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "172"^^xsd:integer ;
  a4:exprText "(section_of_website(AnnouncementSection, SolactiveWebsite)) and (document_part_url(AnnouncementSection, HttpsWwwSolactiveComNewsAnnouncements))" ;
  a4:sourceText "fact announcement_section_location :\n  section_of_website(AnnouncementSection, SolactiveWebsite)\n  and document_part_url(\n    AnnouncementSection,\n    HttpsWwwSolactiveComNewsAnnouncements\n  )" .
ex:ASSERT_last_amendment_date_contained_in_guideline a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "179"^^xsd:integer ;
  a4:exprText "(amendment_of_index(last_amendment(TheIndex), TheIndex)) and (contained_in(amendment_date(last_amendment(TheIndex)), Guideline))" ;
  a4:sourceText "fact last_amendment_date_contained_in_guideline :\n  amendment_of_index(last_amendment(TheIndex), TheIndex)\n  and contained_in(\n    amendment_date(last_amendment(TheIndex)),\n    Guideline\n  )" .
