ex:ASSERT_bbg_ticker_at_most_one a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "169"^^xsd:integer ;
  a4:exprText "forall i: Index, (<count>) <= (1)" ;
  a4:sourceText "constraint bbg_ticker_at_most_one :\nforall i: Index,\ncount(t in BBGTicker where bbg_ticker(i, t)) <= 1" .
ex:ASSERT_listed_indices_publication_channels a a4:Assertion ;
