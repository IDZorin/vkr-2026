  a4:lineNo "101"^^xsd:integer ;
  a4:exprText "(has_url(SolactiveWebsite, HttpsWwwSolactiveCom)) and (website_of(SolactiveWebsite, Solactive))" ;
  a4:sourceText "fact solactive_website :\nhas_url(SolactiveWebsite, HttpsWwwSolactiveCom)\nand website_of(SolactiveWebsite, Solactive)" .
