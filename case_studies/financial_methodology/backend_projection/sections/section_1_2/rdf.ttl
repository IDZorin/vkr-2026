ex:ASSERT_vendor_decides_distribution_or_display a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "189"^^xsd:integer ;
  a4:exprText "forall v: AffiliatedVendor, forall i: Index, (published_under_following_identifiers(i)) implies (exists d: VendorDistributionOrDisplayDecision, exists s: InformationSystem, (distribution_or_display_decision_for_vendor(d, v)) and (distribution_or_display_decision_for_index(d, i)) and (decision_on_individual_basis(d)) and (vendor_information_system(v, s)) and (decision_via_information_system(d, s)))" ;
  a4:sourceText "fact vendor_decides_distribution_or_display :\nforall v: AffiliatedVendor, forall i: Index,\npublished_under_following_identifiers(i)\nimplies\nexists d: VendorDistributionOrDisplayDecision, exists s: InformationSystem,\n  distribution_or_display_decision_for_vendor(d, v)\n  and distribution_or_display_decision_for_index(d, i)\n  and decision_on_individual_basis(d)\n  and vendor_information_system(v, s)\n  and decision_via_information_system(d, s)" .
ex:ASSERT_index_publications_available_at_announcements_website a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "200"^^xsd:integer ;
  a4:exprText "forall p: IndexPublication, forall i: Index, ((publication_in_relation_to_index(p, i)) or (notice_publication_in_relation_to_index(p, i)) or (guideline_amendment_publication_in_relation_to_index(p, Guideline, i))) implies (available_at(p, IndexAdministratorAnnouncementsWebsite))" ;
  a4:sourceText "constraint index_publications_available_at_announcements_website :\nforall p: IndexPublication, forall i: Index,\n(\n  publication_in_relation_to_index(p, i)\n  or notice_publication_in_relation_to_index(p, i)\n  or guideline_amendment_publication_in_relation_to_index(p, Guideline, i)\n)\nimplies available_at(p, IndexAdministratorAnnouncementsWebsite)" .
