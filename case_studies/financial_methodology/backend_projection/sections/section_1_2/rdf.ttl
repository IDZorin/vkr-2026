ex:ASSERT_index_type_identifier_meanings a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "95"^^xsd:integer ;
  a4:exprText "((index_type_identifier(PriceReturn)) = (PR)) and ((index_type_identifier(NetTotalReturn)) = (NTR)) and ((index_type_identifier(GrossTotalReturn)) = (GTR)) and ((index_type_identifier(AdjustedReturnIndex)) = (AR))" ;
  a4:sourceText "fact index_type_identifier_meanings :\nindex_type_identifier(PriceReturn) = PR\nand index_type_identifier(NetTotalReturn) = NTR\nand index_type_identifier(GrossTotalReturn) = GTR\nand index_type_identifier(AdjustedReturnIndex) = AR" .
