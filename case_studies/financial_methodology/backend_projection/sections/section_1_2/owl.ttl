ex:ASSERT_bbg_ticker_at_most_one a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall i: Index, (<count>) <= (1)" .
ex:SolactiveTransatlanticCleanEnergyEURIndexPR ex:published_on ex:SolactiveWebsite .
ex:SolactiveTransatlanticCleanEnergyEURIndexPR ex:available_via ex:BoerseStuttgartGmbHPriceMarketingServices .
ex:SolactiveTransatlanticCleanEnergyEURIndexNTR ex:published_on ex:SolactiveWebsite .
ex:SolactiveTransatlanticCleanEnergyEURIndexNTR ex:available_via ex:BoerseStuttgartGmbHPriceMarketingServices .
ex:SolactiveTransatlanticCleanEnergyEURIndexTR ex:published_on ex:SolactiveWebsite .
ex:SolactiveTransatlanticCleanEnergyEURIndexTR ex:available_via ex:BoerseStuttgartGmbHPriceMarketingServices .
ex:SolactiveTransatlanticCleanEnergyEURIndex50AR ex:published_on ex:SolactiveWebsite .
ex:SolactiveTransatlanticCleanEnergyEURIndex50AR ex:available_via ex:BoerseStuttgartGmbHPriceMarketingServices .
ex:SolactiveTransatlanticCleanEnergyEURIndex5PercentAR ex:published_on ex:SolactiveWebsite .
ex:SolactiveTransatlanticCleanEnergyEURIndex5PercentAR ex:available_via ex:BoerseStuttgartGmbHPriceMarketingServices .
ex:ASSERT_vendor_decides_distribution_or_display a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "forall v: AffiliatedVendor, forall i: Index, (published_under_following_identifiers(i)) implies (exists d: VendorDistributionOrDisplayDecision, exists s: InformationSystem, (distribution_or_display_decision_for_vendor(d, v)) and (distribution_or_display_decision_for_index(d, i)) and (decision_on_individual_basis(d)) and (vendor_information_system(v, s)) and (decision_via_information_system(d, s)))" .
ex:ASSERT_index_publications_available_at_announcements_website a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall p: IndexPublication, forall i: Index, ((publication_in_relation_to_index(p, i)) or (notice_publication_in_relation_to_index(p, i)) or (guideline_amendment_publication_in_relation_to_index(p, Guideline, i))) implies (available_at(p, IndexAdministratorAnnouncementsWebsite))" .
