ex:DE000SL0R4C2 a ex:ISIN, owl:NamedIndividual .
ex:DE000SL0R4D0 a ex:ISIN, owl:NamedIndividual .
ex:DE000SL0R4E8 a ex:ISIN, owl:NamedIndividual .
ex:DE000SL0R4F5 a ex:ISIN, owl:NamedIndividual .
ex:DotSOLTCEYP a ex:RIC, owl:NamedIndividual .
ex:DotSOLTCEYN a ex:RIC, owl:NamedIndividual .
ex:DotSOLTCEYT a ex:RIC, owl:NamedIndividual .
ex:DotSOLTCA50 a ex:RIC, owl:NamedIndividual .
ex:DotSOLTCEA5 a ex:RIC, owl:NamedIndividual .
ex:SOLTCEYP a ex:BBGTicker, owl:NamedIndividual .
ex:SOLTCEYT a ex:BBGTicker, owl:NamedIndividual .
ex:SOLTCA50 a ex:BBGTicker, owl:NamedIndividual .
ex:SOLTCEA5 a ex:BBGTicker, owl:NamedIndividual .
ex:Guideline a ex:Document, owl:NamedIndividual .
ex:EquityIndexMethodology a ex:Document, owl:NamedIndividual .
ex:Section4 a ex:DocumentPart, owl:NamedIndividual .
ex:Section4Locator a ex:DocumentLocator, owl:NamedIndividual .
ex:SolactiveWebsite a ex:WebResource, owl:NamedIndividual .
ex:IndexAdministratorAnnouncementsWebsite a ex:WebResource, owl:NamedIndividual .
ex:HttpsWwwSolactiveCom a ex:Url, owl:NamedIndividual .
ex:HttpsWwwSolactiveComDocumentsEquityIndexMethodology a ex:Url, owl:NamedIndividual .
ex:HttpsWwwSolactiveComNewsAnnouncements a ex:Url, owl:NamedIndividual .
ex:index_name a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:IndexName .
ex:index_isin a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:ISIN .
ex:index_currency a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:Currency .
ex:index_type a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:IndexType .
ex:index_type_identifier a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:IndexType ;
  rdfs:range ex:IndexTypeIdentifier .
ex:index_ric a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:RIC .
ex:bbg_ticker a owl:ObjectProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:BBGTicker .
ex:published_under_following_identifiers a owl:Class ; rdfs:subClassOf ex:Index .
ex:calculation_described_in a owl:ObjectProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:Document .
ex:formula_specified_in a owl:ObjectProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:DocumentPart .
ex:website_of a owl:ObjectProperty ;
  rdfs:domain ex:WebResource ;
  rdfs:range ex:Organization .
ex:price_marketing_services_of a owl:ObjectProperty ;
  rdfs:domain ex:PriceMarketingServices ;
  rdfs:range ex:Organization .
ex:published_on a owl:ObjectProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:WebResource .
ex:available_on a owl:ObjectProperty ;
  rdfs:domain ex:Document ;
  rdfs:range ex:WebResource .
ex:available_via a owl:ObjectProperty ;
  rdfs:domain ex:Index ;
  rdfs:range ex:PriceMarketingServices .
ex:vendor_information_system a owl:ObjectProperty ;
  rdfs:domain ex:Vendor ;
  rdfs:range ex:InformationSystem .
ex:distribution_or_display_decision_for_vendor a owl:ObjectProperty ;
  rdfs:domain ex:VendorDistributionOrDisplayDecision ;
  rdfs:range ex:Vendor .
ex:distribution_or_display_decision_for_index a owl:ObjectProperty ;
  rdfs:domain ex:VendorDistributionOrDisplayDecision ;
  rdfs:range ex:Index .
ex:decision_on_individual_basis a owl:Class ; rdfs:subClassOf ex:VendorDistributionOrDisplayDecision .
ex:decision_via_information_system a owl:ObjectProperty ;
  rdfs:domain ex:VendorDistributionOrDisplayDecision ;
  rdfs:range ex:InformationSystem .
ex:publication_in_relation_to_index a owl:ObjectProperty ;
  rdfs:domain ex:IndexPublication ;
  rdfs:range ex:Index .
ex:notice_publication_in_relation_to_index a owl:ObjectProperty ;
  rdfs:domain ex:IndexPublication ;
  rdfs:range ex:Index .
ex:guideline_amendment_publication_in_relation_to_index a owl:Class, a4:NaryRelationClass .
ex:guideline_amendment_publication_in_relation_to_index_arg_0 a owl:ObjectProperty ;
  rdfs:domain ex:guideline_amendment_publication_in_relation_to_index ;
  rdfs:range ex:IndexPublication .
ex:guideline_amendment_publication_in_relation_to_index_arg_1 a owl:ObjectProperty ;
  rdfs:domain ex:guideline_amendment_publication_in_relation_to_index ;
  rdfs:range ex:Document .
ex:guideline_amendment_publication_in_relation_to_index_arg_2 a owl:ObjectProperty ;
  rdfs:domain ex:guideline_amendment_publication_in_relation_to_index ;
  rdfs:range ex:Index .
ex:available_at a owl:ObjectProperty ;
  rdfs:domain ex:IndexPublication ;
  rdfs:range ex:WebResource .

ex:PriceReturn ex:index_type_identifier ex:PR .
ex:NetTotalReturn ex:index_type_identifier ex:NTR .
ex:GrossTotalReturn ex:index_type_identifier ex:GTR .
ex:AdjustedReturnIndex ex:index_type_identifier ex:AR .
ex:SolactiveWebsite ex:website_of ex:Solactive .
ex:ASSERT_solactive_website a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(has_url(SolactiveWebsite, HttpsWwwSolactiveCom)) and (website_of(SolactiveWebsite, Solactive))" .
ex:EquityIndexMethodology ex:available_on ex:SolactiveWebsite .
ex:ASSERT_equity_index_methodology_location a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(document_url(EquityIndexMethodology, HttpsWwwSolactiveComDocumentsEquityIndexMethodology)) and (available_on(EquityIndexMethodology, SolactiveWebsite))" .
ex:ASSERT_section_4_location a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(part_of_document(Section4, Guideline)) and (document_part_locator(Section4, Section4Locator))" .
ex:IndexAdministratorAnnouncementsWebsite ex:website_of ex:Solactive .
ex:ASSERT_announcements_website a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(has_url(IndexAdministratorAnnouncementsWebsite, HttpsWwwSolactiveComNewsAnnouncements)) and (website_of(IndexAdministratorAnnouncementsWebsite, Solactive))" .
ex:BoerseStuttgartGmbHPriceMarketingServices ex:price_marketing_services_of ex:BoerseStuttgartGmbH .
