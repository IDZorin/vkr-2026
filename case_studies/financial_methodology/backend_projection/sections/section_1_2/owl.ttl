@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:section_1_2 a owl:Ontology .

ex:Index a owl:Class .
ex:IndexName a owl:Class .
ex:ISIN a owl:Class .
ex:RIC a owl:Class .
ex:BBGTicker a owl:Class .
ex:IndexType a owl:Class ; owl:oneOf ( ex:PriceReturn ex:NetTotalReturn ex:GrossTotalReturn ex:AdjustedReturnIndex ) .
ex:PriceReturn a ex:IndexType, owl:NamedIndividual .
ex:NetTotalReturn a ex:IndexType, owl:NamedIndividual .
ex:GrossTotalReturn a ex:IndexType, owl:NamedIndividual .
ex:AdjustedReturnIndex a ex:IndexType, owl:NamedIndividual .
ex:IndexTypeIdentifier a owl:Class ; owl:oneOf ( ex:PR ex:NTR ex:GTR ex:AR ) .
ex:PR a ex:IndexTypeIdentifier, owl:NamedIndividual .
ex:NTR a ex:IndexTypeIdentifier, owl:NamedIndividual .
ex:GTR a ex:IndexTypeIdentifier, owl:NamedIndividual .
ex:AR a ex:IndexTypeIdentifier, owl:NamedIndividual .
ex:IndexAdministrator a owl:Class .
ex:IndexAdministrator rdfs:subClassOf ex:Organization .
ex:PriceMarketingServices a owl:Class .
ex:Vendor a owl:Class .
ex:Vendor rdfs:subClassOf ex:Organization .
ex:AffiliatedVendor a owl:Class .
ex:AffiliatedVendor rdfs:subClassOf ex:Vendor .
ex:InformationSystem a owl:Class .
ex:VendorDistributionOrDisplayDecision a owl:Class .
ex:IndexPublication a owl:Class .

ex:Solactive a ex:IndexAdministrator, owl:NamedIndividual .
ex:BoerseStuttgartGmbH a ex:Organization, owl:NamedIndividual .
ex:BoerseStuttgartGmbHPriceMarketingServices a ex:PriceMarketingServices, owl:NamedIndividual .
ex:EUR a ex:Currency, owl:NamedIndividual .
