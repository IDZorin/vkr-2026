ex:ASSERT_section_1_3_index_scope a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "35"^^xsd:integer ;
  a4:exprText "(section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndexPR)) and (section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndexNTR)) and (section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndexTR)) and (section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndex50AR)) and (section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndex5PercentAR))" ;
  a4:sourceText "fact section_1_3_index_scope :\n  section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndexPR)\n  and section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndexNTR)\n  and section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndexTR)\n  and section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndex50AR)\n  and section_1_3_index(SolactiveTransatlanticCleanEnergyEURIndex5PercentAR)" .
ex:ASSERT_start_and_live_dates a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "42"^^xsd:integer ;
  a4:exprText "(start_date(StartDate05_08_2017)) and (live_date(LiveDate29_09_2025))" ;
  a4:sourceText "fact start_and_live_dates :\n  start_date(StartDate05_08_2017)\n  and live_date(LiveDate29_09_2025)" .
ex:ASSERT_article_8_of_bmr a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "46"^^xsd:integer ;
  a4:exprText "(part_of_document(Article8OfBMR, BMR)) and ((article_number(Article8OfBMR)) = (8))" ;
  a4:sourceText "fact article_8_of_bmr :\n  part_of_document(Article8OfBMR, BMR)\n  and article_number(Article8OfBMR) = 8" .
ex:ASSERT_initial_level_default_on_start_date a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "50"^^xsd:integer ;
  a4:exprText "forall i: Index, ((section_1_3_index(i)) and (not ((i) = (SolactiveTransatlanticCleanEnergyEURIndex50AR)))) implies ((initial_level(i, StartDate05_08_2017)) = (1000))" ;
  a4:sourceText "constraint initial_level_default_on_start_date :\n  forall i: Index,\n    section_1_3_index(i)\n    and i != SolactiveTransatlanticCleanEnergyEURIndex50AR\n    implies initial_level(i, StartDate05_08_2017) = 1000" .
ex:ASSERT_initial_level_50_ar_on_start_date a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "56"^^xsd:integer ;
  a4:exprText "(initial_level(SolactiveTransatlanticCleanEnergyEURIndex50AR, StartDate05_08_2017)) = (739.08)" ;
  a4:sourceText "fact initial_level_50_ar_on_start_date :\n  initial_level(SolactiveTransatlanticCleanEnergyEURIndex50AR, StartDate05_08_2017) = 739.08" .
ex:ASSERT_historical_values_from_live_date_recorded_in_accordance_with_article_8_of_bmr a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "59"^^xsd:integer ;
  a4:exprText "forall i: Index, forall d: Day, forall l: IndexLevel, ((section_1_3_index(i)) and (historical_value(l, i, d)) and (not (day_before(d, LiveDate29_09_2025)))) implies (recorded_in_accordance_with(l, Article8OfBMR))" ;
  a4:sourceText "constraint historical_values_from_live_date_recorded_in_accordance_with_article_8_of_bmr :\n  forall i: Index, forall d: Day, forall l: IndexLevel,\n    section_1_3_index(i)\n    and historical_value(l, i, d)\n    and not day_before(d, LiveDate29_09_2025)\n    implies recorded_in_accordance_with(l, Article8OfBMR)" .
ex:ASSERT_levels_published_prior_to_live_date_back_tested a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "66"^^xsd:integer ;
  a4:exprText "forall i: Index, forall p: Period, forall l: IndexLevel, ((section_1_3_index(i)) and (published_level_for_period(l, i, p)) and (period_prior_to(p, LiveDate29_09_2025))) implies (back_tested(l))" ;
  a4:sourceText "constraint levels_published_prior_to_live_date_back_tested :\n  forall i: Index, forall p: Period, forall l: IndexLevel,\n    section_1_3_index(i)\n    and published_level_for_period(l, i, p)\n    and period_prior_to(p, LiveDate29_09_2025)\n    implies back_tested(l)" .
