ex:section_1_3 a a4:ProjectionTarget ;
  a4:relativePath "sections/section_1_3/main_ir.a4v3" ;
  a4:targetKind "section" .

ex:Index a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:IndexLevel a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:IndexLevel rdfs:subClassOf ex:Real .
ex:ArticleNumber a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:ArticleNumber rdfs:subClassOf ex:Nat .

