@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:section_4_3 a owl:Ontology .

ex:Index a owl:Class .
ex:IndexLevel a owl:Class .
ex:IndexLevel rdfs:subClassOf ex:Real .
ex:RoundingPrecision a owl:Class .
ex:DecimalPlaceCount a owl:Class .
ex:DecimalPlaceCount rdfs:subClassOf ex:Nat .

ex:TheIndex a ex:Index, owl:NamedIndividual .
ex:TwoDecimalPlaces a ex:RoundingPrecision, owl:NamedIndividual .
ex:level_of_index a owl:ObjectProperty ;
  rdfs:domain ex:IndexLevel ;
  rdfs:range ex:Index .
ex:rounded_to_precision a owl:ObjectProperty ;
  rdfs:domain ex:IndexLevel ;
  rdfs:range ex:RoundingPrecision .
ex:decimal_place_count a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:RoundingPrecision ;
  rdfs:range ex:DecimalPlaceCount .

ex:TwoDecimalPlaces ex:decimal_place_count "2"^^xsd:integer .
ex:ASSERT_index_level_rounded_to_two_decimal_places a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall l: IndexLevel, (level_of_index(l, TheIndex)) implies (rounded_to_precision(l, TwoDecimalPlaces))" .
