@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:section_5_5 a a4:ProjectionTarget ;
  a4:relativePath "sections/section_5_5/main_ir.a4v3" ;
  a4:targetKind "section" .

ex:Index a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:IndexRule a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:Amendment a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:IndexRuleAmendment a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:IndexRuleAmendment rdfs:subClassOf ex:Amendment .
ex:GuidelineAmendment a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:GuidelineAmendment rdfs:subClassOf ex:Amendment .
ex:Committee a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:Committee rdfs:subClassOf ex:Organization .
ex:Staff a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:Subsidiary a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:Subsidiary rdfs:subClassOf ex:Organization .
ex:Approval a rdfs:Class, a4:Sort ;
  a4:declKind "opaque" .
ex:PriorApproval a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:PriorApproval rdfs:subClassOf ex:Approval .
ex:Policy a rdfs:Class, a4:Sort ;
  a4:declKind "subtype" .
ex:Policy rdfs:subClassOf ex:Document .

ex:Solactive a ex:Organization, owl:NamedIndividual .
ex:TheIndex a ex:Index, owl:NamedIndividual .
ex:Guideline a ex:Document, owl:NamedIndividual .
ex:MethodologyPolicy a ex:Policy, owl:NamedIndividual .
ex:OversightCommittee a ex:Committee, owl:NamedIndividual .
ex:OversightCommitteePriorApproval a ex:PriorApproval, owl:NamedIndividual .
ex:SolactiveWebsite a ex:WebResource, owl:NamedIndividual .
ex:HttpsWwwSolactiveComDocumentsMethodologyPolicy a ex:Url, owl:NamedIndividual .
