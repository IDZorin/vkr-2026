ex:ASSERT_methodology_policy_location a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "40"^^xsd:integer ;
  a4:exprText "(document_url(MethodologyPolicy, HttpsWwwSolactiveComDocumentsMethodologyPolicy)) and (available_on(MethodologyPolicy, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive))" ;
  a4:sourceText "fact methodology_policy_location :\n  document_url(MethodologyPolicy, HttpsWwwSolactiveComDocumentsMethodologyPolicy)\n  and available_on(MethodologyPolicy, SolactiveWebsite)\n  and website_of(SolactiveWebsite, Solactive)" .
ex:ASSERT_oversight_committee_has_staff a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "45"^^xsd:integer ;
  a4:exprText "exists s: Staff, composed_of(OversightCommittee, s)" ;
  a4:sourceText "fact oversight_committee_has_staff :\n  exists s: Staff,\n    composed_of(OversightCommittee, s)" .
ex:ASSERT_oversight_committee_prior_approval a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "49"^^xsd:integer ;
  a4:exprText "approval_by(OversightCommitteePriorApproval, OversightCommittee)" ;
  a4:sourceText "fact oversight_committee_prior_approval :\n  approval_by(OversightCommitteePriorApproval, OversightCommittee)" .
ex:ASSERT_oversight_committee_staff_from_solactive_or_subsidiary a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "52"^^xsd:integer ;
  a4:exprText "forall s: Staff, (composed_of(OversightCommittee, s)) implies ((staff_from(s, Solactive)) or (exists sub: Subsidiary, (subsidiary_of(sub, Solactive)) and (staff_from(s, sub))))" ;
  a4:sourceText "constraint oversight_committee_staff_from_solactive_or_subsidiary :\n  forall s: Staff,\n    composed_of(OversightCommittee, s)\n    implies\n      (\n        staff_from(s, Solactive)\n        or\n        exists sub: Subsidiary,\n          subsidiary_of(sub, Solactive)\n          and staff_from(s, sub)\n      )" .
ex:ASSERT_index_rule_amendment_scope a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "64"^^xsd:integer ;
  a4:exprText "forall a: IndexRuleAmendment, exists r: IndexRule, (amendment_of_rule(a, r)) and (rule_of(r, TheIndex))" ;
  a4:sourceText "constraint index_rule_amendment_scope :\n  forall a: IndexRuleAmendment,\n    exists r: IndexRule,\n      amendment_of_rule(a, r)\n      and rule_of(r, TheIndex)" .
ex:ASSERT_oversight_committee_responsible_for_index_rule_amendment_decisions a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "70"^^xsd:integer ;
  a4:exprText "forall a: IndexRuleAmendment, forall r: IndexRule, ((amendment_of_rule(a, r)) and (rule_of(r, TheIndex))) implies (responsible_for_decisions_regarding(OversightCommittee, a))" ;
  a4:sourceText "constraint oversight_committee_responsible_for_index_rule_amendment_decisions :\n  forall a: IndexRuleAmendment, forall r: IndexRule,\n    amendment_of_rule(a, r)\n    and rule_of(r, TheIndex)\n    implies responsible_for_decisions_regarding(OversightCommittee, a)" .
ex:ASSERT_index_rule_amendments_may_result_in_guideline_amendment a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "76"^^xsd:integer ;
  a4:exprText "forall a: IndexRuleAmendment, exists g: GuidelineAmendment, (may_result_in(a, g)) and (amendment_of_document(g, Guideline))" ;
  a4:sourceText "constraint index_rule_amendments_may_result_in_guideline_amendment :\n  forall a: IndexRuleAmendment,\n    exists g: GuidelineAmendment,\n      may_result_in(a, g)\n      and amendment_of_document(g, Guideline)" .
