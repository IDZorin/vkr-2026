ex:ASSERT_index_administrator_for_index a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "78"^^xsd:integer ;
  a4:exprText "index_administrator_of(TheIndexAdministrator, TheIndex)" ;
  a4:sourceText "fact index_administrator_for_index :\n  index_administrator_of(TheIndexAdministrator, TheIndex)" .
ex:ASSERT_described_method_reference a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "81"^^xsd:integer ;
  a4:exprText "(method_described_in(DescribedMethod, ThisDocument)) and (described_above(DescribedMethod))" ;
  a4:sourceText "fact described_method_reference :\n  method_described_in(DescribedMethod, ThisDocument)\n  and described_above(DescribedMethod)" .
ex:ASSERT_described_method_for_composition_and_calculation a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "85"^^xsd:integer ;
  a4:exprText "(method_for_index(DescribedMethod, TheIndex)) and (method_for_purpose(DescribedMethod, Composition)) and (method_for_purpose(DescribedMethod, Calculation))" ;
  a4:sourceText "fact described_method_for_composition_and_calculation :\n  method_for_index(DescribedMethod, TheIndex)\n  and method_for_purpose(DescribedMethod, Composition)\n  and method_for_purpose(DescribedMethod, Calculation)" .
ex:ASSERT_described_method_application_final_and_binding a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "90"^^xsd:integer ;
  a4:exprText "(application_by(DescribedMethodApplication, TheIndexAdministrator)) and (application_of_method(DescribedMethodApplication, DescribedMethod)) and (final(DescribedMethodApplication)) and (binding(DescribedMethodApplication))" ;
  a4:sourceText "fact described_method_application_final_and_binding :\n  application_by(DescribedMethodApplication, TheIndexAdministrator)\n  and application_of_method(DescribedMethodApplication, DescribedMethod)\n  and final(DescribedMethodApplication)\n  and binding(DescribedMethodApplication)" .
ex:ASSERT_index_terms_and_conditions a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "96"^^xsd:integer ;
  a4:exprText "terms_and_conditions_of(IndexTermsAndConditions, TheIndex)" ;
  a4:sourceText "fact index_terms_and_conditions :\n  terms_and_conditions_of(IndexTermsAndConditions, TheIndex)" .
ex:ASSERT_potential_method_change_reasons a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "99"^^xsd:integer ;
  a4:exprText "(potentially_requires_change_to_method(MarketEnvironment, DescribedMethod)) and (potentially_requires_change_to_method(SupervisoryReason, DescribedMethod)) and (potentially_requires_change_to_method(LegalReason, DescribedMethod)) and (potentially_requires_change_to_method(FinancialReason, DescribedMethod)) and (potentially_requires_change_to_method(TaxReason, DescribedMethod))" ;
  a4:sourceText "fact potential_method_change_reasons :\n  potentially_requires_change_to_method(MarketEnvironment, DescribedMethod)\n  and potentially_requires_change_to_method(SupervisoryReason, DescribedMethod)\n  and potentially_requires_change_to_method(LegalReason, DescribedMethod)\n  and potentially_requires_change_to_method(FinancialReason, DescribedMethod)\n  and potentially_requires_change_to_method(TaxReason, DescribedMethod)" .
ex:ASSERT_deemed_modification_or_change_scope a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "106"^^xsd:integer ;
  a4:exprText "forall ch: DeemedModificationOrChange, (modification_or_change_of_index(ch, TheIndex)) and ((change_to_terms_and_conditions(ch, IndexTermsAndConditions)) or (change_to_calculation_method(ch, calculation_method_applied(TheIndex)))) and (deemed_by(ch, TheIndexAdministrator, Necessary)) and (deemed_by(ch, TheIndexAdministrator, Desirable)) and ((exists e: Error, ((error_described_by(e, Obvious)) or (error_described_by(e, Demonstrable))) and (prevents_error(ch, e))) or ((incorrect_terms_and_conditions(IndexTermsAndConditions)) and ((remedies_terms_and_conditions(ch, IndexTermsAndConditions)) or (corrects_terms_and_conditions(ch, IndexTermsAndConditions)) or (supplements_terms_and_conditions(ch, IndexTermsAndConditions)))))" ;
  a4:sourceText "constraint deemed_modification_or_change_scope :\n  forall ch: DeemedModificationOrChange,\n    modification_or_change_of_index(ch, TheIndex)\n    and\n    (\n      change_to_terms_and_conditions(ch, IndexTermsAndConditions)\n      or\n      change_to_calculation_method(ch, calculation_method_applied(TheIndex))\n    )\n    and deemed_by(ch, TheIndexAdministrator, Necessary)\n    and deemed_by(ch, TheIndexAdministrator, Desirable)\n    and\n    (\n      (\n        exists e: Error,\n          (error_described_by(e, Obvious) or error_described_by(e, Demonstrable))\n          and prevents_error(ch, e)\n      )\n      or\n      (\n        incorrect_terms_and_conditions(IndexTermsAndConditions)\n        and\n        (\n          remedies_terms_and_conditions(ch, IndexTermsAndConditions)\n          or corrects_terms_and_conditions(ch, IndexTermsAndConditions)\n          or supplements_terms_and_conditions(ch, IndexTermsAndConditions)\n        )\n      )\n    )" .
ex:ASSERT_appropriate_steps_consistency_target a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "136"^^xsd:integer ;
  a4:exprText "(appropriate(AppropriateSteps)) and (step_ensures_consistency_with(AppropriateSteps, calculation_method_applied(TheIndex), DescribedMethod))" ;
  a4:sourceText "fact appropriate_steps_consistency_target :\n  appropriate(AppropriateSteps)\n  and step_ensures_consistency_with(\n    AppropriateSteps,\n    calculation_method_applied(TheIndex),\n    DescribedMethod\n  )" .
ex:ASSERT_information_withheld_means_information_not_provided a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "144"^^xsd:integer ;
  a4:exprText "forall a: IndexAdministrator, forall ch: ModificationOrChange, (information_withheld_on_modification_or_change(a, ch, ModificationOrChangeInformation)) iff (not (provide_information_on_modification_or_change(a, ch, ModificationOrChangeInformation)))" ;
  a4:sourceText "constraint information_withheld_means_information_not_provided :\n  forall a: IndexAdministrator, forall ch: ModificationOrChange,\n    information_withheld_on_modification_or_change(a, ch, ModificationOrChangeInformation)\n    iff not provide_information_on_modification_or_change(a, ch, ModificationOrChangeInformation)" .
