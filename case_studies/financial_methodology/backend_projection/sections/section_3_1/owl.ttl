@prefix ex: <http://example.org/a4v3#> .
@prefix a4: <http://example.org/a4v3/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:section_3_1 a owl:Ontology .

ex:Index a owl:Class .
ex:SolactiveOrganization a owl:Class .
ex:SolactiveOrganization rdfs:subClassOf ex:Organization .
ex:IndexComponent a owl:Class .
ex:IndexComponent rdfs:subClassOf ex:FinancialInstrument .
ex:SelectionDay a owl:Class .
ex:SelectionDay rdfs:subClassOf ex:Day .
ex:FixingDay a owl:Class .
ex:FixingDay rdfs:subClassOf ex:Day .
ex:RebalanceDay a owl:Class .
ex:RebalanceDay rdfs:subClassOf ex:Day .
ex:OrdinaryRebalance a owl:Class .
ex:OrdinaryRebalance rdfs:subClassOf ex:Event .
ex:CloseOfBusiness a owl:Class .
ex:CloseOfBusiness rdfs:subClassOf ex:Event .
ex:IndexComponentSelection a owl:Class .
ex:Shares a owl:Class .
ex:Weight a owl:Class .
ex:Weight rdfs:subClassOf ex:Percent .
ex:RebalanceProcedure a owl:Class .
ex:IndexComponentChange a owl:Class .
ex:IndexComponentChange rdfs:subClassOf ex:Event .
ex:Section3_1IndexComponentChange a owl:Class .
ex:Section3_1IndexComponentChange rdfs:subClassOf ex:IndexComponentChange .
ex:Notice a owl:Class .
ex:Notice rdfs:subClassOf ex:Document .
ex:EquityIndexMethodology a owl:Class .
ex:EquityIndexMethodology rdfs:subClassOf ex:Document .

ex:TheIndex a ex:Index, owl:NamedIndividual .
ex:Solactive a ex:SolactiveOrganization, owl:NamedIndividual .
ex:SolactiveEquityIndexMethodology a ex:EquityIndexMethodology, owl:NamedIndividual .
ex:ThisGuideline a ex:Document, owl:NamedIndividual .
ex:SolactiveWebsite a ex:WebResource, owl:NamedIndividual .
ex:Section2_1 a ex:DocumentPart, owl:NamedIndividual .
ex:Section2_2 a ex:DocumentPart, owl:NamedIndividual .
ex:AnnouncementSection a ex:DocumentPart, owl:NamedIndividual .
ex:OrdinaryRebalanceProcedure a ex:RebalanceProcedure, owl:NamedIndividual .
ex:SufficientNoticeBeforeRebalanceDay a ex:VagueTerm, owl:NamedIndividual .
ex:HttpsWwwSolactiveComDocumentsEquityIndexMethodology a ex:Url, owl:NamedIndividual .
ex:HttpsWwwSolactiveComNewsAnnouncements a ex:Url, owl:NamedIndividual .
ex:ordinary_rebalance_day a owl:Class ; rdfs:subClassOf ex:RebalanceDay .
ex:ordinary_rebalance_on_day a owl:ObjectProperty ;
  rdfs:domain ex:OrdinaryRebalance ;
  rdfs:range ex:RebalanceDay .
ex:selection_day_of_rebalance a owl:ObjectProperty ;
  rdfs:domain ex:RebalanceDay ;
  rdfs:range ex:SelectionDay .
ex:fixing_day_of_rebalance a owl:ObjectProperty ;
  rdfs:domain ex:RebalanceDay ;
  rdfs:range ex:FixingDay .
ex:close_of_business_on_day a owl:ObjectProperty ;
  rdfs:domain ex:CloseOfBusiness ;
  rdfs:range ex:RebalanceDay .
ex:new_selection_for_rebalance a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:RebalanceDay ;
  rdfs:range ex:IndexComponentSelection .
ex:shares_on_fixing_day a owl:Class, a4:NaryRelationClass .
ex:shares_on_fixing_day_arg_0 a owl:ObjectProperty ;
  rdfs:domain ex:shares_on_fixing_day ;
  rdfs:range ex:FixingDay .
ex:shares_on_fixing_day_arg_1 a owl:ObjectProperty ;
  rdfs:domain ex:shares_on_fixing_day ;
  rdfs:range ex:IndexComponent .
ex:shares_on_fixing_day_result a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:shares_on_fixing_day ;
  rdfs:range ex:Shares .
ex:weight_on_selection_day a owl:Class, a4:NaryRelationClass .
ex:weight_on_selection_day_arg_0 a owl:ObjectProperty ;
  rdfs:domain ex:weight_on_selection_day ;
  rdfs:range ex:SelectionDay .
ex:weight_on_selection_day_arg_1 a owl:ObjectProperty ;
  rdfs:domain ex:weight_on_selection_day ;
  rdfs:range ex:IndexComponent .
ex:weight_on_selection_day_result a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:weight_on_selection_day ;
  rdfs:range ex:Weight .
ex:rebalance_day_of_change a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain ex:Section3_1IndexComponentChange ;
  rdfs:range ex:RebalanceDay .
ex:selection_of_index a owl:ObjectProperty ;
  rdfs:domain ex:IndexComponentSelection ;
  rdfs:range ex:Index .
ex:selection_determined_on a owl:ObjectProperty ;
  rdfs:domain ex:IndexComponentSelection ;
  rdfs:range ex:SelectionDay .
ex:selection_in_accordance_with a owl:ObjectProperty ;
  rdfs:domain ex:IndexComponentSelection ;
  rdfs:range ex:DocumentPart .
ex:selection_includes_index_component a owl:ObjectProperty ;
  rdfs:domain ex:IndexComponentSelection ;
  rdfs:range ex:IndexComponent .
ex:adjusted_index a owl:ObjectProperty ;
  rdfs:domain ex:OrdinaryRebalance ;
  rdfs:range ex:Index .
ex:following_close_of_business a owl:ObjectProperty ;
  rdfs:domain ex:OrdinaryRebalance ;
  rdfs:range ex:CloseOfBusiness .
ex:reflects_new_selection a owl:ObjectProperty ;
  rdfs:domain ex:OrdinaryRebalance ;
  rdfs:range ex:IndexComponentSelection .
ex:carried_out_by_implementing_shares a owl:ObjectProperty ;
  rdfs:domain ex:OrdinaryRebalance ;
  rdfs:range ex:Shares .
ex:shares_determined_on a owl:ObjectProperty ;
  rdfs:domain ex:Shares ;
  rdfs:range ex:FixingDay .
ex:shares_based_on_weight a owl:ObjectProperty ;
  rdfs:domain ex:Shares ;
  rdfs:range ex:Weight .
ex:weight_calculated_on a owl:ObjectProperty ;
  rdfs:domain ex:Weight ;
  rdfs:range ex:SelectionDay .
ex:procedure_information_in a owl:ObjectProperty ;
  rdfs:domain ex:RebalanceProcedure ;
  rdfs:range ex:Document .
ex:incorporated_by_reference_into a owl:ObjectProperty ;
  rdfs:domain ex:Document ;
  rdfs:range ex:Document .
ex:available_on a owl:ObjectProperty ;
  rdfs:domain ex:Document ;
  rdfs:range ex:WebResource .
ex:website_of a owl:ObjectProperty ;
  rdfs:domain ex:WebResource ;
  rdfs:range ex:Organization .
ex:section_of_website a owl:ObjectProperty ;
  rdfs:domain ex:DocumentPart ;
  rdfs:range ex:WebResource .
ex:change_of_index a owl:ObjectProperty ;
  rdfs:domain ex:Section3_1IndexComponentChange ;
  rdfs:range ex:Index .
ex:change_made_to_index_component a owl:ObjectProperty ;
  rdfs:domain ex:Section3_1IndexComponentChange ;
  rdfs:range ex:IndexComponent .
ex:notice_for_index_component_change a owl:ObjectProperty ;
  rdfs:domain ex:Notice ;
  rdfs:range ex:Section3_1IndexComponentChange .
ex:notice_described_by a owl:ObjectProperty ;
  rdfs:domain ex:Notice ;
  rdfs:range ex:VagueTerm .
ex:notice_for_rebalance_day a owl:ObjectProperty ;
  rdfs:domain ex:Notice ;
  rdfs:range ex:RebalanceDay .
ex:notice_published_by a owl:ObjectProperty ;
  rdfs:domain ex:Notice ;
  rdfs:range ex:SolactiveOrganization .
ex:notice_published_on a owl:ObjectProperty ;
  rdfs:domain ex:Notice ;
  rdfs:range ex:WebResource .
ex:notice_published_under a owl:ObjectProperty ;
  rdfs:domain ex:Notice ;
  rdfs:range ex:DocumentPart .

ex:OrdinaryRebalanceProcedure ex:procedure_information_in ex:SolactiveEquityIndexMethodology .
ex:SolactiveEquityIndexMethodology ex:incorporated_by_reference_into ex:ThisGuideline .
ex:SolactiveEquityIndexMethodology ex:available_on ex:SolactiveWebsite .
ex:SolactiveWebsite ex:website_of ex:Solactive .
ex:ASSERT_more_information_refer_to_equity_index_methodology a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(procedure_information_in(OrdinaryRebalanceProcedure, SolactiveEquityIndexMethodology)) and (incorporated_by_reference_into(SolactiveEquityIndexMethodology, ThisGuideline)) and (available_on(SolactiveEquityIndexMethodology, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive)) and (document_url(SolactiveEquityIndexMethodology, HttpsWwwSolactiveComDocumentsEquityIndexMethodology))" .
ex:AnnouncementSection ex:section_of_website ex:SolactiveWebsite .
ex:ASSERT_announcement_section_location a a4:AssertionArtifact ;
  a4:assertionKind "fact" ;
  a4:exprText "(section_of_website(AnnouncementSection, SolactiveWebsite)) and (document_part_url(AnnouncementSection, HttpsWwwSolactiveComNewsAnnouncements))" .
ex:ASSERT_new_selection_determined_in_accordance_with_sections a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall rd: RebalanceDay, forall sd: SelectionDay, ((ordinary_rebalance_day(rd)) and (selection_day_of_rebalance(rd, sd))) implies ((selection_of_index(new_selection_for_rebalance(rd), TheIndex)) and (selection_determined_on(new_selection_for_rebalance(rd), sd)) and (selection_in_accordance_with(new_selection_for_rebalance(rd), Section2_1)) and (selection_in_accordance_with(new_selection_for_rebalance(rd), Section2_2)))" .
ex:ASSERT_ordinary_rebalance_adjusts_index_after_close_of_business a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall rd: RebalanceDay, (ordinary_rebalance_day(rd)) implies (exists r: OrdinaryRebalance, exists cob: CloseOfBusiness, (ordinary_rebalance_on_day(r, rd)) and (close_of_business_on_day(cob, rd)) and (occurs_on(r, rd)) and (adjusted_index(r, TheIndex)) and (following_close_of_business(r, cob)) and (reflects_new_selection(r, new_selection_for_rebalance(rd))))" .
ex:ASSERT_ordinary_rebalance_implements_fixing_day_shares a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall rd: RebalanceDay, forall fd: FixingDay, forall sd: SelectionDay, forall c: IndexComponent, ((ordinary_rebalance_day(rd)) and (fixing_day_of_rebalance(rd, fd)) and (selection_day_of_rebalance(rd, sd)) and (selection_includes_index_component(new_selection_for_rebalance(rd), c))) implies (exists r: OrdinaryRebalance, (ordinary_rebalance_on_day(r, rd)) and (carried_out_by_implementing_shares(r, shares_on_fixing_day(fd, c))) and (shares_determined_on(shares_on_fixing_day(fd, c), fd)) and (weight_calculated_on(weight_on_selection_day(sd, c), sd)) and (shares_based_on_weight(shares_on_fixing_day(fd, c), weight_on_selection_day(sd, c))))" .
ex:ASSERT_section_3_1_index_component_change_scope a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ch: Section3_1IndexComponentChange, (change_of_index(ch, TheIndex)) and (exists c: IndexComponent, change_made_to_index_component(ch, c))" .
ex:ASSERT_solactive_publishes_index_component_changes_with_notice a a4:AssertionArtifact ;
  a4:assertionKind "constraint" ;
  a4:exprText "forall ch: Section3_1IndexComponentChange, exists n: Notice, (notice_for_index_component_change(n, ch)) and (notice_described_by(n, SufficientNoticeBeforeRebalanceDay)) and (notice_for_rebalance_day(n, rebalance_day_of_change(ch))) and (notice_published_by(n, Solactive)) and (notice_published_on(n, SolactiveWebsite)) and (notice_published_under(n, AnnouncementSection))" .
