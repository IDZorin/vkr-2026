ex:ASSERT_more_information_refer_to_equity_index_methodology a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "83"^^xsd:integer ;
  a4:exprText "(procedure_information_in(OrdinaryRebalanceProcedure, SolactiveEquityIndexMethodology)) and (incorporated_by_reference_into(SolactiveEquityIndexMethodology, ThisGuideline)) and (available_on(SolactiveEquityIndexMethodology, SolactiveWebsite)) and (website_of(SolactiveWebsite, Solactive)) and (document_url(SolactiveEquityIndexMethodology, HttpsWwwSolactiveComDocumentsEquityIndexMethodology))" ;
  a4:sourceText "fact more_information_refer_to_equity_index_methodology :\n  procedure_information_in(OrdinaryRebalanceProcedure, SolactiveEquityIndexMethodology)\n  and incorporated_by_reference_into(SolactiveEquityIndexMethodology, ThisGuideline)\n  and available_on(SolactiveEquityIndexMethodology, SolactiveWebsite)\n  and website_of(SolactiveWebsite, Solactive)\n  and document_url(SolactiveEquityIndexMethodology, HttpsWwwSolactiveComDocumentsEquityIndexMethodology)" .
ex:ASSERT_announcement_section_location a a4:Assertion ;
  a4:assertionKind "fact" ;
  a4:lineNo "90"^^xsd:integer ;
  a4:exprText "(section_of_website(AnnouncementSection, SolactiveWebsite)) and (document_part_url(AnnouncementSection, HttpsWwwSolactiveComNewsAnnouncements))" ;
  a4:sourceText "fact announcement_section_location :\n  section_of_website(AnnouncementSection, SolactiveWebsite)\n  and document_part_url(AnnouncementSection, HttpsWwwSolactiveComNewsAnnouncements)" .
ex:ASSERT_new_selection_determined_in_accordance_with_sections a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "94"^^xsd:integer ;
  a4:exprText "forall rd: RebalanceDay, forall sd: SelectionDay, ((ordinary_rebalance_day(rd)) and (selection_day_of_rebalance(rd, sd))) implies ((selection_of_index(new_selection_for_rebalance(rd), TheIndex)) and (selection_determined_on(new_selection_for_rebalance(rd), sd)) and (selection_in_accordance_with(new_selection_for_rebalance(rd), Section2_1)) and (selection_in_accordance_with(new_selection_for_rebalance(rd), Section2_2)))" ;
  a4:sourceText "constraint new_selection_determined_in_accordance_with_sections :\n  forall rd: RebalanceDay,\n  forall sd: SelectionDay,\n    ordinary_rebalance_day(rd)\n    and selection_day_of_rebalance(rd, sd)\n    implies\n      selection_of_index(new_selection_for_rebalance(rd), TheIndex)\n      and selection_determined_on(new_selection_for_rebalance(rd), sd)\n      and selection_in_accordance_with(new_selection_for_rebalance(rd), Section2_1)\n      and selection_in_accordance_with(new_selection_for_rebalance(rd), Section2_2)" .
ex:ASSERT_ordinary_rebalance_adjusts_index_after_close_of_business a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "105"^^xsd:integer ;
  a4:exprText "forall rd: RebalanceDay, (ordinary_rebalance_day(rd)) implies (exists r: OrdinaryRebalance, exists cob: CloseOfBusiness, (ordinary_rebalance_on_day(r, rd)) and (close_of_business_on_day(cob, rd)) and (occurs_on(r, rd)) and (adjusted_index(r, TheIndex)) and (following_close_of_business(r, cob)) and (reflects_new_selection(r, new_selection_for_rebalance(rd))))" ;
  a4:sourceText "constraint ordinary_rebalance_adjusts_index_after_close_of_business :\n  forall rd: RebalanceDay,\n    ordinary_rebalance_day(rd)\n    implies\n      exists r: OrdinaryRebalance,\n      exists cob: CloseOfBusiness,\n        ordinary_rebalance_on_day(r, rd)\n        and close_of_business_on_day(cob, rd)\n        and occurs_on(r, rd)\n        and adjusted_index(r, TheIndex)\n        and following_close_of_business(r, cob)\n        and reflects_new_selection(r, new_selection_for_rebalance(rd))" .
ex:ASSERT_ordinary_rebalance_implements_fixing_day_shares a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "118"^^xsd:integer ;
  a4:exprText "forall rd: RebalanceDay, forall fd: FixingDay, forall sd: SelectionDay, forall c: IndexComponent, ((ordinary_rebalance_day(rd)) and (fixing_day_of_rebalance(rd, fd)) and (selection_day_of_rebalance(rd, sd)) and (selection_includes_index_component(new_selection_for_rebalance(rd), c))) implies (exists r: OrdinaryRebalance, (ordinary_rebalance_on_day(r, rd)) and (carried_out_by_implementing_shares(r, shares_on_fixing_day(fd, c))) and (shares_determined_on(shares_on_fixing_day(fd, c), fd)) and (weight_calculated_on(weight_on_selection_day(sd, c), sd)) and (shares_based_on_weight(shares_on_fixing_day(fd, c), weight_on_selection_day(sd, c))))" ;
  a4:sourceText "constraint ordinary_rebalance_implements_fixing_day_shares :\n  forall rd: RebalanceDay,\n  forall fd: FixingDay,\n  forall sd: SelectionDay,\n  forall c: IndexComponent,\n    ordinary_rebalance_day(rd)\n    and fixing_day_of_rebalance(rd, fd)\n    and selection_day_of_rebalance(rd, sd)\n    and selection_includes_index_component(new_selection_for_rebalance(rd), c)\n    implies\n      exists r: OrdinaryRebalance,\n        ordinary_rebalance_on_day(r, rd)\n        and carried_out_by_implementing_shares(r, shares_on_fixing_day(fd, c))\n        and shares_determined_on(shares_on_fixing_day(fd, c), fd)\n        and weight_calculated_on(weight_on_selection_day(sd, c), sd)\n        and shares_based_on_weight(\n          shares_on_fixing_day(fd, c),\n          weight_on_selection_day(sd, c)\n        )" .
ex:ASSERT_section_3_1_index_component_change_scope a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "138"^^xsd:integer ;
  a4:exprText "forall ch: Section3_1IndexComponentChange, (change_of_index(ch, TheIndex)) and (exists c: IndexComponent, change_made_to_index_component(ch, c))" ;
  a4:sourceText "constraint section_3_1_index_component_change_scope :\n  forall ch: Section3_1IndexComponentChange,\n    change_of_index(ch, TheIndex)\n    and exists c: IndexComponent,\n      change_made_to_index_component(ch, c)" .
ex:ASSERT_solactive_publishes_index_component_changes_with_notice a a4:Assertion ;
  a4:assertionKind "constraint" ;
  a4:lineNo "144"^^xsd:integer ;
  a4:exprText "forall ch: Section3_1IndexComponentChange, exists n: Notice, (notice_for_index_component_change(n, ch)) and (notice_described_by(n, SufficientNoticeBeforeRebalanceDay)) and (notice_for_rebalance_day(n, rebalance_day_of_change(ch))) and (notice_published_by(n, Solactive)) and (notice_published_on(n, SolactiveWebsite)) and (notice_published_under(n, AnnouncementSection))" ;
  a4:sourceText "constraint solactive_publishes_index_component_changes_with_notice :\n  forall ch: Section3_1IndexComponentChange,\n    exists n: Notice,\n      notice_for_index_component_change(n, ch)\n      and notice_described_by(n, SufficientNoticeBeforeRebalanceDay)\n      and notice_for_rebalance_day(n, rebalance_day_of_change(ch))\n      and notice_published_by(n, Solactive)\n      and notice_published_on(n, SolactiveWebsite)\n      and notice_published_under(n, AnnouncementSection)" .
