fact canonical_index_variants :
  variant_of_index_family(SolactiveTransatlanticCleanEnergyEURIndexPR, SolactiveTransatlanticCleanEnergyEURIndexFamily)
  and variant_of_index_family(SolactiveTransatlanticCleanEnergyEURIndexNTR, SolactiveTransatlanticCleanEnergyEURIndexFamily)
  and variant_of_index_family(SolactiveTransatlanticCleanEnergyEURIndexTR, SolactiveTransatlanticCleanEnergyEURIndexFamily)
  and variant_of_index_family(SolactiveTransatlanticCleanEnergyEURIndex5PercentAR, SolactiveTransatlanticCleanEnergyEURIndexFamily)
  and variant_of_index_family(SolactiveTransatlanticCleanEnergyEURIndex50AR, SolactiveTransatlanticCleanEnergyEURIndexFamily)
  and return_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndexPR, PriceReturn)
  and return_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndexNTR, NetTotalReturn)
  and return_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndexTR, GrossTotalReturn)
  and return_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndex5PercentAR, AdjustedReturn)
  and return_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndex50AR, AdjustedReturn)
  and decrement_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndexPR, NoDecrement)
  and decrement_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndexNTR, NoDecrement)
  and decrement_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndexTR, NoDecrement)
  and decrement_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndex5PercentAR, FivePercentAnnualDecrement)
  and decrement_treatment_of_variant(SolactiveTransatlanticCleanEnergyEURIndex50AR, NoDecrement)

fact generic_methodology_rules_apply_to_published_variants :
  generic_index_rule_applies_to_variant(SolactiveTransatlanticCleanEnergyEURIndexFamily, SolactiveTransatlanticCleanEnergyEURIndexPR)
  and generic_index_rule_applies_to_variant(SolactiveTransatlanticCleanEnergyEURIndexFamily, SolactiveTransatlanticCleanEnergyEURIndexNTR)
  and generic_index_rule_applies_to_variant(SolactiveTransatlanticCleanEnergyEURIndexFamily, SolactiveTransatlanticCleanEnergyEURIndexTR)
  and generic_index_rule_applies_to_variant(SolactiveTransatlanticCleanEnergyEURIndexFamily, SolactiveTransatlanticCleanEnergyEURIndex5PercentAR)
  and generic_index_rule_applies_to_variant(SolactiveTransatlanticCleanEnergyEURIndexFamily, SolactiveTransatlanticCleanEnergyEURIndex50AR)

fact canonical_document_infrastructure :
  administered_by(SolactiveTransatlanticCleanEnergyEURIndexFamily, Solactive)
  and methodology_of_index_family(CanonicalEquityIndexMethodology, SolactiveTransatlanticCleanEnergyEURIndexFamily)
  and website_of(SolactiveWebsite, Solactive)
  and section_of_website(AnnouncementSection, SolactiveWebsite)
  and incorporated_by_reference_into(CanonicalEquityIndexMethodology, ThisGuideline)
  and incorporated_by_reference_into(CanonicalSolactiveMethodologyPolicy, ThisGuideline)
  and incorporated_by_reference_into(CanonicalSolactiveCorrectionPolicy, ThisGuideline)
  and incorporated_by_reference_into(CanonicalSolactiveDisruptionPolicy, ThisGuideline)
  and available_on(CanonicalEquityIndexMethodology, SolactiveWebsite)
  and available_on(CanonicalSolactiveMethodologyPolicy, SolactiveWebsite)
  and available_on(CanonicalSolactiveCorrectionPolicy, SolactiveWebsite)
  and available_on(CanonicalSolactiveDisruptionPolicy, SolactiveWebsite)

