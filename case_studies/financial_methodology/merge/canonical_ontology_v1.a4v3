-- seed methodology canonical ontology v1.
-- This file is a merge-preparation ontology, not a source-local section IR.
-- Local main_ir.a4v3 files remain the source-faithful gold translations.

sort CanonicalConcept
sort CanonicalSort extends CanonicalConcept
sort CanonicalEntity extends CanonicalConcept
sort CanonicalRelation extends CanonicalConcept
sort CanonicalFunction extends CanonicalConcept
sort CanonicalFrame extends CanonicalConcept
sort CanonicalRole extends CanonicalConcept
sort CanonicalDecisionStatus =
  Accepted
| NeedsHumanReview
| FutureRefinement

sort CanonicalScope =
  AppliesToIndexFamily
| AppliesToIndexVariant
| AppliesToLocalPlaceholder
| AppliesToDocumentInfrastructure
| AppliesToDefinitionPointer

sort IndexFamily
sort Index
sort IndexVariant extends Index
sort PublishedIndexVariant extends IndexVariant
sort ReturnTreatment =
  PriceReturn
| NetTotalReturn
| GrossTotalReturn
| AdjustedReturn
sort DecrementTreatment =
  NoDecrement
| FivePercentAnnualDecrement

sort Security extends FinancialInstrument
sort ShareClass extends Security
sort IndexComponentRoleAssignment
