(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort DataVendor 0)
(declare-sort Day 0)
(declare-sort FinancialInstrument 0)
(declare-sort Share 0)
(declare-sort ShareClass 0)

(declare-fun Fraction (Real) Bool)
(declare-fun FreeFloat (Real) Bool)
(declare-fun Security (FinancialInstrument) Bool)
(declare-fun SelectionDay (Day) Bool)
(declare-fun ShareCount (Int) Bool)

(assert (! (forall ((x_FreeFloat Real)) (=> (FreeFloat x_FreeFloat) (Fraction x_FreeFloat))) :named TYPE_FreeFloat_extends_Fraction))

(declare-fun available_for_trading_by_market_participants (Day Share) Bool)
(declare-fun free_float (Day FinancialInstrument) Real)
(declare-fun free_float_denominator (Real) Int)
(declare-fun free_float_numerator (Real) Int)
(declare-fun fulfills_index_component_requirements (Day FinancialInstrument) Bool)
(declare-fun issued_share_on_selection_day (Day Share) Bool)
(declare-fun locked_in_by_long_term_holders (Day Share) Bool)
(declare-fun share_class (Day FinancialInstrument) ShareClass)
(declare-fun share_of_share_class (Share ShareClass) Bool)
(declare-fun sourced_from_data_vendor (Real DataVendor) Bool)

(assert (! (forall ((available_for_trading_by_market_participants_arg0 Day) (available_for_trading_by_market_participants_arg1 Share)) (=> (available_for_trading_by_market_participants available_for_trading_by_market_participants_arg0 available_for_trading_by_market_participants_arg1) (SelectionDay available_for_trading_by_market_participants_arg0))) :named TYPE_symbol_available_for_trading_by_market_participants))
(assert (! (forall ((free_float_arg0 Day) (free_float_arg1 FinancialInstrument)) (FreeFloat (free_float free_float_arg0 free_float_arg1))) :named TYPE_symbol_free_float))
(assert (! (forall ((free_float_denominator_arg0 Real)) (ShareCount (free_float_denominator free_float_denominator_arg0))) :named TYPE_symbol_free_float_denominator))
(assert (! (forall ((free_float_numerator_arg0 Real)) (ShareCount (free_float_numerator free_float_numerator_arg0))) :named TYPE_symbol_free_float_numerator))
(assert (! (forall ((fulfills_index_component_requirements_arg0 Day) (fulfills_index_component_requirements_arg1 FinancialInstrument)) (=> (fulfills_index_component_requirements fulfills_index_component_requirements_arg0 fulfills_index_component_requirements_arg1) (and (SelectionDay fulfills_index_component_requirements_arg0) (Security fulfills_index_component_requirements_arg1)))) :named TYPE_symbol_fulfills_index_component_requirements))
(assert (! (forall ((issued_share_on_selection_day_arg0 Day) (issued_share_on_selection_day_arg1 Share)) (=> (issued_share_on_selection_day issued_share_on_selection_day_arg0 issued_share_on_selection_day_arg1) (SelectionDay issued_share_on_selection_day_arg0))) :named TYPE_symbol_issued_share_on_selection_day))
(assert (! (forall ((locked_in_by_long_term_holders_arg0 Day) (locked_in_by_long_term_holders_arg1 Share)) (=> (locked_in_by_long_term_holders locked_in_by_long_term_holders_arg0 locked_in_by_long_term_holders_arg1) (SelectionDay locked_in_by_long_term_holders_arg0))) :named TYPE_symbol_locked_in_by_long_term_holders))
(assert (! (forall ((sourced_from_data_vendor_arg0 Real) (sourced_from_data_vendor_arg1 DataVendor)) (=> (sourced_from_data_vendor sourced_from_data_vendor_arg0 sourced_from_data_vendor_arg1) (FreeFloat sourced_from_data_vendor_arg0))) :named TYPE_symbol_sourced_from_data_vendor))
(check-sat)
