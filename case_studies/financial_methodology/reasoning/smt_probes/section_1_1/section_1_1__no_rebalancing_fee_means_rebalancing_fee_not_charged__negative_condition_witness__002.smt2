(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort AssetClass 0)
(declare-sort BusinessField 0)
(declare-sort Index 0)
(declare-sort IndexStrategy 0)
(declare-sort RebalancingFeeStatus 0)
(declare-sort RebalancingFrequency 0)
(declare-sort RegionalAllocation 0)
(declare-sort Security 0)

(declare-const Canada RegionalAllocation)
(declare-const CleanEnergy BusinessField)
(declare-const CleanEnergyBusinessOperationsStrategy IndexStrategy)
(declare-const DevelopedMarketsEurope RegionalAllocation)
(declare-const Equity AssetClass)
(declare-const NoRebalancingFee RebalancingFeeStatus)
(declare-const SemiAnnual RebalancingFrequency)
(declare-const TheIndex Index)
(declare-const UnitedStates RegionalAllocation)

(assert (! (distinct DevelopedMarketsEurope UnitedStates Canada) :named TYPE_enum_distinct_RegionalAllocation))

(declare-fun asset_class (Index) AssetClass)
(declare-fun index_strategy (Index IndexStrategy) Bool)
(declare-fun rebalancing_fee_charged (Index) Bool)
(declare-fun rebalancing_fee_status (Index) RebalancingFeeStatus)
(declare-fun rebalancing_frequency (Index) RebalancingFrequency)
(declare-fun regional_allocation (Index RegionalAllocation) Bool)
(declare-fun security_has_business_operations_in (Security BusinessField) Bool)
(declare-fun strategy_representation_of_security (IndexStrategy Security) Bool)

(assert (! (and (= (asset_class TheIndex) Equity) (index_strategy TheIndex CleanEnergyBusinessOperationsStrategy) (regional_allocation TheIndex DevelopedMarketsEurope) (regional_allocation TheIndex UnitedStates) (regional_allocation TheIndex Canada) (= (rebalancing_fee_status TheIndex) NoRebalancingFee) (= (rebalancing_frequency TheIndex) SemiAnnual)) :named TEXT_index_scope_table_attributes))
(assert (! (forall ((s Security)) (=> (strategy_representation_of_security CleanEnergyBusinessOperationsStrategy s) (security_has_business_operations_in s CleanEnergy))) :named TEXT_clean_energy_strategy_represents_clean_energy_securities))
(assert (! (forall ((i Index)) (=> (= (rebalancing_fee_status i) NoRebalancingFee) (not (rebalancing_fee_charged i)))) :named TEXT_no_rebalancing_fee_means_rebalancing_fee_not_charged))
; Probe section_1_1__no_rebalancing_fee_means_rebalancing_fee_not_charged__negative_condition_witness__002: negative_condition_witness
(check-sat)
(push 1)
(assert (! (exists ((i Index)) (not (rebalancing_fee_charged i))) :named PROBE_section_1_1__no_rebalancing_fee_means_rebalancing_fee_not_charged__negative_condition_witness__002))
(check-sat)
(pop 1)
