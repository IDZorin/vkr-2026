(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort Cessation 0)
(declare-sort CessationSituation 0)
(declare-sort Document 0)
(declare-sort DocumentLocator 0)
(declare-sort DocumentPart 0)
(declare-sort EconomicReality 0)
(declare-sort Effort 0)
(declare-sort FinancialContract 0)
(declare-sort FinancialInstrument 0)
(declare-sort Guidelines 0)
(declare-sort Index 0)
(declare-sort IndexMethodology 0)
(declare-sort IndexQuality 0)
(declare-sort IndexRule 0)
(declare-sort InvestmentFund 0)
(declare-sort Option 0)
(declare-sort Organization 0)
(declare-sort Procedure 0)
(declare-sort Stakeholder 0)
(declare-sort UnderlyingMarket 0)
(declare-sort Url 0)
(declare-sort VagueTerm 0)
(declare-sort WebResource 0)

(declare-fun AlternativeIndex (Index) Bool)
(declare-fun SelectionCriteria (IndexRule) Bool)
(declare-fun TerminationPolicy (Document) Bool)

(declare-const Comparability IndexQuality)
(declare-const ContinuedIntegrity IndexQuality)
(declare-const ContinuedReliability IndexQuality)
(declare-const HttpsWwwSolactiveComDocumentsTerminationPolicy Url)
(declare-const Resilience IndexQuality)
(declare-const Section5_2MethodologyReview DocumentPart)
(declare-const Section5_2MethodologyReviewLocator DocumentLocator)
(declare-const Solactive Organization)
(declare-const SolactiveCessationGuidelines Guidelines)
(declare-const SolactiveGreatestPossibleEfforts Effort)
(declare-const SolactiveTerminationPolicy Document)
(declare-const SolactiveWebsite WebResource)
(declare-const Stakeholders Stakeholder)
(declare-const Substantially VagueTerm)

(assert (! (TerminationPolicy SolactiveTerminationPolicy) :named TYPE_entity_SolactiveTerminationPolicy))
(assert (! (distinct Resilience ContinuedIntegrity ContinuedReliability Comparability) :named TYPE_enum_distinct_IndexQuality))

(declare-fun adapts_index_methodology (Procedure IndexMethodology UnderlyingMarket) Bool)
(declare-fun applied_coherently (IndexRule Index) Bool)
(declare-fun available_on (Document WebResource) Bool)
(declare-fun available_option_for_index (Option Index) Bool)
(declare-fun changing_underlying_market (UnderlyingMarket) Bool)
(declare-fun clear (Guidelines) Bool)
(declare-fun clearly_defined (Procedure) Bool)
(declare-fun details_specified_in (Guidelines Document) Bool)
(declare-fun economic_reality_change_described_by (EconomicReality VagueTerm) Bool)
(declare-fun economic_reality_change_foreseeable_at_inception (EconomicReality Index) Bool)
(declare-fun economic_reality_changes (EconomicReality) Bool)
(declare-fun effort_by (Effort Organization) Bool)
(declare-fun effort_to_ensure (Effort Index IndexQuality) Bool)
(declare-fun established_by (Guidelines Organization) Bool)
(declare-fun follows (Organization Procedure) Bool)
(declare-fun greatest_possible (Effort) Bool)
(declare-fun guidelines_identify (Guidelines CessationSituation) Bool)
(declare-fun incorporated_by_reference (Document) Bool)
(declare-fun index_of (Index Organization) Bool)
(declare-fun index_set_to_measure_economic_reality (Index EconomicReality) Bool)
(declare-fun index_set_to_measure_underlying_market (Index UnderlyingMarket) Bool)
(declare-fun index_set_to_reflect_economic_reality (Index EconomicReality) Bool)
(declare-fun index_set_to_reflect_underlying_market (Index UnderlyingMarket) Bool)
(declare-fun maintained_by (Guidelines Organization) Bool)
(declare-fun methodology_of_index (IndexMethodology Index) Bool)
(declare-fun necessary_to_adapt_methodology (IndexMethodology UnderlyingMarket) Bool)
(declare-fun orderly_cessation_indication_available (Index) Bool)
(declare-fun over_time (Effort) Bool)
(declare-fun procedure_for_consulting (Procedure Stakeholder) Bool)
(declare-fun procedure_for_informing (Procedure Stakeholder) Bool)
(declare-fun procedure_for_termination (Procedure) Bool)
(declare-fun procedure_for_transition_to_alternative_index (Procedure Index) Bool)
(declare-fun procedure_in_guidelines (Guidelines Procedure) Bool)
(declare-fun procedure_maintains (Procedure Index IndexQuality) Bool)
(declare-fun rule_of_index (IndexRule Index) Bool)
(declare-fun see (Procedure DocumentPart) Bool)
(declare-fun transparent (Procedure) Bool)
(declare-fun unavoidable (CessationSituation) Bool)
(declare-fun underlying_market_change_described_by (UnderlyingMarket VagueTerm) Bool)
(declare-fun underlying_market_change_foreseeable_at_inception (UnderlyingMarket Index) Bool)
(declare-fun underlying_market_changes (UnderlyingMarket) Bool)
(declare-fun used_as_underlying_value_for_financial_contract (Index FinancialContract) Bool)
(declare-fun used_as_underlying_value_for_financial_instrument (Index FinancialInstrument) Bool)
(declare-fun used_as_underlying_value_for_investment_fund (Index InvestmentFund) Bool)
(declare-fun usual_case_for_cessation (Index) Bool)
(declare-fun website_of (WebResource Organization) Bool)

(assert (! (forall ((details_specified_in_arg0 Guidelines) (details_specified_in_arg1 Document)) (=> (details_specified_in details_specified_in_arg0 details_specified_in_arg1) (TerminationPolicy details_specified_in_arg1))) :named TYPE_symbol_details_specified_in))
(assert (! (forall ((incorporated_by_reference_arg0 Document)) (=> (incorporated_by_reference incorporated_by_reference_arg0) (TerminationPolicy incorporated_by_reference_arg0))) :named TYPE_symbol_incorporated_by_reference))
(assert (! (forall ((procedure_for_transition_to_alternative_index_arg0 Procedure) (procedure_for_transition_to_alternative_index_arg1 Index)) (=> (procedure_for_transition_to_alternative_index procedure_for_transition_to_alternative_index_arg0 procedure_for_transition_to_alternative_index_arg1) (AlternativeIndex procedure_for_transition_to_alternative_index_arg1))) :named TYPE_symbol_procedure_for_transition_to_alternative_index))

(assert (! (and (effort_by SolactiveGreatestPossibleEfforts Solactive) (greatest_possible SolactiveGreatestPossibleEfforts) (over_time SolactiveGreatestPossibleEfforts)) :named TEXT_solactive_effort))
(assert (! (forall ((i Index)) (=> (index_of i Solactive) (and (effort_to_ensure SolactiveGreatestPossibleEfforts i Resilience) (effort_to_ensure SolactiveGreatestPossibleEfforts i ContinuedIntegrity)))) :named TEXT_solactive_efforts_for_resilience_and_integrity))
(assert (! (forall ((i Index)) (forall ((m IndexMethodology)) (forall ((u UnderlyingMarket)) (=> (and (index_of i Solactive) (methodology_of_index m i) (necessary_to_adapt_methodology m u) (changing_underlying_market u)) (exists ((p Procedure)) (and (follows Solactive p) (clearly_defined p) (transparent p) (adapts_index_methodology p m u) (procedure_maintains p i ContinuedReliability) (procedure_maintains p i Comparability) (see p Section5_2MethodologyReview))))))) :named TEXT_methodology_adaptation_where_necessary))
(assert (! (forall ((i Index)) (=> (exists ((u UnderlyingMarket)) (and (or (index_set_to_measure_underlying_market i u) (index_set_to_reflect_underlying_market i u)) (underlying_market_changes u) (underlying_market_change_described_by u Substantially) (not (underlying_market_change_foreseeable_at_inception u i)))) (usual_case_for_cessation i))) :named TEXT_cessation_usual_when_underlying_market_changes))
(assert (! (forall ((i Index)) (=> (exists ((e EconomicReality)) (and (or (index_set_to_measure_economic_reality i e) (index_set_to_reflect_economic_reality i e)) (economic_reality_changes e) (economic_reality_change_described_by e Substantially) (not (economic_reality_change_foreseeable_at_inception e i)))) (usual_case_for_cessation i))) :named TEXT_cessation_usual_when_economic_reality_changes))
(assert (! (forall ((i Index)) (=> (exists ((r IndexRule)) (and (rule_of_index r i) (not (applied_coherently r i)))) (usual_case_for_cessation i))) :named TEXT_cessation_usual_when_rules_not_applied_coherently))
(assert (! (forall ((i Index)) (=> (exists ((sc IndexRule)) (and (SelectionCriteria sc) (and (rule_of_index sc i) (not (applied_coherently sc i))))) (usual_case_for_cessation i))) :named TEXT_cessation_usual_when_selection_criteria_not_applied_coherently))
(assert (! (forall ((i Index)) (=> (and (not (exists ((fi FinancialInstrument)) (used_as_underlying_value_for_financial_instrument i fi))) (not (exists ((f InvestmentFund)) (used_as_underlying_value_for_investment_fund i f))) (not (exists ((c FinancialContract)) (used_as_underlying_value_for_financial_contract i c)))) (usual_case_for_cessation i))) :named TEXT_cessation_usual_when_index_not_used_as_underlying_value))
(assert (! (and (established_by SolactiveCessationGuidelines Solactive) (maintained_by SolactiveCessationGuidelines Solactive) (clear SolactiveCessationGuidelines)) :named TEXT_solactive_cessation_guidelines))
(assert (! (forall ((s CessationSituation)) (=> (guidelines_identify SolactiveCessationGuidelines s) (unavoidable s))) :named TEXT_guidelines_identify_unavoidable_cessation_situations))
(assert (! (exists ((p Procedure)) (and (procedure_in_guidelines SolactiveCessationGuidelines p) (procedure_for_informing p Stakeholders) (exists ((q Procedure)) (and (procedure_in_guidelines SolactiveCessationGuidelines q) (procedure_for_consulting q Stakeholders))))) :named TEXT_guidelines_include_stakeholder_information_and_consultation_procedures))
(assert (! (exists ((p Procedure)) (and (procedure_in_guidelines SolactiveCessationGuidelines p) (procedure_for_termination p))) :named TEXT_guidelines_include_termination_procedure))
(assert (! (exists ((p Procedure)) (exists ((a Index)) (and (AlternativeIndex a) (and (procedure_in_guidelines SolactiveCessationGuidelines p) (procedure_for_transition_to_alternative_index p a))))) :named TEXT_guidelines_include_transition_procedure))
(assert (! (and (details_specified_in SolactiveCessationGuidelines SolactiveTerminationPolicy) (incorporated_by_reference SolactiveTerminationPolicy)) :named TEXT_termination_policy_details))
(check-sat)
