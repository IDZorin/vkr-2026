(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort Day 0)
(declare-sort Document 0)
(declare-sort DocumentPart 0)
(declare-sort Event 0)
(declare-sort FinancialInstrument 0)
(declare-sort Index 0)
(declare-sort IndexAdjustment 0)
(declare-sort IndexAdjustmentEffect 0)
(declare-sort IndexAdjustmentPossibility 0)
(declare-sort NoticePeriod 0)
(declare-sort Organization 0)
(declare-sort RebalanceInterval 0)
(declare-sort VagueTerm 0)
(declare-sort WebResource 0)

(declare-fun CorporateAction (Event) Bool)
(declare-fun EffectiveDay (Day) Bool)
(declare-fun EquityIndexMethodology (Document) Bool)
(declare-fun IndexComponent (FinancialInstrument) Bool)
(declare-fun Notice (Document) Bool)
(declare-fun RebalanceDay (Day) Bool)
(declare-fun RegularRebalanceDay (Day) Bool)
(declare-fun RequiredIndexAdjustment (IndexAdjustment) Bool)
(declare-fun SolactiveOrganization (Organization) Bool)
(declare-fun TradingDay (Day) Bool)

(assert (! (forall ((x_RegularRebalanceDay Day)) (=> (RegularRebalanceDay x_RegularRebalanceDay) (RebalanceDay x_RegularRebalanceDay))) :named TYPE_RegularRebalanceDay_extends_RebalanceDay))

(declare-const AnnouncementsSection DocumentPart)
(declare-const CertainCircumstances VagueTerm)
(declare-const CertainIndexComponents VagueTerm)
(declare-const ComponentNumberEffect IndexAdjustmentEffect)
(declare-const ComponentRelationEffect IndexAdjustmentEffect)
(declare-const ComponentWeightingEffect IndexAdjustmentEffect)
(declare-const MayBeNecessary VagueTerm)
(declare-const MayHaveToBeDone VagueTerm)
(declare-const Section4_4Below DocumentPart)
(declare-const Solactive Organization)
(declare-const SolactiveEquityIndexMethodology Document)
(declare-const SolactiveWebsite WebResource)
(declare-const TheIndex Index)
(declare-const ThisGuideline Document)

(assert (! (SolactiveOrganization Solactive) :named TYPE_entity_Solactive))
(assert (! (EquityIndexMethodology SolactiveEquityIndexMethodology) :named TYPE_entity_SolactiveEquityIndexMethodology))
(assert (! (distinct ComponentRelationEffect ComponentNumberEffect ComponentWeightingEffect) :named TYPE_enum_distinct_IndexAdjustmentEffect))

(declare-fun adjustment_between_interval (IndexAdjustment RebalanceInterval) Bool)
(declare-fun adjustment_effect_described_by (IndexAdjustmentEffect VagueTerm) Bool)
(declare-fun adjustment_effect_scope_described_by (IndexAdjustment VagueTerm) Bool)
(declare-fun adjustment_of_index (IndexAdjustment Index) Bool)
(declare-fun adjustment_possibility_between_interval (IndexAdjustmentPossibility RebalanceInterval) Bool)
(declare-fun adjustment_possibility_described_by (IndexAdjustmentPossibility VagueTerm) Bool)
(declare-fun adjustment_possibility_of_index (IndexAdjustmentPossibility Index) Bool)
(declare-fun adjustment_required_due_to_corporate_action (IndexAdjustment Event) Bool)
(declare-fun affected_index_component (IndexAdjustment FinancialInstrument) Bool)
(declare-fun announced_by (Document Organization) Bool)
(declare-fun announced_on (Document WebResource) Bool)
(declare-fun announced_under_section (Document DocumentPart) Bool)
(declare-fun available_on (Document WebResource) Bool)
(declare-fun corporate_action_in_relation_to_component (Event FinancialInstrument) Bool)
(declare-fun effective_day_specified_in_respective_notice (Document) Day)
(declare-fun implemented_on (IndexAdjustment Day) Bool)
(declare-fun incorporated_by_reference_into (Document Document) Bool)
(declare-fun interval_end_rebalance_day (RebalanceInterval Day) Bool)
(declare-fun interval_start_rebalance_day (RebalanceInterval Day) Bool)
(declare-fun notice_for_index_adjustment (Document IndexAdjustment) Bool)
(declare-fun notice_gives_notice_period (Document NoticePeriod) Bool)
(declare-fun notice_period_day (NoticePeriod Day) Bool)
(declare-fun notice_period_with_respect_to_component (NoticePeriod FinancialInstrument) Bool)
(declare-fun possible_adjustment_effect (IndexAdjustment IndexAdjustmentEffect) Bool)
(declare-fun section_of_website (DocumentPart WebResource) Bool)
(declare-fun specified_in (Event DocumentPart) Bool)
(declare-fun trading_day_with_respect_to (Day FinancialInstrument) Bool)
(declare-fun website_of (WebResource Organization) Bool)

(assert (! (forall ((adjustment_required_due_to_corporate_action_arg0 IndexAdjustment) (adjustment_required_due_to_corporate_action_arg1 Event)) (=> (adjustment_required_due_to_corporate_action adjustment_required_due_to_corporate_action_arg0 adjustment_required_due_to_corporate_action_arg1) (and (RequiredIndexAdjustment adjustment_required_due_to_corporate_action_arg0) (CorporateAction adjustment_required_due_to_corporate_action_arg1)))) :named TYPE_symbol_adjustment_required_due_to_corporate_action))
(assert (! (forall ((affected_index_component_arg0 IndexAdjustment) (affected_index_component_arg1 FinancialInstrument)) (=> (affected_index_component affected_index_component_arg0 affected_index_component_arg1) (IndexComponent affected_index_component_arg1))) :named TYPE_symbol_affected_index_component))
(assert (! (forall ((announced_by_arg0 Document) (announced_by_arg1 Organization)) (=> (announced_by announced_by_arg0 announced_by_arg1) (Notice announced_by_arg0))) :named TYPE_symbol_announced_by))
(assert (! (forall ((announced_on_arg0 Document) (announced_on_arg1 WebResource)) (=> (announced_on announced_on_arg0 announced_on_arg1) (Notice announced_on_arg0))) :named TYPE_symbol_announced_on))
(assert (! (forall ((announced_under_section_arg0 Document) (announced_under_section_arg1 DocumentPart)) (=> (announced_under_section announced_under_section_arg0 announced_under_section_arg1) (Notice announced_under_section_arg0))) :named TYPE_symbol_announced_under_section))
(assert (! (forall ((corporate_action_in_relation_to_component_arg0 Event) (corporate_action_in_relation_to_component_arg1 FinancialInstrument)) (=> (corporate_action_in_relation_to_component corporate_action_in_relation_to_component_arg0 corporate_action_in_relation_to_component_arg1) (and (CorporateAction corporate_action_in_relation_to_component_arg0) (IndexComponent corporate_action_in_relation_to_component_arg1)))) :named TYPE_symbol_corporate_action_in_relation_to_component))
(assert (! (forall ((effective_day_specified_in_respective_notice_arg0 Document)) (EffectiveDay (effective_day_specified_in_respective_notice effective_day_specified_in_respective_notice_arg0))) :named TYPE_symbol_effective_day_specified_in_respective_notice))
(assert (! (forall ((interval_end_rebalance_day_arg0 RebalanceInterval) (interval_end_rebalance_day_arg1 Day)) (=> (interval_end_rebalance_day interval_end_rebalance_day_arg0 interval_end_rebalance_day_arg1) (RegularRebalanceDay interval_end_rebalance_day_arg1))) :named TYPE_symbol_interval_end_rebalance_day))
(assert (! (forall ((interval_start_rebalance_day_arg0 RebalanceInterval) (interval_start_rebalance_day_arg1 Day)) (=> (interval_start_rebalance_day interval_start_rebalance_day_arg0 interval_start_rebalance_day_arg1) (RegularRebalanceDay interval_start_rebalance_day_arg1))) :named TYPE_symbol_interval_start_rebalance_day))
(assert (! (forall ((notice_for_index_adjustment_arg0 Document) (notice_for_index_adjustment_arg1 IndexAdjustment)) (=> (notice_for_index_adjustment notice_for_index_adjustment_arg0 notice_for_index_adjustment_arg1) (and (Notice notice_for_index_adjustment_arg0) (RequiredIndexAdjustment notice_for_index_adjustment_arg1)))) :named TYPE_symbol_notice_for_index_adjustment))
(assert (! (forall ((notice_gives_notice_period_arg0 Document) (notice_gives_notice_period_arg1 NoticePeriod)) (=> (notice_gives_notice_period notice_gives_notice_period_arg0 notice_gives_notice_period_arg1) (Notice notice_gives_notice_period_arg0))) :named TYPE_symbol_notice_gives_notice_period))
(assert (! (forall ((notice_period_day_arg0 NoticePeriod) (notice_period_day_arg1 Day)) (=> (notice_period_day notice_period_day_arg0 notice_period_day_arg1) (TradingDay notice_period_day_arg1))) :named TYPE_symbol_notice_period_day))
(assert (! (forall ((notice_period_with_respect_to_component_arg0 NoticePeriod) (notice_period_with_respect_to_component_arg1 FinancialInstrument)) (=> (notice_period_with_respect_to_component notice_period_with_respect_to_component_arg0 notice_period_with_respect_to_component_arg1) (IndexComponent notice_period_with_respect_to_component_arg1))) :named TYPE_symbol_notice_period_with_respect_to_component))
(assert (! (forall ((specified_in_arg0 Event) (specified_in_arg1 DocumentPart)) (=> (specified_in specified_in_arg0 specified_in_arg1) (CorporateAction specified_in_arg0))) :named TYPE_symbol_specified_in))
(assert (! (forall ((trading_day_with_respect_to_arg0 Day) (trading_day_with_respect_to_arg1 FinancialInstrument)) (=> (trading_day_with_respect_to trading_day_with_respect_to_arg0 trading_day_with_respect_to_arg1) (and (TradingDay trading_day_with_respect_to_arg0) (IndexComponent trading_day_with_respect_to_arg1)))) :named TYPE_symbol_trading_day_with_respect_to))

(assert (! (and (incorporated_by_reference_into SolactiveEquityIndexMethodology ThisGuideline) (available_on SolactiveEquityIndexMethodology SolactiveWebsite) (website_of SolactiveWebsite Solactive)) :named TEXT_equity_index_methodology_reference))
(assert (! (section_of_website AnnouncementsSection SolactiveWebsite) :named TEXT_announcements_section_on_solactive_website))
(assert (! (adjustment_effect_described_by ComponentWeightingEffect CertainIndexComponents) :named TEXT_component_weighting_effect_qualified_by_certain_components))
(assert (! (exists ((p IndexAdjustmentPossibility)) (exists ((interval RebalanceInterval)) (and (adjustment_possibility_of_index p TheIndex) (adjustment_possibility_described_by p CertainCircumstances) (adjustment_possibility_described_by p MayBeNecessary) (adjustment_possibility_between_interval p interval)))) :named TEXT_index_adjustment_may_be_necessary_between_regular_rebalance_days))
(assert (! (forall ((a IndexAdjustment)) (=> (RequiredIndexAdjustment a) (and (adjustment_effect_scope_described_by a MayHaveToBeDone) (or (possible_adjustment_effect a ComponentRelationEffect) (possible_adjustment_effect a ComponentNumberEffect) (possible_adjustment_effect a ComponentWeightingEffect))))) :named TEXT_required_adjustment_effect_scope))
(assert (! (forall ((a IndexAdjustment)) (=> (RequiredIndexAdjustment a) (forall ((n Document)) (=> (Notice n) (=> (notice_for_index_adjustment n a) (and (announced_by n Solactive) (announced_on n SolactiveWebsite) (announced_under_section n AnnouncementsSection))))))) :named TEXT_index_adjustment_notice_publication))
(assert (! (forall ((a IndexAdjustment)) (=> (RequiredIndexAdjustment a) (forall ((n Document)) (=> (Notice n) (=> (notice_for_index_adjustment n a) (implemented_on a (effective_day_specified_in_respective_notice n))))))) :named TEXT_index_adjustment_implemented_on_notice_effective_day))
(check-sat)
