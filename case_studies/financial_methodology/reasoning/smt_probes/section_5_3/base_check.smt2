(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort ChangeReason 0)
(declare-sort Document 0)
(declare-sort Error 0)
(declare-sort Index 0)
(declare-sort Information 0)
(declare-sort Method 0)
(declare-sort MethodApplication 0)
(declare-sort MethodPurpose 0)
(declare-sort ModificationOrChange 0)
(declare-sort Organization 0)
(declare-sort Step 0)
(declare-sort TermsAndConditions 0)
(declare-sort VagueTerm 0)

(declare-fun CalculationMethod (Method) Bool)
(declare-fun DeemedModificationOrChange (ModificationOrChange) Bool)
(declare-fun IndexAdministrator (Organization) Bool)

(declare-const AppropriateSteps Step)
(declare-const Calculation MethodPurpose)
(declare-const Composition MethodPurpose)
(declare-const Demonstrable VagueTerm)
(declare-const DescribedMethod Method)
(declare-const DescribedMethodApplication MethodApplication)
(declare-const Desirable VagueTerm)
(declare-const FinancialReason ChangeReason)
(declare-const IndexTermsAndConditions TermsAndConditions)
(declare-const LegalReason ChangeReason)
(declare-const MarketEnvironment ChangeReason)
(declare-const ModificationOrChangeInformation Information)
(declare-const Necessary VagueTerm)
(declare-const Obvious VagueTerm)
(declare-const SupervisoryReason ChangeReason)
(declare-const TaxReason ChangeReason)
(declare-const TheIndex Index)
(declare-const TheIndexAdministrator Organization)
(declare-const ThisDocument Document)

(assert (! (IndexAdministrator TheIndexAdministrator) :named TYPE_entity_TheIndexAdministrator))
(assert (! (distinct MarketEnvironment SupervisoryReason LegalReason FinancialReason TaxReason) :named TYPE_enum_distinct_ChangeReason))
(assert (! (distinct Composition Calculation) :named TYPE_enum_distinct_MethodPurpose))

(declare-fun application_by (MethodApplication Organization) Bool)
(declare-fun application_of_method (MethodApplication Method) Bool)
(declare-fun appropriate (Step) Bool)
(declare-fun binding (MethodApplication) Bool)
(declare-fun calculation_method_applied (Index) Method)
(declare-fun change_to_calculation_method (ModificationOrChange Method) Bool)
(declare-fun change_to_terms_and_conditions (ModificationOrChange TermsAndConditions) Bool)
(declare-fun corrects_terms_and_conditions (ModificationOrChange TermsAndConditions) Bool)
(declare-fun deemed_by (ModificationOrChange Organization VagueTerm) Bool)
(declare-fun described_above (Method) Bool)
(declare-fun error_described_by (Error VagueTerm) Bool)
(declare-fun final (MethodApplication) Bool)
(declare-fun incorrect_terms_and_conditions (TermsAndConditions) Bool)
(declare-fun index_administrator_of (Organization Index) Bool)
(declare-fun information_withheld_on_modification_or_change (Organization ModificationOrChange Information) Bool)
(declare-fun method_described_in (Method Document) Bool)
(declare-fun method_for_index (Method Index) Bool)
(declare-fun method_for_purpose (Method MethodPurpose) Bool)
(declare-fun modification_or_change_of_index (ModificationOrChange Index) Bool)
(declare-fun potentially_requires_change_to_method (ChangeReason Method) Bool)
(declare-fun prevents_error (ModificationOrChange Error) Bool)
(declare-fun provide_information_on_modification_or_change (Organization ModificationOrChange Information) Bool)
(declare-fun remedies_terms_and_conditions (ModificationOrChange TermsAndConditions) Bool)
(declare-fun step_ensures_consistency_with (Step Method Method) Bool)
(declare-fun supplements_terms_and_conditions (ModificationOrChange TermsAndConditions) Bool)
(declare-fun terms_and_conditions_of (TermsAndConditions Index) Bool)

(assert (! (forall ((application_by_arg0 MethodApplication) (application_by_arg1 Organization)) (=> (application_by application_by_arg0 application_by_arg1) (IndexAdministrator application_by_arg1))) :named TYPE_symbol_application_by))
(assert (! (forall ((calculation_method_applied_arg0 Index)) (CalculationMethod (calculation_method_applied calculation_method_applied_arg0))) :named TYPE_symbol_calculation_method_applied))
(assert (! (forall ((change_to_calculation_method_arg0 ModificationOrChange) (change_to_calculation_method_arg1 Method)) (=> (change_to_calculation_method change_to_calculation_method_arg0 change_to_calculation_method_arg1) (CalculationMethod change_to_calculation_method_arg1))) :named TYPE_symbol_change_to_calculation_method))
(assert (! (forall ((deemed_by_arg0 ModificationOrChange) (deemed_by_arg1 Organization) (deemed_by_arg2 VagueTerm)) (=> (deemed_by deemed_by_arg0 deemed_by_arg1 deemed_by_arg2) (IndexAdministrator deemed_by_arg1))) :named TYPE_symbol_deemed_by))
(assert (! (forall ((index_administrator_of_arg0 Organization) (index_administrator_of_arg1 Index)) (=> (index_administrator_of index_administrator_of_arg0 index_administrator_of_arg1) (IndexAdministrator index_administrator_of_arg0))) :named TYPE_symbol_index_administrator_of))
(assert (! (forall ((information_withheld_on_modification_or_change_arg0 Organization) (information_withheld_on_modification_or_change_arg1 ModificationOrChange) (information_withheld_on_modification_or_change_arg2 Information)) (=> (information_withheld_on_modification_or_change information_withheld_on_modification_or_change_arg0 information_withheld_on_modification_or_change_arg1 information_withheld_on_modification_or_change_arg2) (IndexAdministrator information_withheld_on_modification_or_change_arg0))) :named TYPE_symbol_information_withheld_on_modification_or_change))
(assert (! (forall ((provide_information_on_modification_or_change_arg0 Organization) (provide_information_on_modification_or_change_arg1 ModificationOrChange) (provide_information_on_modification_or_change_arg2 Information)) (=> (provide_information_on_modification_or_change provide_information_on_modification_or_change_arg0 provide_information_on_modification_or_change_arg1 provide_information_on_modification_or_change_arg2) (IndexAdministrator provide_information_on_modification_or_change_arg0))) :named TYPE_symbol_provide_information_on_modification_or_change))
(assert (! (forall ((step_ensures_consistency_with_arg0 Step) (step_ensures_consistency_with_arg1 Method) (step_ensures_consistency_with_arg2 Method)) (=> (step_ensures_consistency_with step_ensures_consistency_with_arg0 step_ensures_consistency_with_arg1 step_ensures_consistency_with_arg2) (CalculationMethod step_ensures_consistency_with_arg1))) :named TYPE_symbol_step_ensures_consistency_with))

(assert (! (index_administrator_of TheIndexAdministrator TheIndex) :named TEXT_index_administrator_for_index))
(assert (! (and (method_described_in DescribedMethod ThisDocument) (described_above DescribedMethod)) :named TEXT_described_method_reference))
(assert (! (and (method_for_index DescribedMethod TheIndex) (method_for_purpose DescribedMethod Composition) (method_for_purpose DescribedMethod Calculation)) :named TEXT_described_method_for_composition_and_calculation))
(assert (! (and (application_by DescribedMethodApplication TheIndexAdministrator) (application_of_method DescribedMethodApplication DescribedMethod) (final DescribedMethodApplication) (binding DescribedMethodApplication)) :named TEXT_described_method_application_final_and_binding))
(assert (! (terms_and_conditions_of IndexTermsAndConditions TheIndex) :named TEXT_index_terms_and_conditions))
(assert (! (and (potentially_requires_change_to_method MarketEnvironment DescribedMethod) (potentially_requires_change_to_method SupervisoryReason DescribedMethod) (potentially_requires_change_to_method LegalReason DescribedMethod) (potentially_requires_change_to_method FinancialReason DescribedMethod) (potentially_requires_change_to_method TaxReason DescribedMethod)) :named TEXT_potential_method_change_reasons))
(assert (! (forall ((ch ModificationOrChange)) (=> (DeemedModificationOrChange ch) (and (modification_or_change_of_index ch TheIndex) (or (change_to_terms_and_conditions ch IndexTermsAndConditions) (change_to_calculation_method ch (calculation_method_applied TheIndex))) (deemed_by ch TheIndexAdministrator Necessary) (deemed_by ch TheIndexAdministrator Desirable) (or (exists ((e Error)) (and (or (error_described_by e Obvious) (error_described_by e Demonstrable)) (prevents_error ch e))) (and (incorrect_terms_and_conditions IndexTermsAndConditions) (or (remedies_terms_and_conditions ch IndexTermsAndConditions) (corrects_terms_and_conditions ch IndexTermsAndConditions) (supplements_terms_and_conditions ch IndexTermsAndConditions))))))) :named TEXT_deemed_modification_or_change_scope))
(assert (! (and (appropriate AppropriateSteps) (step_ensures_consistency_with AppropriateSteps (calculation_method_applied TheIndex) DescribedMethod)) :named TEXT_appropriate_steps_consistency_target))
(assert (! (forall ((a Organization)) (=> (IndexAdministrator a) (forall ((ch ModificationOrChange)) (= (information_withheld_on_modification_or_change a ch ModificationOrChangeInformation) (not (provide_information_on_modification_or_change a ch ModificationOrChangeInformation)))))) :named TEXT_information_withheld_means_information_not_provided))
(check-sat)
