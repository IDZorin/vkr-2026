(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort Day 0)
(declare-sort Document 0)
(declare-sort DocumentPart 0)
(declare-sort Index 0)
(declare-sort Period 0)

(declare-fun ArticleNumber (Int) Bool)
(declare-fun IndexLevel (Real) Bool)

(declare-const Article8OfBMR DocumentPart)
(declare-const BMR Document)
(declare-const LiveDate29_09_2025 Day)
(declare-const SolactiveTransatlanticCleanEnergyEURIndex50AR Index)
(declare-const SolactiveTransatlanticCleanEnergyEURIndex5PercentAR Index)
(declare-const SolactiveTransatlanticCleanEnergyEURIndexNTR Index)
(declare-const SolactiveTransatlanticCleanEnergyEURIndexPR Index)
(declare-const SolactiveTransatlanticCleanEnergyEURIndexTR Index)
(declare-const StartDate05_08_2017 Day)

(declare-fun article_number (DocumentPart) Int)
(declare-fun back_tested (Real) Bool)
(declare-fun historical_value (Real Index Day) Bool)
(declare-fun initial_level (Index Day) Real)
(declare-fun live_date (Day) Bool)
(declare-fun period_prior_to (Period Day) Bool)
(declare-fun published_level_for_period (Real Index Period) Bool)
(declare-fun recorded_in_accordance_with (Real DocumentPart) Bool)
(declare-fun section_1_3_index (Index) Bool)
(declare-fun start_date (Day) Bool)

(assert (! (forall ((article_number_arg0 DocumentPart)) (ArticleNumber (article_number article_number_arg0))) :named TYPE_symbol_article_number))
(assert (! (forall ((back_tested_arg0 Real)) (=> (back_tested back_tested_arg0) (IndexLevel back_tested_arg0))) :named TYPE_symbol_back_tested))
(assert (! (forall ((historical_value_arg0 Real) (historical_value_arg1 Index) (historical_value_arg2 Day)) (=> (historical_value historical_value_arg0 historical_value_arg1 historical_value_arg2) (IndexLevel historical_value_arg0))) :named TYPE_symbol_historical_value))
(assert (! (forall ((initial_level_arg0 Index) (initial_level_arg1 Day)) (IndexLevel (initial_level initial_level_arg0 initial_level_arg1))) :named TYPE_symbol_initial_level))
(assert (! (forall ((published_level_for_period_arg0 Real) (published_level_for_period_arg1 Index) (published_level_for_period_arg2 Period)) (=> (published_level_for_period published_level_for_period_arg0 published_level_for_period_arg1 published_level_for_period_arg2) (IndexLevel published_level_for_period_arg0))) :named TYPE_symbol_published_level_for_period))
(assert (! (forall ((recorded_in_accordance_with_arg0 Real) (recorded_in_accordance_with_arg1 DocumentPart)) (=> (recorded_in_accordance_with recorded_in_accordance_with_arg0 recorded_in_accordance_with_arg1) (IndexLevel recorded_in_accordance_with_arg0))) :named TYPE_symbol_recorded_in_accordance_with))

(assert (! (and (section_1_3_index SolactiveTransatlanticCleanEnergyEURIndexPR) (section_1_3_index SolactiveTransatlanticCleanEnergyEURIndexNTR) (section_1_3_index SolactiveTransatlanticCleanEnergyEURIndexTR) (section_1_3_index SolactiveTransatlanticCleanEnergyEURIndex50AR) (section_1_3_index SolactiveTransatlanticCleanEnergyEURIndex5PercentAR)) :named TEXT_section_1_3_index_scope))
(assert (! (and (start_date StartDate05_08_2017) (live_date LiveDate29_09_2025)) :named TEXT_start_and_live_dates))
(assert (! (forall ((i Index)) (=> (and (section_1_3_index i) (not (= i SolactiveTransatlanticCleanEnergyEURIndex50AR))) (= (initial_level i StartDate05_08_2017) 1000))) :named TEXT_initial_level_default_on_start_date))
(assert (! (= (initial_level SolactiveTransatlanticCleanEnergyEURIndex50AR StartDate05_08_2017) 739.08) :named TEXT_initial_level_50_ar_on_start_date))
(assert (! (forall ((i Index)) (forall ((p Period)) (forall ((l Real)) (=> (IndexLevel l) (=> (and (section_1_3_index i) (published_level_for_period l i p) (period_prior_to p LiveDate29_09_2025)) (back_tested l)))))) :named TEXT_levels_published_prior_to_live_date_back_tested))
(check-sat)
