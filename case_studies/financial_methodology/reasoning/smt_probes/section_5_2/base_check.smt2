(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort Day 0)
(declare-sort Document 0)
(declare-sort DocumentPart 0)
(declare-sort Index 0)
(declare-sort IndexAmendment 0)
(declare-sort IndexMethodology 0)
(declare-sort MethodologyChange 0)
(declare-sort MethodologyChangeNeed 0)
(declare-sort MethodologyChangeNeedExampleCondition 0)
(declare-sort MethodologyReview 0)
(declare-sort Organization 0)
(declare-sort ReflectionQuality 0)
(declare-sort Url 0)
(declare-sort WebResource 0)

(declare-fun MethodologyPolicy (Document) Bool)
(declare-fun ReviewIdentifiedMethodologyChange (MethodologyChange) Bool)

(declare-const Accuracy ReflectionQuality)
(declare-const AnnouncementSection DocumentPart)
(declare-const Appropriateness ReflectionQuality)
(declare-const EconomicRealityChange MethodologyChangeNeedExampleCondition)
(declare-const Guideline Document)
(declare-const HttpsWwwSolactiveComDocumentsMethodologyPolicy Url)
(declare-const HttpsWwwSolactiveComNewsAnnouncements Url)
(declare-const NoLongerReflectsReality MethodologyChangeNeedExampleCondition)
(declare-const ObsoleteAssumption MethodologyChangeNeedExampleCondition)
(declare-const ObsoleteFactor MethodologyChangeNeedExampleCondition)
(declare-const Reliability ReflectionQuality)
(declare-const Solactive Organization)
(declare-const SolactiveMethodologyPolicy Document)
(declare-const SolactiveWebsite WebResource)
(declare-const TheIndex Index)
(declare-const TheIndexMethodology IndexMethodology)
(declare-const UnderlyingMarketChange MethodologyChangeNeedExampleCondition)

(assert (! (MethodologyPolicy SolactiveMethodologyPolicy) :named TYPE_entity_SolactiveMethodologyPolicy))
(assert (! (distinct UnderlyingMarketChange EconomicRealityChange ObsoleteAssumption ObsoleteFactor NoLongerReflectsReality) :named TYPE_enum_distinct_MethodologyChangeNeedExampleCondition))
(assert (! (distinct Accuracy Reliability Appropriateness) :named TYPE_enum_distinct_ReflectionQuality))

(declare-fun amendment_date (IndexAmendment) Day)
(declare-fun amendment_of_index (IndexAmendment Index) Bool)
(declare-fun at_least_annually (MethodologyReview) Bool)
(declare-fun available_on (Document WebResource) Bool)
(declare-fun change_for_need (MethodologyChange MethodologyChangeNeed) Bool)
(declare-fun change_need_of_methodology (MethodologyChangeNeed IndexMethodology) Bool)
(declare-fun change_of_methodology (MethodologyChange IndexMethodology) Bool)
(declare-fun contained_in (Day Document) Bool)
(declare-fun example_condition_changed_since_launch_of_index (MethodologyChangeNeedExampleCondition Index) Bool)
(declare-fun example_condition_for_methodology_change_need (MethodologyChangeNeedExampleCondition) Bool)
(declare-fun example_condition_obsolete_assumption_for_methodology (MethodologyChangeNeedExampleCondition IndexMethodology) Bool)
(declare-fun example_condition_obsolete_factor_for_methodology (MethodologyChangeNeedExampleCondition IndexMethodology) Bool)
(declare-fun example_condition_reflection_quality (MethodologyChangeNeedExampleCondition ReflectionQuality) Bool)
(declare-fun incorporated_by_reference_into (Document Document) Bool)
(declare-fun last_amendment (Index) IndexAmendment)
(declare-fun methodology_has_obsolete_basis (IndexMethodology MethodologyChangeNeedExampleCondition) Bool)
(declare-fun methodology_of_index (IndexMethodology Index) Bool)
(declare-fun need_has_example_condition (MethodologyChangeNeed MethodologyChangeNeedExampleCondition) Bool)
(declare-fun need_identified_within_review (MethodologyChangeNeed MethodologyReview) Bool)
(declare-fun reflects_reality_as_before (IndexMethodology ReflectionQuality) Bool)
(declare-fun regular (MethodologyReview) Bool)
(declare-fun review_of_methodology (MethodologyReview IndexMethodology) Bool)
(declare-fun section_of_website (DocumentPart WebResource) Bool)
(declare-fun website_of (WebResource Organization) Bool)

(assert (! (forall ((change_for_need_arg0 MethodologyChange) (change_for_need_arg1 MethodologyChangeNeed)) (=> (change_for_need change_for_need_arg0 change_for_need_arg1) (ReviewIdentifiedMethodologyChange change_for_need_arg0))) :named TYPE_symbol_change_for_need))

(assert (! (methodology_of_index TheIndexMethodology TheIndex) :named TEXT_index_methodology_scope))
(assert (! (exists ((r MethodologyReview)) (and (review_of_methodology r TheIndexMethodology) (regular r) (at_least_annually r))) :named TEXT_methodology_subject_to_regular_review_at_least_annually))
(assert (! (forall ((r MethodologyReview)) (=> (review_of_methodology r TheIndexMethodology) (and (regular r) (at_least_annually r)))) :named TEXT_methodology_reviews_are_regular_at_least_annually))
(assert (! (forall ((n MethodologyChangeNeed)) (forall ((r MethodologyReview)) (=> (and (need_identified_within_review n r) (review_of_methodology r TheIndexMethodology)) (and (change_need_of_methodology n TheIndexMethodology) (exists ((c MethodologyChange)) (and (ReviewIdentifiedMethodologyChange c) (and (change_for_need c n) (change_of_methodology c TheIndexMethodology)))))))) :named TEXT_identified_need_has_review_identified_change))
(assert (! (and (example_condition_for_methodology_change_need UnderlyingMarketChange) (example_condition_for_methodology_change_need EconomicRealityChange) (example_condition_for_methodology_change_need ObsoleteAssumption) (example_condition_for_methodology_change_need ObsoleteFactor) (example_condition_for_methodology_change_need NoLongerReflectsReality) (example_condition_changed_since_launch_of_index UnderlyingMarketChange TheIndex) (example_condition_changed_since_launch_of_index EconomicRealityChange TheIndex) (example_condition_obsolete_assumption_for_methodology ObsoleteAssumption TheIndexMethodology) (methodology_has_obsolete_basis TheIndexMethodology ObsoleteAssumption) (example_condition_obsolete_factor_for_methodology ObsoleteFactor TheIndexMethodology) (methodology_has_obsolete_basis TheIndexMethodology ObsoleteFactor) (example_condition_reflection_quality NoLongerReflectsReality Accuracy) (example_condition_reflection_quality NoLongerReflectsReality Reliability) (example_condition_reflection_quality NoLongerReflectsReality Appropriateness)) :named TEXT_methodology_change_need_example_condition_catalog))
(assert (! (forall ((q ReflectionQuality)) (=> (example_condition_reflection_quality NoLongerReflectsReality q) (not (reflects_reality_as_before TheIndexMethodology q)))) :named TEXT_no_longer_reflects_reality_condition_means_not_reflects_reality_as_before))
(assert (! (forall ((n MethodologyChangeNeed)) (forall ((c MethodologyChangeNeedExampleCondition)) (=> (need_has_example_condition n c) (and (change_need_of_methodology n TheIndexMethodology) (example_condition_for_methodology_change_need c))))) :named TEXT_methodology_change_need_example_condition_scope))
(assert (! (and (amendment_of_index (last_amendment TheIndex) TheIndex) (contained_in (amendment_date (last_amendment TheIndex)) Guideline)) :named TEXT_last_amendment_date_contained_in_guideline))
(check-sat)
