(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort Amendment 0)
(declare-sort Approval 0)
(declare-sort Document 0)
(declare-sort Index 0)
(declare-sort IndexRule 0)
(declare-sort Organization 0)
(declare-sort Staff 0)
(declare-sort Url 0)
(declare-sort WebResource 0)

(declare-fun Committee (Organization) Bool)
(declare-fun GuidelineAmendment (Amendment) Bool)
(declare-fun IndexRuleAmendment (Amendment) Bool)
(declare-fun Policy (Document) Bool)
(declare-fun PriorApproval (Approval) Bool)
(declare-fun Subsidiary (Organization) Bool)

(declare-const Guideline Document)
(declare-const HttpsWwwSolactiveComDocumentsMethodologyPolicy Url)
(declare-const MethodologyPolicy Document)
(declare-const OversightCommittee Organization)
(declare-const OversightCommitteePriorApproval Approval)
(declare-const Solactive Organization)
(declare-const SolactiveWebsite WebResource)
(declare-const TheIndex Index)

(assert (! (Policy MethodologyPolicy) :named TYPE_entity_MethodologyPolicy))
(assert (! (Committee OversightCommittee) :named TYPE_entity_OversightCommittee))
(assert (! (PriorApproval OversightCommitteePriorApproval) :named TYPE_entity_OversightCommitteePriorApproval))

(declare-fun amendment_of_document (Amendment Document) Bool)
(declare-fun amendment_of_rule (Amendment IndexRule) Bool)
(declare-fun approval_by (Approval Organization) Bool)
(declare-fun available_on (Document WebResource) Bool)
(declare-fun composed_of (Organization Staff) Bool)
(declare-fun may_result_in (Amendment Amendment) Bool)
(declare-fun responsible_for_decisions_regarding (Organization Amendment) Bool)
(declare-fun rule_of (IndexRule Index) Bool)
(declare-fun staff_from (Staff Organization) Bool)
(declare-fun subsidiary_of (Organization Organization) Bool)
(declare-fun website_of (WebResource Organization) Bool)

(assert (! (forall ((amendment_of_document_arg0 Amendment) (amendment_of_document_arg1 Document)) (=> (amendment_of_document amendment_of_document_arg0 amendment_of_document_arg1) (GuidelineAmendment amendment_of_document_arg0))) :named TYPE_symbol_amendment_of_document))
(assert (! (forall ((amendment_of_rule_arg0 Amendment) (amendment_of_rule_arg1 IndexRule)) (=> (amendment_of_rule amendment_of_rule_arg0 amendment_of_rule_arg1) (IndexRuleAmendment amendment_of_rule_arg0))) :named TYPE_symbol_amendment_of_rule))
(assert (! (forall ((approval_by_arg0 Approval) (approval_by_arg1 Organization)) (=> (approval_by approval_by_arg0 approval_by_arg1) (and (PriorApproval approval_by_arg0) (Committee approval_by_arg1)))) :named TYPE_symbol_approval_by))
(assert (! (forall ((composed_of_arg0 Organization) (composed_of_arg1 Staff)) (=> (composed_of composed_of_arg0 composed_of_arg1) (Committee composed_of_arg0))) :named TYPE_symbol_composed_of))
(assert (! (forall ((may_result_in_arg0 Amendment) (may_result_in_arg1 Amendment)) (=> (may_result_in may_result_in_arg0 may_result_in_arg1) (and (IndexRuleAmendment may_result_in_arg0) (GuidelineAmendment may_result_in_arg1)))) :named TYPE_symbol_may_result_in))
(assert (! (forall ((responsible_for_decisions_regarding_arg0 Organization) (responsible_for_decisions_regarding_arg1 Amendment)) (=> (responsible_for_decisions_regarding responsible_for_decisions_regarding_arg0 responsible_for_decisions_regarding_arg1) (and (Committee responsible_for_decisions_regarding_arg0) (IndexRuleAmendment responsible_for_decisions_regarding_arg1)))) :named TYPE_symbol_responsible_for_decisions_regarding))
(assert (! (forall ((subsidiary_of_arg0 Organization) (subsidiary_of_arg1 Organization)) (=> (subsidiary_of subsidiary_of_arg0 subsidiary_of_arg1) (Subsidiary subsidiary_of_arg0))) :named TYPE_symbol_subsidiary_of))

(assert (! (exists ((s Staff)) (composed_of OversightCommittee s)) :named TEXT_oversight_committee_has_staff))
(assert (! (approval_by OversightCommitteePriorApproval OversightCommittee) :named TEXT_oversight_committee_prior_approval))
(assert (! (forall ((s Staff)) (=> (composed_of OversightCommittee s) (or (staff_from s Solactive) (exists ((sub Organization)) (and (Subsidiary sub) (and (subsidiary_of sub Solactive) (staff_from s sub))))))) :named TEXT_oversight_committee_staff_from_solactive_or_subsidiary))
(assert (! (forall ((a Amendment)) (=> (IndexRuleAmendment a) (exists ((r IndexRule)) (and (amendment_of_rule a r) (rule_of r TheIndex))))) :named TEXT_index_rule_amendment_scope))
(assert (! (forall ((a Amendment)) (=> (IndexRuleAmendment a) (forall ((r IndexRule)) (=> (and (amendment_of_rule a r) (rule_of r TheIndex)) (responsible_for_decisions_regarding OversightCommittee a))))) :named TEXT_oversight_committee_responsible_for_index_rule_amendment_decisions))
(assert (! (forall ((a Amendment)) (=> (IndexRuleAmendment a) (exists ((g Amendment)) (and (GuidelineAmendment g) (and (may_result_in a g) (amendment_of_document g Guideline)))))) :named TEXT_index_rule_amendments_may_result_in_guideline_amendment))
(check-sat)
