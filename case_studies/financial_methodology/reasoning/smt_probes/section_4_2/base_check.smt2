(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort Document 0)
(declare-sort DocumentPart 0)
(declare-sort Event 0)
(declare-sort Index 0)
(declare-sort Organization 0)
(declare-sort Url 0)
(declare-sort VagueTerm 0)
(declare-sort WebResource 0)

(declare-fun AdjustedReturnIndex (Index) Bool)
(declare-fun IndexCalculation (Event) Bool)
(declare-fun IndexLevel (Real) Bool)
(declare-fun IndexTermination (Event) Bool)
(declare-fun Policy (Document) Bool)
(declare-fun SolactiveOrganization (Organization) Bool)
(declare-fun TerminationAnnouncement (Event) Bool)

(declare-const AsSoonAsReasonablyPossible VagueTerm)
(declare-const HttpsWwwSolactiveComNewsAnnouncements Url)
(declare-const NewsSection DocumentPart)
(declare-const OtherReasons VagueTerm)
(declare-const Solactive Organization)
(declare-const SolactivePolicies Document)
(declare-const SolactiveWebsite WebResource)

(assert (! (SolactiveOrganization Solactive) :named TYPE_entity_Solactive))
(assert (! (Policy SolactivePolicies) :named TYPE_entity_SolactivePolicies))

(declare-fun after (Event Event) Bool)
(declare-fun announced_on (Event WebResource) Bool)
(declare-fun announcement_by (Event Organization) Bool)
(declare-fun announcement_timing_described_by (Event VagueTerm) Bool)
(declare-fun announcement_under_section (Event DocumentPart) Bool)
(declare-fun announces_termination (Event Event) Bool)
(declare-fun calculated_index (Event Index) Bool)
(declare-fun calculated_level (Event) Real)
(declare-fun policy_of (Document Organization) Bool)
(declare-fun section_of_website (DocumentPart WebResource) Bool)
(declare-fun terminates_index (Event Index) Bool)
(declare-fun termination_calculation (Event Event) Bool)
(declare-fun termination_in_accordance_with_policy (Event Document) Bool)
(declare-fun termination_reason_qualified_by (Event VagueTerm) Bool)
(declare-fun website_of (WebResource Organization) Bool)

(assert (! (forall ((announced_on_arg0 Event) (announced_on_arg1 WebResource)) (=> (announced_on announced_on_arg0 announced_on_arg1) (TerminationAnnouncement announced_on_arg0))) :named TYPE_symbol_announced_on))
(assert (! (forall ((announcement_by_arg0 Event) (announcement_by_arg1 Organization)) (=> (announcement_by announcement_by_arg0 announcement_by_arg1) (TerminationAnnouncement announcement_by_arg0))) :named TYPE_symbol_announcement_by))
(assert (! (forall ((announcement_timing_described_by_arg0 Event) (announcement_timing_described_by_arg1 VagueTerm)) (=> (announcement_timing_described_by announcement_timing_described_by_arg0 announcement_timing_described_by_arg1) (TerminationAnnouncement announcement_timing_described_by_arg0))) :named TYPE_symbol_announcement_timing_described_by))
(assert (! (forall ((announcement_under_section_arg0 Event) (announcement_under_section_arg1 DocumentPart)) (=> (announcement_under_section announcement_under_section_arg0 announcement_under_section_arg1) (TerminationAnnouncement announcement_under_section_arg0))) :named TYPE_symbol_announcement_under_section))
(assert (! (forall ((announces_termination_arg0 Event) (announces_termination_arg1 Event)) (=> (announces_termination announces_termination_arg0 announces_termination_arg1) (and (TerminationAnnouncement announces_termination_arg0) (IndexTermination announces_termination_arg1)))) :named TYPE_symbol_announces_termination))
(assert (! (forall ((calculated_index_arg0 Event) (calculated_index_arg1 Index)) (=> (calculated_index calculated_index_arg0 calculated_index_arg1) (and (IndexCalculation calculated_index_arg0) (AdjustedReturnIndex calculated_index_arg1)))) :named TYPE_symbol_calculated_index))
(assert (! (forall ((calculated_level_arg0 Event)) (IndexLevel (calculated_level calculated_level_arg0))) :named TYPE_symbol_calculated_level))
(assert (! (forall ((policy_of_arg0 Document) (policy_of_arg1 Organization)) (=> (policy_of policy_of_arg0 policy_of_arg1) (Policy policy_of_arg0))) :named TYPE_symbol_policy_of))
(assert (! (forall ((terminates_index_arg0 Event) (terminates_index_arg1 Index)) (=> (terminates_index terminates_index_arg0 terminates_index_arg1) (IndexTermination terminates_index_arg0))) :named TYPE_symbol_terminates_index))
(assert (! (forall ((termination_calculation_arg0 Event) (termination_calculation_arg1 Event)) (=> (termination_calculation termination_calculation_arg0 termination_calculation_arg1) (and (IndexTermination termination_calculation_arg0) (IndexCalculation termination_calculation_arg1)))) :named TYPE_symbol_termination_calculation))
(assert (! (forall ((termination_in_accordance_with_policy_arg0 Event) (termination_in_accordance_with_policy_arg1 Document)) (=> (termination_in_accordance_with_policy termination_in_accordance_with_policy_arg0 termination_in_accordance_with_policy_arg1) (and (IndexTermination termination_in_accordance_with_policy_arg0) (Policy termination_in_accordance_with_policy_arg1)))) :named TYPE_symbol_termination_in_accordance_with_policy))
(assert (! (forall ((termination_reason_qualified_by_arg0 Event) (termination_reason_qualified_by_arg1 VagueTerm)) (=> (termination_reason_qualified_by termination_reason_qualified_by_arg0 termination_reason_qualified_by_arg1) (IndexTermination termination_reason_qualified_by_arg0))) :named TYPE_symbol_termination_reason_qualified_by))

(assert (! (policy_of SolactivePolicies Solactive) :named TEXT_solactive_policies))
(assert (! (forall ((c Event)) (=> (IndexCalculation c) (forall ((i Index)) (=> (AdjustedReturnIndex i) (=> (and (calculated_index c i) (<= (calculated_level c) 0)) (exists ((t Event)) (and (IndexTermination t) (exists ((a Event)) (and (TerminationAnnouncement a) (and (terminates_index t i) (termination_calculation t c) (announces_termination a t) (announcement_by a Solactive) (announced_on a SolactiveWebsite) (announcement_under_section a NewsSection) (after a c) (announcement_timing_described_by a AsSoonAsReasonablyPossible))))))))))) :named TEXT_termination_and_announcement_at_zero_or_below))
(assert (! (forall ((t Event)) (=> (IndexTermination t) (forall ((i Index)) (=> (and (terminates_index t i) (termination_reason_qualified_by t OtherReasons)) (termination_in_accordance_with_policy t SolactivePolicies))))) :named TEXT_other_reason_termination_in_accordance_with_solactive_policies))
(check-sat)
