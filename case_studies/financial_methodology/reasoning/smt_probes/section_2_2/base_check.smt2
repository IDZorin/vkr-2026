(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort CountryAssignment 0)
(declare-sort Day 0)
(declare-sort DiscretionaryDecision 0)
(declare-sort FinancialInstrument 0)
(declare-sort MonetaryAmount 0)
(declare-sort Organization 0)
(declare-sort Region 0)
(declare-sort SelectionOfIndexComponents 0)

(declare-fun FreeFloatMarketCapizatlization (MonetaryAmount) Bool)
(declare-fun IndexAdministrator (Organization) Bool)
(declare-fun Rank (Int) Bool)
(declare-fun Security (FinancialInstrument) Bool)
(declare-fun SelectionDay (Day) Bool)

(declare-const Americas Region)
(declare-const Canada CountryAssignment)
(declare-const Europe CountryAssignment)
(declare-const EuropeRegion Region)
(declare-const UnitedStates CountryAssignment)

(declare-fun eligible (Day FinancialInstrument) Bool)
(declare-fun free_float_market_capizatlization (Day FinancialInstrument) MonetaryAmount)
(declare-fun fully_rule_based (SelectionOfIndexComponents) Bool)
(declare-fun gbs_country_assignment (Day FinancialInstrument) CountryAssignment)
(declare-fun index_component (Day FinancialInstrument) Bool)
(declare-fun index_universe (Day FinancialInstrument) Bool)
(declare-fun initial_composition (Day FinancialInstrument) Bool)
(declare-fun ordinary_rebalance_selection (Day FinancialInstrument) Bool)
(declare-fun rank (Day Region FinancialInstrument) Int)
(declare-fun region (Day FinancialInstrument) Region)
(declare-fun selected_for_index_inclusion (Day FinancialInstrument) Bool)
(declare-fun selection_of_index_components (Day) SelectionOfIndexComponents)

(assert (! (forall ((eligible_arg0 Day) (eligible_arg1 FinancialInstrument)) (=> (eligible eligible_arg0 eligible_arg1) (and (SelectionDay eligible_arg0) (Security eligible_arg1)))) :named TYPE_symbol_eligible))
(assert (! (forall ((free_float_market_capizatlization_arg0 Day) (free_float_market_capizatlization_arg1 FinancialInstrument)) (FreeFloatMarketCapizatlization (free_float_market_capizatlization free_float_market_capizatlization_arg0 free_float_market_capizatlization_arg1))) :named TYPE_symbol_free_float_market_capizatlization))
(assert (! (forall ((index_component_arg0 Day) (index_component_arg1 FinancialInstrument)) (=> (index_component index_component_arg0 index_component_arg1) (and (SelectionDay index_component_arg0) (Security index_component_arg1)))) :named TYPE_symbol_index_component))
(assert (! (forall ((index_universe_arg0 Day) (index_universe_arg1 FinancialInstrument)) (=> (index_universe index_universe_arg0 index_universe_arg1) (and (SelectionDay index_universe_arg0) (Security index_universe_arg1)))) :named TYPE_symbol_index_universe))
(assert (! (forall ((initial_composition_arg0 Day) (initial_composition_arg1 FinancialInstrument)) (=> (initial_composition initial_composition_arg0 initial_composition_arg1) (and (SelectionDay initial_composition_arg0) (Security initial_composition_arg1)))) :named TYPE_symbol_initial_composition))
(assert (! (forall ((ordinary_rebalance_selection_arg0 Day) (ordinary_rebalance_selection_arg1 FinancialInstrument)) (=> (ordinary_rebalance_selection ordinary_rebalance_selection_arg0 ordinary_rebalance_selection_arg1) (and (SelectionDay ordinary_rebalance_selection_arg0) (Security ordinary_rebalance_selection_arg1)))) :named TYPE_symbol_ordinary_rebalance_selection))
(assert (! (forall ((rank_arg0 Day) (rank_arg1 Region) (rank_arg2 FinancialInstrument)) (Rank (rank rank_arg0 rank_arg1 rank_arg2))) :named TYPE_symbol_rank))
(assert (! (forall ((selected_for_index_inclusion_arg0 Day) (selected_for_index_inclusion_arg1 FinancialInstrument)) (=> (selected_for_index_inclusion selected_for_index_inclusion_arg0 selected_for_index_inclusion_arg1) (and (SelectionDay selected_for_index_inclusion_arg0) (Security selected_for_index_inclusion_arg1)))) :named TYPE_symbol_selected_for_index_inclusion))

(assert (! (forall ((d Day)) (=> (SelectionDay d) (forall ((s FinancialInstrument)) (=> (Security s) (= (eligible d s) (index_universe d s)))))) :named TEXT_eligible_iff_index_universe_for_component_requirements))
(assert (! (forall ((d Day)) (=> (SelectionDay d) (forall ((s FinancialInstrument)) (=> (Security s) (=> (eligible d s) (or (= (region d s) Americas) (= (region d s) EuropeRegion))))))) :named TEXT_security_classified_into_one_of_two_regions))
(assert (! (forall ((d Day)) (=> (SelectionDay d) (forall ((s FinancialInstrument)) (=> (Security s) (=> (eligible d s) (= (= (region d s) Americas) (or (= (gbs_country_assignment d s) Canada) (= (gbs_country_assignment d s) UnitedStates)))))))) :named TEXT_americas_country_assignment_classification))
(assert (! (forall ((d Day)) (=> (SelectionDay d) (forall ((s FinancialInstrument)) (=> (Security s) (=> (eligible d s) (= (= (region d s) EuropeRegion) (= (gbs_country_assignment d s) Europe))))))) :named TEXT_europe_country_assignment_classification))
(assert (! (forall ((d Day)) (=> (SelectionDay d) (forall ((r Region)) (forall ((s1 FinancialInstrument)) (=> (Security s1) (forall ((s2 FinancialInstrument)) (=> (Security s2) (=> (and (eligible d s1) (eligible d s2) (= (region d s1) r) (= (region d s2) r) (> (free_float_market_capizatlization d s1) (free_float_market_capizatlization d s2))) (< (rank d r s1) (rank d r s2)))))))))) :named TEXT_descending_order_by_free_float_market_capizatlization))
(assert (! (forall ((d Day)) (=> (SelectionDay d) (forall ((s FinancialInstrument)) (=> (Security s) (= (selected_for_index_inclusion d s) (and (eligible d s) (<= (rank d (region d s) s) 20))))))) :named TEXT_selected_top_20_for_each_region))
(assert (! (forall ((d Day)) (=> (SelectionDay d) (forall ((s FinancialInstrument)) (=> (Security s) (= (index_component d s) (selected_for_index_inclusion d s)))))) :named TEXT_index_components_selected_for_index_inclusion))
(assert (! (forall ((d Day)) (=> (SelectionDay d) (forall ((s FinancialInstrument)) (=> (Security s) (= (initial_composition d s) (selected_for_index_inclusion d s)))))) :named TEXT_initial_composition_determined_by_index_component_requirements))
(assert (! (forall ((d Day)) (=> (SelectionDay d) (forall ((s FinancialInstrument)) (=> (Security s) (= (ordinary_rebalance_selection d s) (selected_for_index_inclusion d s)))))) :named TEXT_ordinary_rebalance_selection_determined_by_index_component_requirements))
(assert (! (forall ((d Day)) (=> (SelectionDay d) (fully_rule_based (selection_of_index_components d)))) :named TEXT_selection_fully_rule_based))
(check-sat)
