(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort Document 0)
(declare-sort DocumentPart 0)
(declare-sort Event 0)
(declare-sort Index 0)
(declare-sort Organization 0)
(declare-sort Url 0)
(declare-sort VagueTerm 0)
(declare-sort WebResource 0)

(declare-fun AdjustedReturnIndex (Index) Bool)
(declare-fun IndexCalculation (Event) Bool)
(declare-fun IndexLevel (Real) Bool)
(declare-fun IndexTermination (Event) Bool)
(declare-fun Policy (Document) Bool)
(declare-fun SolactiveOrganization (Organization) Bool)
(declare-fun TerminationAnnouncement (Event) Bool)

(declare-const AsSoonAsReasonablyPossible VagueTerm)
(declare-const HttpsWwwSolactiveComNewsAnnouncements Url)
(declare-const NewsSection DocumentPart)
(declare-const OtherReasons VagueTerm)
(declare-const Solactive Organization)
(declare-const SolactivePolicies Document)
(declare-const SolactiveWebsite WebResource)
(declare-const W_a_TerminationAnnouncement Event)
(declare-const W_c_IndexCalculation Event)
(declare-const W_i_AdjustedReturnIndex Index)
(declare-const W_i_Index Index)
(declare-const W_t_IndexTermination Event)

(assert (! (SolactiveOrganization Solactive) :named TYPE_entity_Solactive))
(assert (! (Policy SolactivePolicies) :named TYPE_entity_SolactivePolicies))
(assert (! (TerminationAnnouncement W_a_TerminationAnnouncement) :named TYPE_witness_W_a_TerminationAnnouncement))
(assert (! (IndexCalculation W_c_IndexCalculation) :named TYPE_witness_W_c_IndexCalculation))
(assert (! (AdjustedReturnIndex W_i_AdjustedReturnIndex) :named TYPE_witness_W_i_AdjustedReturnIndex))
(assert (! (IndexTermination W_t_IndexTermination) :named TYPE_witness_W_t_IndexTermination))

(declare-fun after (Event Event) Bool)
(declare-fun announced_on (Event WebResource) Bool)
(declare-fun announcement_by (Event Organization) Bool)
(declare-fun announcement_timing_described_by (Event VagueTerm) Bool)
(declare-fun announcement_under_section (Event DocumentPart) Bool)
(declare-fun announces_termination (Event Event) Bool)
(declare-fun calculated_index (Event Index) Bool)
(declare-fun calculated_level (Event) Real)
(declare-fun policy_of (Document Organization) Bool)
(declare-fun section_of_website (DocumentPart WebResource) Bool)
(declare-fun terminates_index (Event Index) Bool)
(declare-fun termination_calculation (Event Event) Bool)
(declare-fun termination_in_accordance_with_policy (Event Document) Bool)
(declare-fun termination_reason_qualified_by (Event VagueTerm) Bool)
(declare-fun website_of (WebResource Organization) Bool)

(assert (! (policy_of SolactivePolicies Solactive) :named BOUNDED_TEXT_solactive_policies))
(assert (! (and (IndexCalculation W_c_IndexCalculation) (and (AdjustedReturnIndex W_i_AdjustedReturnIndex) (=> (and (calculated_index W_c_IndexCalculation W_i_AdjustedReturnIndex) (<= (calculated_level W_c_IndexCalculation) 0)) (and (IndexTermination W_t_IndexTermination) (and (TerminationAnnouncement W_a_TerminationAnnouncement) (and (terminates_index W_t_IndexTermination W_i_AdjustedReturnIndex) (termination_calculation W_t_IndexTermination W_c_IndexCalculation) (announces_termination W_a_TerminationAnnouncement W_t_IndexTermination) (announcement_by W_a_TerminationAnnouncement Solactive) (announced_on W_a_TerminationAnnouncement SolactiveWebsite) (announcement_under_section W_a_TerminationAnnouncement NewsSection) (after W_a_TerminationAnnouncement W_c_IndexCalculation) (announcement_timing_described_by W_a_TerminationAnnouncement AsSoonAsReasonablyPossible))))))) :named BOUNDED_TEXT_termination_and_announcement_at_zero_or_below))
(assert (! (and (IndexTermination W_t_IndexTermination) (=> (and (terminates_index W_t_IndexTermination W_i_Index) (termination_reason_qualified_by W_t_IndexTermination OtherReasons)) (termination_in_accordance_with_policy W_t_IndexTermination SolactivePolicies))) :named BOUNDED_TEXT_other_reason_termination_in_accordance_with_solactive_policies))
(check-sat)
