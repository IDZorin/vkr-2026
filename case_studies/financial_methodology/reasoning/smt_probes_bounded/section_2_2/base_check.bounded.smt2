(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort CountryAssignment 0)
(declare-sort Day 0)
(declare-sort DiscretionaryDecision 0)
(declare-sort FinancialInstrument 0)
(declare-sort MonetaryAmount 0)
(declare-sort Organization 0)
(declare-sort Region 0)
(declare-sort SelectionOfIndexComponents 0)

(declare-fun FreeFloatMarketCapizatlization (MonetaryAmount) Bool)
(declare-fun IndexAdministrator (Organization) Bool)
(declare-fun Rank (Int) Bool)
(declare-fun Security (FinancialInstrument) Bool)
(declare-fun SelectionDay (Day) Bool)

(declare-const Americas Region)
(declare-const Canada CountryAssignment)
(declare-const Europe CountryAssignment)
(declare-const EuropeRegion Region)
(declare-const UnitedStates CountryAssignment)
(declare-const W_d_SelectionDay Day)
(declare-const W_r_Region Region)
(declare-const W_s1_Security FinancialInstrument)
(declare-const W_s2_Security FinancialInstrument)
(declare-const W_s_Security FinancialInstrument)

(assert (! (SelectionDay W_d_SelectionDay) :named TYPE_witness_W_d_SelectionDay))
(assert (! (Security W_s1_Security) :named TYPE_witness_W_s1_Security))
(assert (! (Security W_s2_Security) :named TYPE_witness_W_s2_Security))
(assert (! (Security W_s_Security) :named TYPE_witness_W_s_Security))

(declare-fun eligible (Day FinancialInstrument) Bool)
(declare-fun free_float_market_capizatlization (Day FinancialInstrument) MonetaryAmount)
(declare-fun fully_rule_based (SelectionOfIndexComponents) Bool)
(declare-fun gbs_country_assignment (Day FinancialInstrument) CountryAssignment)
(declare-fun index_component (Day FinancialInstrument) Bool)
(declare-fun index_universe (Day FinancialInstrument) Bool)
(declare-fun initial_composition (Day FinancialInstrument) Bool)
(declare-fun ordinary_rebalance_selection (Day FinancialInstrument) Bool)
(declare-fun rank (Day Region FinancialInstrument) Int)
(declare-fun region (Day FinancialInstrument) Region)
(declare-fun selected_for_index_inclusion (Day FinancialInstrument) Bool)
(declare-fun selection_of_index_components (Day) SelectionOfIndexComponents)

(assert (! (and (SelectionDay W_d_SelectionDay) (and (Security W_s_Security) (= (eligible W_d_SelectionDay W_s_Security) (index_universe W_d_SelectionDay W_s_Security)))) :named BOUNDED_TEXT_eligible_iff_index_universe_for_component_requirements))
(assert (! (and (SelectionDay W_d_SelectionDay) (and (Security W_s_Security) (=> (eligible W_d_SelectionDay W_s_Security) (or (= (region W_d_SelectionDay W_s_Security) Americas) (= (region W_d_SelectionDay W_s_Security) EuropeRegion))))) :named BOUNDED_TEXT_security_classified_into_one_of_two_regions))
(assert (! (and (SelectionDay W_d_SelectionDay) (and (Security W_s_Security) (=> (eligible W_d_SelectionDay W_s_Security) (= (= (region W_d_SelectionDay W_s_Security) Americas) (or (= (gbs_country_assignment W_d_SelectionDay W_s_Security) Canada) (= (gbs_country_assignment W_d_SelectionDay W_s_Security) UnitedStates)))))) :named BOUNDED_TEXT_americas_country_assignment_classification))
(assert (! (and (SelectionDay W_d_SelectionDay) (and (Security W_s_Security) (=> (eligible W_d_SelectionDay W_s_Security) (= (= (region W_d_SelectionDay W_s_Security) EuropeRegion) (= (gbs_country_assignment W_d_SelectionDay W_s_Security) Europe))))) :named BOUNDED_TEXT_europe_country_assignment_classification))
(assert (! (and (SelectionDay W_d_SelectionDay) (and (Security W_s1_Security) (and (Security W_s2_Security) (=> (and (eligible W_d_SelectionDay W_s1_Security) (eligible W_d_SelectionDay W_s2_Security) (= (region W_d_SelectionDay W_s1_Security) W_r_Region) (= (region W_d_SelectionDay W_s2_Security) W_r_Region) (> (free_float_market_capizatlization W_d_SelectionDay W_s1_Security) (free_float_market_capizatlization W_d_SelectionDay W_s2_Security))) (< (rank W_d_SelectionDay W_r_Region W_s1_Security) (rank W_d_SelectionDay W_r_Region W_s2_Security)))))) :named BOUNDED_TEXT_descending_order_by_free_float_market_capizatlization))
(assert (! (and (SelectionDay W_d_SelectionDay) (and (Security W_s_Security) (= (selected_for_index_inclusion W_d_SelectionDay W_s_Security) (and (eligible W_d_SelectionDay W_s_Security) (<= (rank W_d_SelectionDay (region W_d_SelectionDay W_s_Security) W_s_Security) 20))))) :named BOUNDED_TEXT_selected_top_20_for_each_region))
(assert (! (and (SelectionDay W_d_SelectionDay) (and (Security W_s_Security) (= (index_component W_d_SelectionDay W_s_Security) (selected_for_index_inclusion W_d_SelectionDay W_s_Security)))) :named BOUNDED_TEXT_index_components_selected_for_index_inclusion))
(assert (! (and (SelectionDay W_d_SelectionDay) (and (Security W_s_Security) (= (initial_composition W_d_SelectionDay W_s_Security) (selected_for_index_inclusion W_d_SelectionDay W_s_Security)))) :named BOUNDED_TEXT_initial_composition_determined_by_index_component_requirements))
(assert (! (and (SelectionDay W_d_SelectionDay) (and (Security W_s_Security) (= (ordinary_rebalance_selection W_d_SelectionDay W_s_Security) (selected_for_index_inclusion W_d_SelectionDay W_s_Security)))) :named BOUNDED_TEXT_ordinary_rebalance_selection_determined_by_index_component_requirements))
(assert (! (and (SelectionDay W_d_SelectionDay) (fully_rule_based (selection_of_index_components W_d_SelectionDay))) :named BOUNDED_TEXT_selection_fully_rule_based))
(check-sat)
