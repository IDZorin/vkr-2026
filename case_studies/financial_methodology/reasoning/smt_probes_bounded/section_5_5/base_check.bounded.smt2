(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort Amendment 0)
(declare-sort Approval 0)
(declare-sort Decision 0)
(declare-sort Document 0)
(declare-sort Index 0)
(declare-sort IndexRule 0)
(declare-sort Organization 0)
(declare-sort Staff 0)
(declare-sort Url 0)
(declare-sort WebResource 0)

(declare-fun Committee (Organization) Bool)
(declare-fun GuidelineAmendment (Amendment) Bool)
(declare-fun IndexRuleAmendment (Amendment) Bool)
(declare-fun Policy (Document) Bool)
(declare-fun PriorApproval (Approval) Bool)
(declare-fun Subsidiary (Organization) Bool)

(declare-const Guideline Document)
(declare-const HttpsWwwSolactiveComDocumentsMethodologyPolicy Url)
(declare-const MethodologyPolicy Document)
(declare-const OversightCommittee Organization)
(declare-const Solactive Organization)
(declare-const SolactiveWebsite WebResource)
(declare-const TheIndex Index)
(declare-const W_a_IndexRuleAmendment Amendment)
(declare-const W_d_Decision Decision)
(declare-const W_g_GuidelineAmendment Amendment)
(declare-const W_r_IndexRule IndexRule)
(declare-const W_s_Staff Staff)
(declare-const W_sub_Subsidiary Organization)

(assert (! (Policy MethodologyPolicy) :named TYPE_entity_MethodologyPolicy))
(assert (! (Committee OversightCommittee) :named TYPE_entity_OversightCommittee))
(assert (! (IndexRuleAmendment W_a_IndexRuleAmendment) :named TYPE_witness_W_a_IndexRuleAmendment))
(assert (! (GuidelineAmendment W_g_GuidelineAmendment) :named TYPE_witness_W_g_GuidelineAmendment))
(assert (! (Subsidiary W_sub_Subsidiary) :named TYPE_witness_W_sub_Subsidiary))

(declare-fun amendment_of_document (Amendment Document) Bool)
(declare-fun amendment_of_rule (Amendment IndexRule) Bool)
(declare-fun available_on (Document WebResource) Bool)
(declare-fun composed_of (Organization Staff) Bool)
(declare-fun decision_regarding (Decision Amendment) Bool)
(declare-fun may_result_in (Amendment Amendment) Bool)
(declare-fun responsible_for (Organization Decision) Bool)
(declare-fun rule_of (IndexRule Index) Bool)
(declare-fun staff_from (Staff Organization) Bool)
(declare-fun subsidiary_of (Organization Organization) Bool)
(declare-fun website_of (WebResource Organization) Bool)

(assert (! (composed_of OversightCommittee W_s_Staff) :named BOUNDED_TEXT_oversight_committee_has_staff))
(assert (! (=> (composed_of OversightCommittee W_s_Staff) (or (staff_from W_s_Staff Solactive) (and (Subsidiary W_sub_Subsidiary) (and (subsidiary_of W_sub_Subsidiary Solactive) (staff_from W_s_Staff W_sub_Subsidiary))))) :named BOUNDED_TEXT_oversight_committee_staff_from_solactive_or_subsidiary))
(assert (! (and (IndexRuleAmendment W_a_IndexRuleAmendment) (and (amendment_of_rule W_a_IndexRuleAmendment W_r_IndexRule) (rule_of W_r_IndexRule TheIndex))) :named BOUNDED_TEXT_index_rule_amendment_scope))
(assert (! (and (IndexRuleAmendment W_a_IndexRuleAmendment) (and (decision_regarding W_d_Decision W_a_IndexRuleAmendment) (responsible_for OversightCommittee W_d_Decision))) :named BOUNDED_TEXT_oversight_committee_responsible_for_index_rule_amendment_decisions))
(assert (! (and (IndexRuleAmendment W_a_IndexRuleAmendment) (and (GuidelineAmendment W_g_GuidelineAmendment) (=> (may_result_in W_a_IndexRuleAmendment W_g_GuidelineAmendment) (amendment_of_document W_g_GuidelineAmendment Guideline)))) :named BOUNDED_TEXT_possible_guideline_amendment_scope))
(check-sat)
