(assert (! (and (effort_by SolactiveGreatestPossibleEfforts Solactive) (greatest_possible SolactiveGreatestPossibleEfforts) (over_time SolactiveGreatestPossibleEfforts)) :named BOUNDED_TEXT_solactive_effort))
(assert (! (=> (index_of W_i_Index Solactive) (and (effort_to_ensure SolactiveGreatestPossibleEfforts W_i_Index Resilience) (effort_to_ensure SolactiveGreatestPossibleEfforts W_i_Index ContinuedIntegrity))) :named BOUNDED_TEXT_solactive_efforts_for_resilience_and_integrity))
(assert (! (=> (and (index_of W_i_Index Solactive) (methodology_of_index W_m_IndexMethodology W_i_Index) (necessary_to_adapt_methodology W_m_IndexMethodology W_u_UnderlyingMarket) (changing_underlying_market W_u_UnderlyingMarket)) (and (follows Solactive W_p_Procedure) (clearly_defined W_p_Procedure) (transparent W_p_Procedure) (adapts_index_methodology W_p_Procedure W_m_IndexMethodology W_u_UnderlyingMarket) (procedure_maintains W_p_Procedure W_i_Index ContinuedReliability) (procedure_maintains W_p_Procedure W_i_Index Comparability) (see W_p_Procedure Section5_2MethodologyReview))) :named BOUNDED_TEXT_methodology_adaptation_where_necessary))
(assert (! (=> (and (or (index_set_to_measure_underlying_market W_i_Index W_u_UnderlyingMarket) (index_set_to_reflect_underlying_market W_i_Index W_u_UnderlyingMarket)) (underlying_market_changes W_u_UnderlyingMarket) (underlying_market_change_described_by W_u_UnderlyingMarket Substantially) (not (underlying_market_change_foreseeable_at_inception W_u_UnderlyingMarket W_i_Index))) (usual_case_for_cessation W_i_Index)) :named BOUNDED_TEXT_cessation_usual_when_underlying_market_changes))
(assert (! (=> (and (or (index_set_to_measure_economic_reality W_i_Index W_e_EconomicReality) (index_set_to_reflect_economic_reality W_i_Index W_e_EconomicReality)) (economic_reality_changes W_e_EconomicReality) (economic_reality_change_described_by W_e_EconomicReality Substantially) (not (economic_reality_change_foreseeable_at_inception W_e_EconomicReality W_i_Index))) (usual_case_for_cessation W_i_Index)) :named BOUNDED_TEXT_cessation_usual_when_economic_reality_changes))
(assert (! (=> (and (rule_of_index W_r_IndexRule W_i_Index) (not (applied_coherently W_r_IndexRule W_i_Index))) (usual_case_for_cessation W_i_Index)) :named BOUNDED_TEXT_cessation_usual_when_rules_not_applied_coherently))
(assert (! (=> (and (SelectionCriteria W_sc_SelectionCriteria) (and (rule_of_index W_sc_SelectionCriteria W_i_Index) (not (applied_coherently W_sc_SelectionCriteria W_i_Index)))) (usual_case_for_cessation W_i_Index)) :named BOUNDED_TEXT_cessation_usual_when_selection_criteria_not_applied_coherently))
(assert (! (=> (and (not (used_as_underlying_value_for_financial_instrument W_i_Index W_fi_FinancialInstrument)) (not (used_as_underlying_value_for_investment_fund W_i_Index W_f_InvestmentFund)) (not (used_as_underlying_value_for_financial_contract W_i_Index W_c_FinancialContract))) (usual_case_for_cessation W_i_Index)) :named BOUNDED_TEXT_cessation_usual_when_index_not_used_as_underlying_value))
(assert (! (and (established_by SolactiveCessationGuidelines Solactive) (maintained_by SolactiveCessationGuidelines Solactive) (clear SolactiveCessationGuidelines)) :named BOUNDED_TEXT_solactive_cessation_guidelines))
(assert (! (=> (guidelines_identify SolactiveCessationGuidelines W_s_CessationSituation) (unavoidable W_s_CessationSituation)) :named BOUNDED_TEXT_guidelines_identify_unavoidable_cessation_situations))
(assert (! (and (procedure_in_guidelines SolactiveCessationGuidelines W_p_Procedure) (procedure_for_informing W_p_Procedure Stakeholders) (and (procedure_in_guidelines SolactiveCessationGuidelines W_q_Procedure) (procedure_for_consulting W_q_Procedure Stakeholders))) :named BOUNDED_TEXT_guidelines_include_stakeholder_information_and_consultation_procedures))
(assert (! (and (procedure_in_guidelines SolactiveCessationGuidelines W_p_Procedure) (procedure_for_termination W_p_Procedure)) :named BOUNDED_TEXT_guidelines_include_termination_procedure))
(assert (! (and (AlternativeIndex W_a_AlternativeIndex) (and (procedure_in_guidelines SolactiveCessationGuidelines W_p_Procedure) (procedure_for_transition_to_alternative_index W_p_Procedure W_a_AlternativeIndex))) :named BOUNDED_TEXT_guidelines_include_transition_procedure))
(assert (! (and (details_specified_in SolactiveCessationGuidelines SolactiveTerminationPolicy) (incorporated_by_reference SolactiveTerminationPolicy)) :named BOUNDED_TEXT_termination_policy_details))
