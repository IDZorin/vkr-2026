(set-logic ALL)
(set-option :produce-unsat-cores true)

(declare-sort Day 0)
(declare-sort Document 0)
(declare-sort DocumentPart 0)
(declare-sort Event 0)
(declare-sort FinancialInstrument 0)
(declare-sort Index 0)
(declare-sort IndexAdjustment 0)
(declare-sort IndexAdjustmentEffect 0)
(declare-sort IndexAdjustmentPossibility 0)
(declare-sort NoticePeriod 0)
(declare-sort Organization 0)
(declare-sort RebalanceInterval 0)
(declare-sort VagueTerm 0)
(declare-sort WebResource 0)

(declare-fun CorporateAction (Event) Bool)
(declare-fun EffectiveDay (Day) Bool)
(declare-fun EquityIndexMethodology (Document) Bool)
(declare-fun IndexComponent (FinancialInstrument) Bool)
(declare-fun Notice (Document) Bool)
(declare-fun RebalanceDay (Day) Bool)
(declare-fun RegularRebalanceDay (Day) Bool)
(declare-fun RequiredIndexAdjustment (IndexAdjustment) Bool)
(declare-fun SolactiveOrganization (Organization) Bool)
(declare-fun TradingDay (Day) Bool)

(declare-const AnnouncementsSection DocumentPart)
(declare-const CertainCircumstances VagueTerm)
(declare-const CertainIndexComponents VagueTerm)
(declare-const ComponentNumberEffect IndexAdjustmentEffect)
(declare-const ComponentRelationEffect IndexAdjustmentEffect)
(declare-const ComponentWeightingEffect IndexAdjustmentEffect)
(declare-const MayBeNecessary VagueTerm)
(declare-const MayHaveToBeDone VagueTerm)
(declare-const Section4_4Below DocumentPart)
(declare-const Solactive Organization)
(declare-const SolactiveEquityIndexMethodology Document)
(declare-const SolactiveWebsite WebResource)
(declare-const TheIndex Index)
(declare-const ThisGuideline Document)
(declare-const W_a_RequiredIndexAdjustment IndexAdjustment)
(declare-const W_c_IndexComponent FinancialInstrument)
(declare-const W_ca_CorporateAction Event)
(declare-const W_d_Day Day)
(declare-const W_interval_RebalanceInterval RebalanceInterval)
(declare-const W_n_Notice Document)
(declare-const W_p_IndexAdjustmentPossibility IndexAdjustmentPossibility)
(declare-const W_r1_RegularRebalanceDay Day)
(declare-const W_r2_RegularRebalanceDay Day)

(assert (! (SolactiveOrganization Solactive) :named TYPE_entity_Solactive))
(assert (! (EquityIndexMethodology SolactiveEquityIndexMethodology) :named TYPE_entity_SolactiveEquityIndexMethodology))
(assert (! (RequiredIndexAdjustment W_a_RequiredIndexAdjustment) :named TYPE_witness_W_a_RequiredIndexAdjustment))
(assert (! (IndexComponent W_c_IndexComponent) :named TYPE_witness_W_c_IndexComponent))
(assert (! (CorporateAction W_ca_CorporateAction) :named TYPE_witness_W_ca_CorporateAction))
(assert (! (Notice W_n_Notice) :named TYPE_witness_W_n_Notice))
(assert (! (RegularRebalanceDay W_r1_RegularRebalanceDay) :named TYPE_witness_W_r1_RegularRebalanceDay))
(assert (! (RegularRebalanceDay W_r2_RegularRebalanceDay) :named TYPE_witness_W_r2_RegularRebalanceDay))
(assert (! (distinct ComponentRelationEffect ComponentNumberEffect ComponentWeightingEffect) :named TYPE_enum_distinct_IndexAdjustmentEffect))

(declare-fun adjustment_between_interval (IndexAdjustment RebalanceInterval) Bool)
(declare-fun adjustment_effect_described_by (IndexAdjustmentEffect VagueTerm) Bool)
(declare-fun adjustment_effect_scope_described_by (IndexAdjustment VagueTerm) Bool)
(declare-fun adjustment_of_index (IndexAdjustment Index) Bool)
(declare-fun adjustment_possibility_between_interval (IndexAdjustmentPossibility RebalanceInterval) Bool)
(declare-fun adjustment_possibility_described_by (IndexAdjustmentPossibility VagueTerm) Bool)
(declare-fun adjustment_possibility_of_index (IndexAdjustmentPossibility Index) Bool)
(declare-fun adjustment_required_due_to_corporate_action (IndexAdjustment Event) Bool)
(declare-fun affected_index_component (IndexAdjustment FinancialInstrument) Bool)
(declare-fun announced_by (Document Organization) Bool)
(declare-fun announced_on (Document WebResource) Bool)
(declare-fun announced_under_section (Document DocumentPart) Bool)
(declare-fun available_on (Document WebResource) Bool)
(declare-fun corporate_action_in_relation_to_component (Event FinancialInstrument) Bool)
(declare-fun effective_day_specified_in_respective_notice (Document) Day)
(declare-fun implemented_on (IndexAdjustment Day) Bool)
(declare-fun incorporated_by_reference_into (Document Document) Bool)
(declare-fun interval_end_rebalance_day (RebalanceInterval Day) Bool)
(declare-fun interval_start_rebalance_day (RebalanceInterval Day) Bool)
(declare-fun notice_for_index_adjustment (Document IndexAdjustment) Bool)
(declare-fun notice_gives_notice_period (Document NoticePeriod) Bool)
(declare-fun notice_period_day (NoticePeriod Day) Bool)
(declare-fun notice_period_with_respect_to_component (NoticePeriod FinancialInstrument) Bool)
(declare-fun possible_adjustment_effect (IndexAdjustment IndexAdjustmentEffect) Bool)
(declare-fun section_of_website (DocumentPart WebResource) Bool)
(declare-fun specified_in (Event DocumentPart) Bool)
(declare-fun trading_day_with_respect_to (Day FinancialInstrument) Bool)
(declare-fun website_of (WebResource Organization) Bool)

(assert (! (and (incorporated_by_reference_into SolactiveEquityIndexMethodology ThisGuideline) (available_on SolactiveEquityIndexMethodology SolactiveWebsite) (website_of SolactiveWebsite Solactive)) :named BOUNDED_TEXT_equity_index_methodology_reference))
(assert (! (section_of_website AnnouncementsSection SolactiveWebsite) :named BOUNDED_TEXT_announcements_section_on_solactive_website))
(assert (! (adjustment_effect_described_by ComponentWeightingEffect CertainIndexComponents) :named BOUNDED_TEXT_component_weighting_effect_qualified_by_certain_components))
(assert (! (and (adjustment_possibility_of_index W_p_IndexAdjustmentPossibility TheIndex) (adjustment_possibility_described_by W_p_IndexAdjustmentPossibility CertainCircumstances) (adjustment_possibility_described_by W_p_IndexAdjustmentPossibility MayBeNecessary) (adjustment_possibility_between_interval W_p_IndexAdjustmentPossibility W_interval_RebalanceInterval)) :named BOUNDED_TEXT_index_adjustment_may_be_necessary_between_regular_rebalance_days))
(assert (! (and (RequiredIndexAdjustment W_a_RequiredIndexAdjustment) (and (adjustment_effect_scope_described_by W_a_RequiredIndexAdjustment MayHaveToBeDone) (or (possible_adjustment_effect W_a_RequiredIndexAdjustment ComponentRelationEffect) (possible_adjustment_effect W_a_RequiredIndexAdjustment ComponentNumberEffect) (possible_adjustment_effect W_a_RequiredIndexAdjustment ComponentWeightingEffect)))) :named BOUNDED_TEXT_required_adjustment_effect_scope))
(assert (! (and (RequiredIndexAdjustment W_a_RequiredIndexAdjustment) (and (Notice W_n_Notice) (=> (notice_for_index_adjustment W_n_Notice W_a_RequiredIndexAdjustment) (and (announced_by W_n_Notice Solactive) (announced_on W_n_Notice SolactiveWebsite) (announced_under_section W_n_Notice AnnouncementsSection))))) :named BOUNDED_TEXT_index_adjustment_notice_publication))
(assert (! (and (RequiredIndexAdjustment W_a_RequiredIndexAdjustment) (and (Notice W_n_Notice) (=> (notice_for_index_adjustment W_n_Notice W_a_RequiredIndexAdjustment) (implemented_on W_a_RequiredIndexAdjustment (effective_day_specified_in_respective_notice W_n_Notice))))) :named BOUNDED_TEXT_index_adjustment_implemented_on_notice_effective_day))
(check-sat)
