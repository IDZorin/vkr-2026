(assert (! (MethodologyPolicy SolactiveMethodologyPolicy) :named TYPE_entity_SolactiveMethodologyPolicy))
(assert (! (ReviewIdentifiedMethodologyChange W_c_ReviewIdentifiedMethodologyChange) :named TYPE_witness_W_c_ReviewIdentifiedMethodologyChange))
(assert (! (distinct UnderlyingMarketChange EconomicRealityChange ObsoleteAssumption ObsoleteFactor NoLongerReflectsReality) :named TYPE_enum_distinct_MethodologyChangeNeedExampleCondition))
(assert (! (distinct Accuracy Reliability Appropriateness) :named TYPE_enum_distinct_ReflectionQuality))

(declare-fun amendment_date (IndexAmendment) Day)
(declare-fun amendment_of_index (IndexAmendment Index) Bool)
(declare-fun at_least_annually (MethodologyReview) Bool)
(declare-fun available_on (Document WebResource) Bool)
(declare-fun change_for_need (MethodologyChange MethodologyChangeNeed) Bool)
(declare-fun change_need_of_methodology (MethodologyChangeNeed IndexMethodology) Bool)
(declare-fun change_of_methodology (MethodologyChange IndexMethodology) Bool)
(declare-fun contained_in (Day Document) Bool)
(declare-fun example_condition_changed_since_launch_of_index (MethodologyChangeNeedExampleCondition Index) Bool)
(declare-fun example_condition_for_methodology_change_need (MethodologyChangeNeedExampleCondition) Bool)
(declare-fun example_condition_obsolete_assumption_for_methodology (MethodologyChangeNeedExampleCondition IndexMethodology) Bool)
(declare-fun example_condition_obsolete_factor_for_methodology (MethodologyChangeNeedExampleCondition IndexMethodology) Bool)
(declare-fun example_condition_reflection_quality (MethodologyChangeNeedExampleCondition ReflectionQuality) Bool)
(declare-fun incorporated_by_reference_into (Document Document) Bool)
(declare-fun last_amendment (Index) IndexAmendment)
(declare-fun methodology_has_obsolete_basis (IndexMethodology MethodologyChangeNeedExampleCondition) Bool)
(declare-fun methodology_of_index (IndexMethodology Index) Bool)
(declare-fun need_has_example_condition (MethodologyChangeNeed MethodologyChangeNeedExampleCondition) Bool)
(declare-fun need_identified_within_review (MethodologyChangeNeed MethodologyReview) Bool)
(declare-fun reflects_reality_as_before (IndexMethodology ReflectionQuality) Bool)
(declare-fun regular (MethodologyReview) Bool)
(declare-fun review_of_methodology (MethodologyReview IndexMethodology) Bool)
(declare-fun section_of_website (DocumentPart WebResource) Bool)
(declare-fun website_of (WebResource Organization) Bool)

(assert (! (methodology_of_index TheIndexMethodology TheIndex) :named BOUNDED_TEXT_index_methodology_scope))
(assert (! (and (review_of_methodology W_r_MethodologyReview TheIndexMethodology) (regular W_r_MethodologyReview) (at_least_annually W_r_MethodologyReview)) :named BOUNDED_TEXT_methodology_subject_to_regular_review_at_least_annually))
(assert (! (=> (review_of_methodology W_r_MethodologyReview TheIndexMethodology) (and (regular W_r_MethodologyReview) (at_least_annually W_r_MethodologyReview))) :named BOUNDED_TEXT_methodology_reviews_are_regular_at_least_annually))
(assert (! (=> (and (need_identified_within_review W_n_MethodologyChangeNeed W_r_MethodologyReview) (review_of_methodology W_r_MethodologyReview TheIndexMethodology)) (and (change_need_of_methodology W_n_MethodologyChangeNeed TheIndexMethodology) (and (ReviewIdentifiedMethodologyChange W_c_ReviewIdentifiedMethodologyChange) (and (change_for_need W_c_ReviewIdentifiedMethodologyChange W_n_MethodologyChangeNeed) (change_of_methodology W_c_ReviewIdentifiedMethodologyChange TheIndexMethodology))))) :named BOUNDED_TEXT_identified_need_has_review_identified_change))
(assert (! (and (example_condition_for_methodology_change_need UnderlyingMarketChange) (example_condition_for_methodology_change_need EconomicRealityChange) (example_condition_for_methodology_change_need ObsoleteAssumption) (example_condition_for_methodology_change_need ObsoleteFactor) (example_condition_for_methodology_change_need NoLongerReflectsReality) (example_condition_changed_since_launch_of_index UnderlyingMarketChange TheIndex) (example_condition_changed_since_launch_of_index EconomicRealityChange TheIndex) (example_condition_obsolete_assumption_for_methodology ObsoleteAssumption TheIndexMethodology) (methodology_has_obsolete_basis TheIndexMethodology ObsoleteAssumption) (example_condition_obsolete_factor_for_methodology ObsoleteFactor TheIndexMethodology) (methodology_has_obsolete_basis TheIndexMethodology ObsoleteFactor) (example_condition_reflection_quality NoLongerReflectsReality Accuracy) (example_condition_reflection_quality NoLongerReflectsReality Reliability) (example_condition_reflection_quality NoLongerReflectsReality Appropriateness)) :named BOUNDED_TEXT_methodology_change_need_example_condition_catalog))
(assert (! (=> (example_condition_reflection_quality NoLongerReflectsReality W_q_ReflectionQuality) (not (reflects_reality_as_before TheIndexMethodology W_q_ReflectionQuality))) :named BOUNDED_TEXT_no_longer_reflects_reality_condition_means_not_reflects_reality_as_before))
(assert (! (=> (need_has_example_condition W_n_MethodologyChangeNeed W_c_MethodologyChangeNeedExampleCondition) (and (change_need_of_methodology W_n_MethodologyChangeNeed TheIndexMethodology) (example_condition_for_methodology_change_need W_c_MethodologyChangeNeedExampleCondition))) :named BOUNDED_TEXT_methodology_change_need_example_condition_scope))
(assert (! (and (amendment_of_index (last_amendment TheIndex) TheIndex) (contained_in (amendment_date (last_amendment TheIndex)) Guideline)) :named BOUNDED_TEXT_last_amendment_date_contained_in_guideline))
(check-sat)
