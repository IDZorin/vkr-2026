(declare-const UnderlyingMarketChange MethodologyChangeNeedExampleCondition)
(declare-const W_c_MethodologyChangeNeedExampleCondition MethodologyChangeNeedExampleCondition)
(declare-const W_c_ReviewIdentifiedMethodologyChange MethodologyChange)
(declare-const W_n_MethodologyChangeNeed MethodologyChangeNeed)
(declare-const W_q_ReflectionQuality ReflectionQuality)
