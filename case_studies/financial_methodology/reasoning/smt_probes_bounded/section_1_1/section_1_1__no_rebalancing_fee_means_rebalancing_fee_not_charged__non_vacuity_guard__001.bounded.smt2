(check-sat)
(push 1)
(assert (! (= (rebalancing_fee_status W_i_Index) NoRebalancingFee) :named BOUNDED_PROBE_section_1_1__no_rebalancing_fee_means_rebalancing_fee_not_charged__non_vacuity_guard__001))
