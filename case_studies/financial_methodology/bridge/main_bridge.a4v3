-- seed methodology global bridge layer.
-- This file records cross-section identity links and aliases. It is not a
-- source-local translation of any one section.

sort BridgeEntry
sort BridgeSymbol
sort BridgeIndex extends BridgeSymbol
sort BridgeSort extends BridgeSymbol
sort BridgeEntity extends BridgeSymbol
sort BridgeRelation extends BridgeSymbol
sort BridgeFamily
sort BridgeFrame
sort BridgeRole
sort BridgeConfidence = High | Medium | Low
sort BridgeLinkType =
  CrossSectionIdentity
| SourceAlias
| TickerAlias
| SortAlias
| EntityAlias
| RelationAlias
| ScopedRelationAlias
| RelatedConcept
| UnresolvedDrift
sort BridgeArgumentOrder =
  SameArgumentOrder
| ReversedArgumentOrder
| ScopedExtraIndexArgument
| ScopedExtraCalculationDayArgument
| NotApplicableArgumentOrder

sort BridgeProjectionKind =
  FunctionProjection
| RelationProjection
| PredicateProjection

