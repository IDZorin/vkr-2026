sort DefinedTerm

entity IndexAdministratorTerm : DefinedTerm
entity IntroductionSection : DocumentPart

rel term_shall_have_meaning_defined_in_section : DefinedTerm, DocumentPart

fact index_administrator_meaning_defined_in_introduction :
  term_shall_have_meaning_defined_in_section(IndexAdministratorTerm, IntroductionSection)
